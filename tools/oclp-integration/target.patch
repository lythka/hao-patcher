index 0000000000000000000000000000000000000000..b07460743c67bf33c4a0da03e30e5e3e4fd40ca2
--- /dev/null
+++ b/opencore_legacy_patcher/sys_patch/utilities/kdk_intel_payload.py
@@ -0,0 +1,99 @@
+"""Prepare an Intel-only KDK overlay without modifying the KDK or stock target."""
+import fnmatch
+import os
+import shutil
+import struct
+from pathlib import Path
+
+EXCLUDE = ('*.dSYM', '*_development', '*_kasan')
+X86_64 = 0x01000007
+ARM64 = 0x0100000c
+
+
+def architecture(path):
+    """Return (cpu/subtype tuples, exact x86_64 slice or None). Refuse malformed fat input."""
+    size = path.stat().st_size
+    with path.open('rb') as f:
+        magic = f.read(4)
+        if magic in (b'\xcf\xfa\xed\xfe', b'\xfe\xed\xfa\xcf'):
+            endian = '<' if magic[0] == 0xcf else '>'
+            raw = f.read(8)
+            if len(raw) != 8:
+                raise ValueError('truncated Mach-O: ' + str(path))
+            cpu, sub = struct.unpack(endian+'II', raw)
+            return [(cpu, sub & 0xffffff)], None
+        formats = {b'\xca\xfe\xba\xbe': ('>', False), b'\xbe\xba\xfe\xca': ('<', False),
+                   b'\xca\xfe\xba\xbf': ('>', True), b'\xbf\xba\xfe\xca': ('<', True)}
+        if magic not in formats:
+            return [], None
+        endian, wide = formats[magic]
+        raw = f.read(4)
+        if len(raw) != 4:
+            raise ValueError('truncated fat header')
+        count = struct.unpack(endian+'I', raw)[0]
+        width = 32 if wide else 20
+        if not 1 <= count <= 64 or 8 + count*width > size:
+            raise ValueError('invalid fat architecture count')
+        entries = []
+        for _ in range(count):
+            row = struct.unpack(endian+('IIQQII' if wide else 'IIIII'), f.read(width))
+            cpu, sub, offset, length, align = row[:5]
+            if align > 30 or offset % (1 << align) or offset < 8+count*width or length < 12 or offset+length > size:
+                raise ValueError('invalid fat slice bounds')
+            if any(offset < o+n and o < offset+length for _, _, o, n in entries):
+                raise ValueError('overlapping fat slices')
+            if any(cpu == c and (sub & 0xffffff) == s for c, s, _, _ in entries):
+                raise ValueError('duplicate fat architecture')
+            entries.append((cpu, sub & 0xffffff, offset, length))
+        intel = [(o,n) for c,sub,o,n in entries if c == X86_64 and sub == 3]
+        if any(c == X86_64 for c,_,_,_ in entries) and not intel:
+            raise ValueError('generic x86_64 slice absent')
+        if len(intel) > 1:
+            raise ValueError('ambiguous x86_64 slices')
+        for cpu, sub, offset, length in entries:
+            f.seek(offset); header = f.read(12)
+            if header[:4] != b'\xcf\xfa\xed\xfe' or struct.unpack('<II',header[4:]) != (cpu, sub):
+                # Capability bits in the inner subtype are permitted, but must match the architecture.
+                if header[:4] != b'\xcf\xfa\xed\xfe' or struct.unpack('<I',header[4:8])[0] != cpu or struct.unpack('<I',header[8:12])[0] & 0xffffff != sub:
+                    raise ValueError('fat slice header mismatch')
+        return [(c,s) for c,s,_,_ in entries], intel[0] if intel else None
+
+
+def prepare(source, destination):
+    source, destination = Path(source), Path(destination)
+    if destination.exists():
+        raise ValueError('payload staging destination already exists')
+    excluded, thin = set(), {}
+    for root, dirs, files in os.walk(source, followlinks=False):
+        dirs[:] = [d for d in dirs if not any(fnmatch.fnmatch(d,p) for p in EXCLUDE)]
+        for name in files:
+            path = Path(root)/name
+            if path.is_symlink() or any(fnmatch.fnmatch(name,p) for p in EXCLUDE):
+                continue
+            bundles = [p for p in path.parents if p != source and p.suffix == '.kext' and source in p.parents]
+            if not bundles:
+                continue
+            arches, selected = architecture(path)
+            if arches and all(c == ARM64 and s == 2 for c,s in arches):
+                excluded.add(bundles[0].relative_to(source))
+            elif selected:
+                thin[path.relative_to(source)] = selected
+    def ignore(folder, names):
+        rel = Path(folder).relative_to(source)
+        return [n for n in names if rel/n in excluded or any(fnmatch.fnmatch(n,p) for p in EXCLUDE)]
+    shutil.copytree(source, destination, symlinks=True, ignore=ignore)
+    for rel, (offset, length) in thin.items():
+        target = destination/rel
+        if not target.exists():
+            continue  # A parent arm64e-only bundle was excluded.
+        target.chmod(target.stat().st_mode | 0o200)
+        with (source/rel).open('rb') as original, target.open('wb') as output:
+            original.seek(offset)
+            remaining = length
+            while remaining:
+                block = original.read(min(1024*1024, remaining))
+                if not block:
+                    raise ValueError('source changed while thinning')
+                output.write(block); remaining -= len(block)
+        shutil.copystat(source/rel, target)
+    return {'excluded_bundles': sorted(map(str, excluded)), 'thinned': sorted(str(p) for p in thin if (destination/p).exists())}
