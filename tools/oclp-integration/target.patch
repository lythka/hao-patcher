diff --git a/ssd-target/tests/test_kdk_trim.py b/ssd-target/tests/test_kdk_trim.py
new file mode 100644
index 0000000000000000000000000000000000000000..61abc42f62212803e27b12cb4db0b06cc3649c31
--- /dev/null
+++ b/ssd-target/tests/test_kdk_trim.py
@@ -0,0 +1,156 @@
+"""
+test_kdk_trim.py: the KDK merge leaves out debug symbols and development/KASAN variants, and fix_permissions
+on a merge changes only the merged entries (no hard-link spill-over)
+
+No root: root commands run as the current user, chown is recorded instead of run.
+
+    python ssd-target/tests/test_kdk_trim.py <work dir>
+"""
+
+import os
+import sys
+import types
+import shutil
+import logging
+import subprocess
+
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO))
+
+
+class _WxStub(types.ModuleType):
+    def __getattr__(self, name):
+        if name.startswith("__"):
+            raise AttributeError(name)
+        stub = type(name, (object,), {"__init__": lambda self, *a, **k: None})
+        setattr(self, name, stub)
+        return stub
+
+try:
+    import wx  # noqa: F401
+except ImportError:
+    for module in ("wx", "wx.adv", "wx.html2"):
+        sys.modules[module] = _WxStub(module)
+
+from opencore_legacy_patcher.support import subprocess_wrapper
+from opencore_legacy_patcher.sys_patch.utilities import files as files_module
+from opencore_legacy_patcher.sys_patch.utilities import kdk_merge
+
+CHOWNED = []
+failures = []
+
+
+def check(condition, message):
+    print(("PASS " if condition else "FAIL ") + message)
+    if not condition:
+        failures.append(message)
+
+
+def run_as_user(*args, **kwargs):
+    command = [str(a) for a in args[0]]
+    if command[0] == "/usr/sbin/chown":
+        CHOWNED.extend(command[2:] if command[1] != "-Rf" else command[3:])
+        return subprocess.CompletedProcess(command, 0, b"", b"")
+    return subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+
+
+def make_kdk(root: Path) -> Path:
+    ext = root / "KDK.kdk/System/Library/Extensions"
+    for rel, data in {
+        "Foo.kext/Contents/Info.plist": "plist",
+        "Foo.kext/Contents/MacOS/Foo": "release",
+        "Foo.kext/Contents/MacOS/Foo_development": "dev",
+        "Foo.kext/Contents/MacOS/Foo_kasan": "kasan",
+        "Flat.kext/Flat_development": "dev",
+        "Flat.kext/Flat": "release",
+        "Foo.kext.dSYM/Contents/Resources/DWARF/Foo": "dwarf",
+        "Foo.kext.dSYM/Contents/Resources/DWARF/Foo_kasan": "dwarf",
+        "Kept_developmentNotes.txt": "not a variant suffix",
+    }.items():
+        path = ext / rel
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(data)
+    return root / "KDK.kdk"
+
+
+def merged_names(dest: Path) -> set:
+    return {str(p.relative_to(dest)) for p in dest.rglob("*")}
+
+
+def test_merge(work: Path, rsync: bool) -> None:
+    label = "rsync" if rsync else "ditto"
+    kdk = make_kdk(work / label)
+    mount = work / label / "mount"
+    ext = mount / "System/Library/Extensions"
+    ext.mkdir(parents=True)
+    # Apple's own file that happens to match a pattern must survive a ditto merge.
+    (ext / "Stock.kext/Contents/MacOS").mkdir(parents=True)
+    (ext / "Stock.kext/Contents/MacOS/Stock_kasan").write_text("apple")
+    files_module._RSYNC_USABLE = rsync
+    kdk_merge.rsync_usable = lambda: rsync
+    merger = kdk_merge.KernelDebugKitMerge.__new__(kdk_merge.KernelDebugKitMerge)
+    merger.mount_location = str(mount)
+    try:
+        merger._merge_kdk(str(kdk))
+    except Exception:
+        pass      # the fake KDK has no Libkern; the merge itself has happened
+    if not rsync:
+        check(merged_names(ext) == {"Stock.kext", "Stock.kext/Contents", "Stock.kext/Contents/MacOS", "Stock.kext/Contents/MacOS/Stock_kasan"},
+              "missing rsync refuses without target mutation")
+        return
+    names = merged_names(ext)
+    check({"Foo.kext/Contents/MacOS/Foo", "Flat.kext/Flat", "Foo.kext/Contents/Info.plist", "Kept_developmentNotes.txt"} <= names,
+          f"{label}: release executables, plists and non-suffix names are merged")
+    check(not any(n.endswith((".dSYM", "_development", "_kasan")) or ".dSYM/" in n for n in names - {"Stock.kext/Contents/MacOS/Stock_kasan"}),
+          f"{label}: no dSYM bundle and no _development/_kasan variant is merged")
+    check((ext / "Stock.kext/Contents/MacOS/Stock_kasan").read_text() == "apple", f"{label}: a pre-existing matching file is left alone")
+
+
+def test_fix_permissions(work: Path) -> None:
+    source = work / "perm/src/Thing.framework"
+    dest = work / "perm/dest/Thing.framework"
+    elsewhere = work / "perm/dest/Other.framework/CodeResources"
+    for p in (source / "Versions/A/Thing", source / "Versions/A/Resources/New.plist"):
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text("payload")
+    (dest / "Versions/A/Resources").mkdir(parents=True)
+    elsewhere.parent.mkdir(parents=True)
+    elsewhere.write_text("shared")
+    os.chmod(elsewhere, 0o644)
+    shared = dest / "Versions/A/Resources/CodeResources"
+    os.link(elsewhere, shared)                        # pre-existing Apple file, hard-linked elsewhere
+    unrelated = dest / "Versions/A/Resources/Stock.plist"
+    unrelated.write_text("apple"); os.chmod(unrelated, 0o644)
+    # The merge copied the payload, including one file that rsync left as the pre-existing shared inode.
+    shutil.copytree(source, dest, dirs_exist_ok=True)
+    (source / "Versions/A/Resources/CodeResources").write_text("shared")
+    files_module.fix_permissions(str(dest), source=str(source))
+    check(oct(os.stat(elsewhere).st_mode & 0o777) == "0o644", "hard-linked file elsewhere keeps mode 644 (no spill-over)")
+    check(oct(os.stat(unrelated).st_mode & 0o777) == "0o644", "pre-existing file not in the payload keeps its mode")
+    check(oct(os.stat(dest / "Versions/A/Thing").st_mode & 0o777) == "0o755", "merged payload file gets 755")
+    check(str(dest / "Versions/A/Resources/New.plist") in CHOWNED and str(elsewhere) not in CHOWNED,
+          "chown limited to merged entries")
+    single = work / "perm/single"; single.write_text("x"); os.chmod(single, 0o600)
+    files_module.fix_permissions(str(single))
+    check(oct(os.stat(single).st_mode & 0o777) == "0o755", "non-merge call keeps the original behaviour")
+
+
+def main() -> int:
+    work = Path(sys.argv[1]).resolve()
+    if work.exists():
+        shutil.rmtree(work)
+    work.mkdir(parents=True)
+    logging.basicConfig(level=logging.WARNING, format="%(message)s")
+    subprocess_wrapper.run_as_root = run_as_user
+    subprocess_wrapper.run_as_root_and_verify = run_as_user
+    test_merge(work, rsync=True)
+    test_merge(work, rsync=False)
+    test_fix_permissions(work)
+    print(f"{len(failures)} failed")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/ssd-target/tests/test_target_mode.py b/ssd-target/tests/test_target_mode.py
