diff --git a/opencore_legacy_patcher/sys_patch/target.py b/opencore_legacy_patcher/sys_patch/target.py
new file mode 100644
index 0000000000000000000000000000000000000000..339b53ccba34309e31b91ff52ff11f405669f074
--- /dev/null
+++ b/opencore_legacy_patcher/sys_patch/target.py
@@ -0,0 +1,370 @@
+"""
+target.py: Root patching a non-booted target volume (ssd-tools derivative)
+
+Stock OCLP patches the booted system. With '--patch_sys_vol --target <volume>'
+the patcher runs from another macOS (ex. a recoveryOS booted from USB) on the
+same machine and patches a macOS install that has never booted:
+- Hardware detection still probes the running machine (it must be the target's hardware)
+- OS version, build and kernel version come from the target's System volume
+- The target's System volume (live, not its snapshot) is mounted read/write at TARGET_MOUNT
+- Every Data volume path is prefixed with the target's Data volume mount point
+- The new snapshot is blessed on the target, the booted volume is never touched
+
+Helpers 'system_root()' and 'data_root()' return "" when no target is set, so
+stock code paths stay byte-identical: f"{data_root(c)}/Library/Extensions" == "/Library/Extensions"
+"""
+
+import os
+import re
+import sys
+import logging
+import plistlib
+import subprocess
+
+from pathlib import Path
+
+from ..support import subprocess_wrapper
+
+
+TARGET_MOUNT = "/private/var/tmp/oclp-target"
+
+
+class PatchTarget:
+
+    def __init__(self, target: str, mount_name: str = None) -> None:
+        """
+        Parameters:
+            target (str): Path inside the target install, a mount point, or a disk identifier
+                          (ex. "/Volumes/Macintosh HD", "disk2s1"). Any volume of the target's
+                          APFS volume group works; the System + Data pair is resolved from it.
+            mount_name (str): Folder name under TARGET_MOUNT for the System volume (default: its disk
+                          identifier). kmutil writes the mount path into the kernel collections, so a fixed
+                          name keeps them independent of how the host numbers its disks.
+        """
+        self.target = target
+        self.mount_name = mount_name
+
+        self.container:      str = None
+        self.system_device:  str = None
+        self.data_device:    str = None
+        self.data_mount:     str = None
+        self.data_filevault: bool = False
+        self.system_mount:   str = None
+
+        self.product_version: str = None
+        self.product_build:   str = None
+        self.xnu_major:       int = None
+        self.xnu_minor:       int = None
+
+        self._mounted_system = False
+
+
+    def _diskutil_info(self, identifier: str) -> dict:
+        result = subprocess.run(["/usr/sbin/diskutil", "info", "-plist", identifier], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        if result.returncode != 0:
+            raise RuntimeError(f"diskutil info {identifier} failed: {result.stderr.decode().strip()}")
+        return plistlib.loads(result.stdout)
+
+
+    def _container_volumes(self, container: str) -> list:
+        result = subprocess.run(["/usr/sbin/diskutil", "apfs", "list", "-plist", container], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        if result.returncode != 0:
+            raise RuntimeError(f"diskutil apfs list {container} failed: {result.stderr.decode().strip()}")
+        containers = plistlib.loads(result.stdout).get("Containers", [])
+        if len(containers) != 1:
+            raise RuntimeError(f"Expected one APFS container for {container}, found {len(containers)}")
+        return containers[0]["Volumes"]
+
+
+    def resolve(self) -> None:
+        """
+        Find the target's System and Data volumes and refuse unsafe targets
+        """
+        info = self._diskutil_info(self.target)
+        self.container = info.get("APFSContainerReference")
+        if not self.container:
+            raise RuntimeError(f"{self.target} is not on an APFS volume")
+
+        booted = self._diskutil_info("/")
+        if booted.get("APFSContainerReference") == self.container:
+            raise RuntimeError(f"Target {self.target} is in the booted container ({self.container}), use stock patching instead")
+
+        group = info.get("APFSVolumeGroupID")
+        systems, datas = [], []
+        for volume in self._container_volumes(self.container):
+            roles = volume.get("Roles", [])
+            if "System" not in roles and "Data" not in roles:
+                continue
+            if group is not None:
+                volume_group = self._diskutil_info(volume["DeviceIdentifier"]).get("APFSVolumeGroupID")
+                if volume_group != group:
+                    continue
+            (systems if "System" in roles else datas).append(volume)
+
+        if len(systems) != 1 or len(datas) != 1:
+            raise RuntimeError(f"Expected one System and one Data volume for {self.target}, found {len(systems)} and {len(datas)}; pass the target's System volume")
+
+        if datas[0].get("Locked") is True:
+            raise RuntimeError(f"Target Data volume {datas[0]['DeviceIdentifier']} is locked (FileVault), unlock it first")
+
+        self.system_device = systems[0]["DeviceIdentifier"]
+        self.data_device   = datas[0]["DeviceIdentifier"]
+        self.data_filevault = datas[0].get("FileVault") is True
+
+        self.data_mount = self._diskutil_info(self.data_device).get("MountPoint") or None
+        if self.data_mount is None:
+            logging.info(f"- Mounting target Data volume {self.data_device}")
+            subprocess_wrapper.run_as_root_and_verify(["/usr/sbin/diskutil", "mount", self.data_device], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+            self.data_mount = self._diskutil_info(self.data_device).get("MountPoint") or None
+        if self.data_mount is None or self.data_mount == "/":
+            raise RuntimeError(f"Could not mount target Data volume {self.data_device}")
+
+
+    def _mounts(self, device: str) -> list:
+        """
+        (mount point, options) of exactly /dev/<device> as the kernel reports them (f_mntonname, firmlinks resolved)
+        """
+        mounts = []
+        for line in subprocess.run(["/sbin/mount"], stdout=subprocess.PIPE).stdout.decode(errors="replace").splitlines():
+            source, _, rest = line.partition(" on ")
+            if source == f"/dev/{device}":
+                point, _, options = rest.rpartition(" (")
+                mounts.append((point, [o.strip() for o in options.rstrip(")").split(",")]))
+        return mounts
+
+
+    def _mount_points(self, device: str) -> list:
+        return [point for point, _ in self._mounts(device)]
+
+
+    def mount_system(self) -> str:
+        """
+        Mount the target's live System volume read/write (snapshot mounts stay as they are)
+
+        system_mount is the path the kernel reports for the mount: under recoveryOS /private is a firmlink
+        into the RAM Data volume, so /private/var/tmp/... mounts as /System/Volumes/Data/private/var/tmp/...,
+        and kmutil skips a --volume-root that differs from that ("is not a volume root, skipping rebuild").
+        """
+        mount_point = f"{TARGET_MOUNT}/{self.mount_name or self.system_device}"
+        if Path(f"{mount_point}/System/Library/CoreServices/SystemVersion.plist").exists():
+            # Left over from an earlier run. Reuse it only if it really is a read/write mount of this target's
+            # System volume: a plain folder there would be "patched" and blessed in place of the target.
+            mounted = [(p, options) for p, options in self._mounts(self.system_device) if os.path.samefile(p, mount_point)]
+            if not mounted:
+                raise RuntimeError(f"{mount_point} holds a System folder but is not a mount of /dev/{self.system_device}; remove it first")
+            if "read-only" in mounted[0][1]:
+                raise RuntimeError(f"/dev/{self.system_device} is mounted read-only at {mounted[0][0]}; unmount it first")
+            logging.info(f"- Reusing the target System volume mount at {mounted[0][0]}")
+            self.system_mount = mounted[0][0]
+            return self.system_mount
+
+        # DiskArbitration mounts a non-booted System volume's live file system read-only (ex. /Volumes/macOS);
+        # APFS refuses a second mount of it ("Operation already in progress"), so unmount that first.
+        # Snapshot mounts (diskXsYsZ) can stay, as for the booted system.
+        for existing in self._mount_points(self.system_device):
+            logging.info(f"- Target System volume is mounted at {existing}, unmounting it first")
+            result = subprocess_wrapper.run_as_root(["/usr/sbin/diskutil", "unmount", self.system_device], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+            if result.returncode != 0:
+                subprocess_wrapper.log(result)
+                raise RuntimeError(f"Could not unmount the target System volume from {existing}")
+
+        subprocess_wrapper.run_as_root_and_verify(["/bin/mkdir", "-p", mount_point], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        result = subprocess_wrapper.run_as_root(["/sbin/mount", "-o", "nobrowse", "-t", "apfs", f"/dev/{self.system_device}", mount_point], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        if result.returncode != 0:
+            subprocess_wrapper.log(result)
+            raise RuntimeError(f"Failed to mount target System volume {self.system_device} at {mount_point}")
+
+        mounted = self._mount_points(self.system_device)
+        if len(mounted) != 1:
+            raise RuntimeError(f"Target System volume {self.system_device} mounted {len(mounted)} times after mounting: {mounted}")
+        self.system_mount = mounted[0]
+        self._mounted_system = True
+        if self.system_mount != mount_point:
+            logging.info(f"- Target System volume mounted at {self.system_mount}")
+        return self.system_mount
+
+
+    def release(self) -> None:
+        """
+        Unmount the target System volume if it is still mounted at system_mount
+
+        Stock OCLP unmounts only on success and after a failed sanity check or hook. Every other exit (no patch
+        sets needed, can_patch False, PatcherSupportPkg missing, kmutil failure, an exception) left the target's
+        live System volume mounted read/write. Safe to call more than once. The Data volume is left as it is.
+        """
+        if not self.system_device or not self.system_mount:
+            return
+        if self.system_mount not in self._mount_points(self.system_device):
+            return
+        logging.info(f"- Unmounting target System volume at {self.system_mount}")
+        result = subprocess_wrapper.run_as_root(["/sbin/umount", self.system_mount], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        if result.returncode != 0:
+            logging.error(f"- Could not unmount {self.system_mount}")
+            subprocess_wrapper.log(result)
+
+
+    def preboot_kernel_collections(self) -> tuple:
+        """
+        (folder, mounted_by_us) of the target's Preboot copy of the Boot kernel collection:
+        <Preboot>/<volume group>/boot/System/Library/KernelCollections. kmutil --update-all writes it on an Intel
+        host; a host that cannot run --update-all (Apple silicon) has to copy the new BootKC there itself.
+        """
+        group = self._diskutil_info(self.system_device).get("APFSVolumeGroupID")
+        preboot = [v["DeviceIdentifier"] for v in self._container_volumes(self.container) if "Preboot" in v.get("Roles", [])]
+        if not group or len(preboot) != 1:
+            raise RuntimeError(f"Target container {self.container}: volume group {group}, Preboot volumes {preboot}")
+        mount_point = self._diskutil_info(preboot[0]).get("MountPoint") or None
+        mounted_by_us = False
+        if mount_point is None:
+            subprocess_wrapper.run_as_root_and_verify(["/usr/sbin/diskutil", "mount", "-mountOptions", "nobrowse", preboot[0]], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+            mount_point = self._diskutil_info(preboot[0]).get("MountPoint") or None
+            mounted_by_us = True
+        if mount_point is None:
+            raise RuntimeError(f"Could not mount the target Preboot volume {preboot[0]}")
+        return f"{mount_point}/{group}/boot/System/Library/KernelCollections", mounted_by_us
+
+
+    def kernel_collections_fingerprint(self) -> dict:
+        """
+        (size, mtime, inode) of the target's Boot and System kernel collections
+        """
+        result = {}
+        for name in ("BootKernelExtensions.kc", "SystemKernelExtensions.kc"):
+            path = Path(f"{self.system_mount}/System/Library/KernelCollections/{name}")
+            st = path.stat() if path.exists() else None
+            result[name] = (st.st_size, st.st_mtime_ns, st.st_ino) if st else None
+        return result
+
+
+    def read_os_version(self) -> None:
+        """
+        Read the target's macOS version and its kernel's Darwin version
+        """
+        version_plist = Path(f"{self.system_mount}/System/Library/CoreServices/SystemVersion.plist")
+        data = plistlib.load(version_plist.open("rb"))
+        self.product_version = data["ProductVersion"]
+        self.product_build   = data["ProductBuildVersion"]
+
+        kernel = Path(f"{self.system_mount}/System/Library/Kernels/kernel")
+        match = None
+        if kernel.exists():
+            match = re.search(rb"Darwin Kernel Version (\d+)\.(\d+)\.(\d+)", kernel.read_bytes())
+        if match is None:
+            raise RuntimeError(f"Could not read the Darwin version from {kernel}")
+
+        self.xnu_major = int(match.group(1))
+        self.xnu_minor = int(match.group(2))
+
+
+    def apply_to_constants(self, global_constants) -> None:
+        """
+        Make the patcher see the target's OS instead of the running one
+        """
+        logging.info(f"- Target: {self.product_version} ({self.product_build}), Darwin {self.xnu_major}.{self.xnu_minor}")
+        logging.info(f"  - System: {self.system_device} at {self.system_mount}")
+        logging.info(f"  - Data:   {self.data_device} at {self.data_mount}")
+        if global_constants.detected_os_build != self.product_build:
+            logging.info(f"  - Running OS is {global_constants.detected_os_version} ({global_constants.detected_os_build})")
+
+        global_constants.detected_os         = self.xnu_major
+        global_constants.detected_os_minor   = self.xnu_minor
+        global_constants.detected_os_build   = self.product_build
+        global_constants.detected_os_version = self.product_version
+        global_constants.target              = self
+
+
+    def check_supported_os(self) -> None:
+        """
+        Target patching needs a sealed System volume (Big Sur, Darwin 20, or newer). For Catalina, stock OCLP
+        runs '/usr/sbin/kcditto', which updates the running system's Preboot, and makes no snapshot.
+        """
+        if self.xnu_major < 20:
+            raise RuntimeError(f"Target runs macOS {self.product_version} (Darwin {self.xnu_major}); target patching needs Big Sur or newer")
+
+
+    def check_same_build(self, running_build: str, allow_mismatch: bool = False) -> None:
+        """
+        The running OS's kmutil and bless build the target's kernel collections and snapshot. Every hardware run
+        so far used the same build on both sides (2026-10-10 from a booted 25G241 host, 2026-10-19 from recoveryOS
+        25G241), as the 2026-10-10 prototype required. A different build is refused unless explicitly allowed
+        (--allow_build_mismatch): untested, not known to fail.
+        """
+        if running_build == self.product_build:
+            return
+        if allow_mismatch:
+            logging.warning(f"- Running OS build {running_build} differs from the target's {self.product_build} (allowed, untested)")
+            return
+        raise RuntimeError(f"Running OS build {running_build} differs from the target's {self.product_build}; "
+                           "patch from the same build, or pass --allow_build_mismatch")
+
+
+    def setup(self, global_constants, allow_build_mismatch: bool = False) -> None:
+        self.resolve()
+        self.mount_system()
+        self.read_os_version()
+        self.check_supported_os()
+        self.check_same_build(global_constants.detected_os_build, allow_build_mismatch)
+        self.apply_to_constants(global_constants)
+
+
+def system_root(global_constants) -> str:
+    """
+    Prefix for paths on the System volume being inspected ("" = booted system)
+    """
+    target = getattr(global_constants, "target", None)
+    return target.system_mount if target else ""
+
+
+def data_root(global_constants) -> str:
+    """
+    Prefix for paths on the Data volume being patched ("" = booted system)
+    """
+    target = getattr(global_constants, "target", None)
+    return target.data_mount if target else ""
+
+
+def run_hooks(global_constants, hooks_dir: str) -> bool:
+    """
+    Run the hooks in hooks_dir (sorted by name) after the patch sets are installed and
+    before the kernel cache rebuild and snapshot. A hook is either a '*.sh' file or a
+    folder with a 'hook.sh' inside (so it can carry its own payload next to it). Hooks run
+    with /bin/sh, exec bits are not needed. A failing hook stops patching: no snapshot is
+    made, so the target keeps booting its previous snapshot.
+
+    Each hook gets: $1 = System volume mount, $2 = Data volume mount, and in the environment
+    OCLP_TARGET_BUILD, OCLP_TARGET_VERSION and OCLP_PYTHON (this interpreter, for hashing etc.).
+    """
+    if not hooks_dir:
+        return True
+
+    hooks = []
+    for entry in sorted(Path(hooks_dir).iterdir()):
+        if entry.name.startswith("."):
+            continue
+        if entry.is_dir() and (entry / "hook.sh").is_file():
+            hooks.append(entry / "hook.sh")
+        elif entry.is_file() and entry.suffix == ".sh":
+            hooks.append(entry)
+    if not hooks:
+        logging.info(f"- No hooks in {hooks_dir}")
+        return True
+
+    system = system_root(global_constants) or "/System/Volumes/Update/mnt1"
+    data   = data_root(global_constants) or "/"
+    environment = {
+        **os.environ,
+        "OCLP_TARGET_BUILD":   global_constants.detected_os_build,
+        "OCLP_TARGET_VERSION": global_constants.detected_os_version,
+        "OCLP_PYTHON":         sys.executable,
+    }
+    for hook in hooks:
+        name = hook.parent.name if hook.name == "hook.sh" else hook.name
+        logging.info(f"- Running hook {name}")
+        result = subprocess.run(["/bin/sh", str(hook), system, data], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=environment)
+        for line in result.stdout.decode(errors="replace").splitlines():
+            logging.info(f"  {line}")
+        if result.returncode != 0:
+            logging.error(f"- Hook {name} failed ({result.returncode}), stopping before the snapshot")
+            return False
+
+    return True
