+  self.assertEqual((out/'Native.kext/Native').read_bytes(),intel);self.assertEqual(report['excluded_bundles'],['Arm.kext'])
+  target=self.root/'target';target.mkdir();stock=target/'Arm.kext/Contents/Info.plist';stock.parent.mkdir(parents=True);stock.write_bytes(b'stock')
+  kept=target/'Native.kext/Native';kept.parent.mkdir();kept.write_bytes(intel);os.utime(kept,(1,1));inode=kept.stat().st_ino
+  amd=target/'AMD.kext/AMD';amd.parent.mkdir();amd.write_bytes(b'stockamd')
