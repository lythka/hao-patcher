+++ b/ssd-target/find_target.py
@@ -0,0 +1,56 @@
+"""
+find_target.py: print the System volume of the one macOS install on the internal disks
+
+For unattended target patching (ex. from a recoveryOS on USB): looks at every APFS container
+on internal physical disks, skips the booted one, and requires exactly one System volume.
+Anything else (none, several, a locked Data volume) is an error: exit 1, nothing printed.
+
+    python find_target.py [--any-disk]      (--any-disk: also external disks and disk images, for tests)
+"""
+
+import sys
+import plistlib
+import subprocess
+
+
+def diskutil(*args) -> dict:
+    result = subprocess.run(["/usr/sbin/diskutil", *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if result.returncode != 0:
+        raise RuntimeError(f"diskutil {' '.join(args)}: {result.stderr.decode().strip()}")
+    return plistlib.loads(result.stdout)
+
+
+def main() -> int:
+    any_disk = "--any-disk" in sys.argv[1:]
+    booted = diskutil("info", "-plist", "/").get("APFSContainerReference")
+
+    listing = diskutil("list", "-plist") if any_disk else diskutil("list", "-plist", "internal", "physical")
+    containers = set()
+    for disk in listing.get("AllDisksAndPartitions", []):
+        for partition in disk.get("Partitions", []) + ([disk] if disk.get("Content") == "Apple_APFS" else []):
+            if partition.get("Content") not in ("Apple_APFS", "41504653-0000-11AA-AA11-00306543ECAC"):
+                continue
+            container = diskutil("info", "-plist", partition["DeviceIdentifier"]).get("APFSContainerReference")
+            if container and container != booted:
+                containers.add(container)
+
+    systems = []
+    for container in sorted(containers):
+        for apfs in diskutil("apfs", "list", "-plist", container).get("Containers", []):
+            for volume in apfs.get("Volumes", []):
+                if "System" in volume.get("Roles", []):
+                    systems.append((container, volume))
+
+    if len(systems) != 1:
+        found = ", ".join(f"{c}:{v['DeviceIdentifier']} ({v.get('Name')})" for c, v in systems) or "none"
+        print(f"find_target: expected exactly one macOS System volume outside the booted container, found {found}", file=sys.stderr)
+        return 1
+
+    container, volume = systems[0]
+    print(f"find_target: {volume['DeviceIdentifier']} ({volume.get('Name')}) in {container}", file=sys.stderr)
+    print(volume["DeviceIdentifier"])
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
