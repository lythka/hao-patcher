index 0000000000000000000000000000000000000000..3985db8253a0c0c1acb629b4bbdd05e682d1d440
--- /dev/null
+++ b/ssd-target/tests/test_target_mode.py
@@ -0,0 +1,318 @@
+"""
+test_target_mode.py: host dry run of '--patch_sys_vol --target' (ssd-tools derivative)
+
+Runs the real PatchSysVolume code against a scratch target (fake System + Data roots) with
+every root command recorded instead of executed, then checks that all writes land on the
+target, never on the running system. Needs no root and changes nothing outside <work>.
+
+    python ssd-target/tests/test_target_mode.py <Universal-Binaries mount> <work dir> [--no-rsync]
+
+--no-rsync: behave like recoveryOS, where /usr/bin/rsync cannot run (merges go through ditto).
+--kmutil-noop: kmutil "succeeds" without writing anything (recoveryOS 2026-10-19: "is not a volume root,
+            skipping rebuild", exit 0); the patch must then fail before the snapshot.
+--p6 DIR:   also run the ssd-tools P6 hook (DIR = patches/P6-sysfix) for real on the scratch target, which
+            holds Apple's 25G241 hello metallib and OCLP's Metal wrapper as they are when hooks run
+            (--p6-orig DIR: where default.metallib.orig and Metal.orig are; chown is shimmed, no root).
+--hardware-profile FILE: select the patch sets with OCLP's real detection (HardwarePatchsetDetection) on
+            Computer.from_profile(FILE) instead of this host's hardware, and require the master's 9 sets.
+
+Without --hardware-profile, patch sets are taken from the real hardware classes for a MacBookPro9,2 on
+Tahoe (Intel Ivy Bridge, Modern Audio, Modern Wireless) because the host is not the target hardware.
+"""
+
+import os
+import sys
+import json
+import types
+import shutil
+import logging
+import plistlib
+import subprocess
+
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO))
+
+
+class _WxStub(types.ModuleType):
+    """wxPython is only needed for the GUI; any attribute is a dummy class so GUI modules import"""
+    def __getattr__(self, name):
+        if name.startswith("__"):
+            raise AttributeError(name)
+        stub = type(name, (object,), {"__init__": lambda self, *a, **k: None})
+        setattr(self, name, stub)
+        return stub
+
+try:
+    import wx  # noqa: F401
+except ImportError:
+    for module in ("wx", "wx.adv", "wx.html2"):
+        sys.modules[module] = _WxStub(module)
+
+from opencore_legacy_patcher import constants
+from opencore_legacy_patcher.support import subprocess_wrapper, kdk_handler
+from opencore_legacy_patcher.sys_patch import sys_patch
+from opencore_legacy_patcher.sys_patch.target import PatchTarget
+from opencore_legacy_patcher.sys_patch.mount import snapshot
+from opencore_legacy_patcher.sys_patch.utilities import files as patch_files
+from opencore_legacy_patcher.sys_patch.patchsets import HardwarePatchsetSettings, detect
+from opencore_legacy_patcher.detections import device_probe
+from opencore_legacy_patcher.sys_patch.patchsets.hardware.graphics import intel_ivy_bridge
+from opencore_legacy_patcher.sys_patch.patchsets.hardware.misc import modern_audio
+from opencore_legacy_patcher.sys_patch.patchsets.hardware.networking import modern_wireless
+
+# Patch sets in the master image's record (laptop, 2026-10-10)
+MASTER_SETS = {
+    "Metal 3802 Common", "Metal 3802 .metallibs Tahoe", "Tahoe Graphics", "Intel Ivy Bridge",
+    "Big Sur GVA", "Big Sur OpenCL", "Monterey OpenCL", "Modern Audio", "Modern Wireless Common",
+}
+
+# Install order of the laptop's own run (OCLP 3.0.0-rc.3 patch-run.log, 2026-10-10 19:10, target disk3s4)
+LAPTOP_ORDER = [
+    "Metal 3802 Common", "Metal 3802 .metallibs Tahoe", "Big Sur GVA", "Monterey OpenCL", "Big Sur OpenCL",
+    "Tahoe Graphics", "Intel Ivy Bridge", "Modern Wireless Common", "Modern Audio",
+]
+
+ROOT_LOG   = []
+DIRECT_LOG = []
+_real_run  = subprocess.run
+KMUTIL_WRITES = True
+
+
+def fake_run_as_root(*args, **kwargs):
+    command = [str(a) for a in args[0]]
+    ROOT_LOG.append(command)
+    if command[0] == "/usr/bin/kmutil" and KMUTIL_WRITES and "--volume-root" in command:
+        root = command[command.index("--volume-root") + 1]
+        for name in ("BootKernelExtensions.kc", "SystemKernelExtensions.kc"):
+            path = Path(root) / "System/Library/KernelCollections" / name
+            path.unlink()
+            path.write_bytes(b"rebuilt " + name.encode())
+    return subprocess.CompletedProcess(command, 0, b"", b"")
+
+
+def guarded_run(*args, **kwargs):
+    command = args[0] if args else kwargs.get("args")
+    command = [str(a) for a in command] if isinstance(command, (list, tuple)) else [str(command)]
+    DIRECT_LOG.append(command)
+    read_only = (
+        command[:2] == ["/usr/bin/defaults", "read"] or
+        command[:2] == ["/usr/sbin/pkgutil", "--files"] or
+        command[:1] == ["/bin/sh"]      # our hooks
+    )
+    if read_only:
+        return _real_run(*args, **kwargs)
+    return subprocess.CompletedProcess(command, 0, b"", b"")
+
+
+def build_target(work: Path, patches: dict) -> tuple[Path, Path]:
+    system, data = work / "target-system", work / "target-data"
+    for root in (system, data):
+        if root.exists():
+            shutil.rmtree(root)
+    (system / "System/Library/CoreServices").mkdir(parents=True)
+    plistlib.dump({"ProductVersion": "26.7.1", "ProductBuildVersion": "25G241"}, (system / "System/Library/CoreServices/SystemVersion.plist").open("wb"))
+    (system / "System/Library/Kernels").mkdir(parents=True)
+    (system / "System/Library/KernelCollections").mkdir(parents=True)
+    for name in ("BootKernelExtensions.kc", "SystemKernelExtensions.kc"):
+        (system / "System/Library/KernelCollections" / name).write_bytes(b"original " + name.encode())
+    (system / "System/Library/Kernels/kernel").write_bytes(b"\0" * 64 + b"Darwin Kernel Version 25.6.0: Thu Sep 24 2026; root:xnu" + b"\0" * 64)
+    libkern = system / "System/Library/Extensions/System.kext/PlugIns/Libkern.kext/Libkern"
+    libkern.parent.mkdir(parents=True)
+    libkern.write_bytes(b"")
+    for patch in patches.values():
+        for method, directories in patch.items():
+            if not isinstance(directories, dict):
+                continue
+            for directory in directories:
+                if "System Volume" in str(method):
+                    (system / directory.lstrip("/")).mkdir(parents=True, exist_ok=True)
+                elif "Data Volume" in str(method):
+                    (data / directory.lstrip("/")).mkdir(parents=True, exist_ok=True)
+    for directory in ("Library/Extensions", "Library/Preferences", "Library/Application Support", "private/etc"):
+        (data / directory).mkdir(parents=True, exist_ok=True)
+    return system, data
+
+
+def build_kdk(work: Path) -> Path:
+    kdks = work / "KDKs"
+    kdk = kdks / "KDK_26.7.1_25G241.kdk"
+    if kdks.exists():
+        shutil.rmtree(kdks)
+    (kdk / "System/Library/CoreServices").mkdir(parents=True)
+    plistlib.dump({"ProductBuildVersion": "25G241"}, (kdk / "System/Library/CoreServices/SystemVersion.plist").open("wb"))
+    for kext in ["System.kext/PlugIns/Libkern.kext/Libkern", "apfs.kext/Contents/MacOS/apfs",
+                 "IOUSBHostFamily.kext/Contents/MacOS/IOUSBHostFamily", "AMDRadeonX6000.kext/Contents/MacOS/AMDRadeonX6000"]:
+        path = kdk / "System/Library/Extensions" / kext
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(b"")
+    return kdks
+
+
+def build_hooks(work: Path) -> Path:
+    hooks = work / "hooks"
+    if hooks.exists():
+        shutil.rmtree(hooks)
+    hooks.mkdir()
+    (hooks / "10-record.sh").write_text(f'echo "system=$1 data=$2 build=$OCLP_TARGET_BUILD version=$OCLP_TARGET_VERSION" > "{work}/hook-ran.txt"\necho hook ok\n')
+    (hooks / "20-folder").mkdir()
+    (hooks / "20-folder/hook.sh").write_text(f'[ -f "$(dirname "$0")/payload.txt" ] && "$OCLP_PYTHON" -c "print(1)" > "{work}/hook2-ran.txt"\n')
+    (hooks / "20-folder/payload.txt").write_text("x")
+    (hooks / ".hidden.sh").write_text("exit 1\n")
+    return hooks
+
+
+def main() -> int:
+    universal_binaries, work = Path(sys.argv[1]), Path(sys.argv[2]).resolve()
+    no_rsync = "--no-rsync" in sys.argv[3:]
+    global KMUTIL_WRITES
+    KMUTIL_WRITES = "--kmutil-noop" not in sys.argv[3:]
+    patch_files._RSYNC_USABLE = False if no_rsync else True
