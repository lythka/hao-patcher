+"""
+test_consolidated.py: host checks for the pieces merged from the 2026-10-10 prototype (ssd-target-consolidated)
+
+No root, no disks: diskutil/mount output is faked, every root command is recorded instead of run.
+
+    python ssd-target/tests/test_consolidated.py <work dir>
+
+Checks: --target_volume alias, target options without --patch_sys_vol exit 2, WindowServer quoting (stock command
+unchanged, a Data mount with a quote and spaces works in bash), PatchTarget.release(), leftover-mount reuse rules,
+Big Sur minimum, same-build rule, and that the target handler releases the mount on setup failure and on exceptions.
+"""
+
+import os
+import sys
+import shlex
+import types
+import shutil
+import logging
+import plistlib
+import subprocess
+
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO))
+
+
+class _WxStub(types.ModuleType):
+    def __getattr__(self, name):
+        if name.startswith("__"):
+            raise AttributeError(name)
+        stub = type(name, (object,), {"__init__": lambda self, *a, **k: None})
+        setattr(self, name, stub)
+        return stub
+
+try:
+    import wx  # noqa: F401
+except ImportError:
+    for module in ("wx", "wx.adv", "wx.html2"):
+        sys.modules[module] = _WxStub(module)
+
+from opencore_legacy_patcher import constants
+from opencore_legacy_patcher.support import subprocess_wrapper, utilities
+from opencore_legacy_patcher.support import arguments as arguments_module
+from opencore_legacy_patcher.sys_patch import target as target_module
+from opencore_legacy_patcher.sys_patch import sys_patch_helpers
+from opencore_legacy_patcher.sys_patch.target import PatchTarget
+
+ROOT_LOG = []
+MOUNT_TABLE = []          # lines /sbin/mount prints
+_real_run = subprocess.run
+failures = []
+
+
+def check(condition, message):
+    print(("PASS " if condition else "FAIL ") + message)
+    if not condition:
+        failures.append(message)
+
+
+def fake_run_as_root(*args, **kwargs):
+    command = [str(a) for a in args[0]]
+    ROOT_LOG.append(command)
+    if command[0] == "/sbin/umount":
+        MOUNT_TABLE[:] = [line for line in MOUNT_TABLE if f" on {command[1]} (" not in line]
+    return subprocess.CompletedProcess(command, 0, b"", b"")
+
+
+def fake_run(*args, **kwargs):
+    command = args[0] if args else kwargs.get("args")
+    if command == ["/sbin/mount"]:
+        return subprocess.CompletedProcess(command, 0, "\n".join(MOUNT_TABLE).encode(), b"")
+    raise AssertionError(f"unexpected command: {command}")
+
+
+def parse(argv):
+    saved = sys.argv
+    sys.argv = ["oclp"] + argv
+    try:
+        return utilities.check_cli_args()
+    finally:
+        sys.argv = saved
+
+
+def main() -> int:
+    work = Path(sys.argv[1]).resolve()
+    if work.exists():
+        shutil.rmtree(work)
+    work.mkdir(parents=True)
+    logging.basicConfig(level=logging.INFO, format="%(message)s")
+
+    # 1. CLI
+    args = parse(["--patch_sys_vol", "--target_volume", "disk3s4"])
+    check(args is not None and args.target == "disk3s4", "--target_volume is an alias of --target")
+    args = parse(["--patch_sys_vol", "--target", "/Volumes/macOS"])
+    check(args.target == "/Volumes/macOS" and args.allow_build_mismatch is False, "--target still works, --allow_build_mismatch defaults off")
+    check(parse([]) is None, "no arguments still means GUI (check_cli_args returns None)")
+    for argv in (["--target", "disk3s4"], ["--hooks", "/tmp/x"], ["--kdk_dir", "/tmp/k"], ["--allow_build_mismatch"]):
+        saved = sys.argv
+        sys.argv = ["oclp"] + argv
+        try:
+            arguments_module.arguments(constants.Constants())
+            code = None
+        except SystemExit as e:
+            code = e.code
+        finally:
+            sys.argv = saved
+        check(code == 2, f"{' '.join(argv)} without --patch_sys_vol exits 2 (got {code})")
+
+    subprocess_wrapper.run_as_root = fake_run_as_root
+    target_module.subprocess_wrapper.run_as_root = fake_run_as_root
+    sys_patch_helpers.subprocess_wrapper.run_as_root = fake_run_as_root
+
+    # 2. WindowServer quoting
+    c = constants.Constants()
+    c.detected_os = 25
+    ROOT_LOG.clear()
+    sys_patch_helpers.SysPatchHelpers(c).disable_window_server_caching()
+    check(ROOT_LOG == [["/bin/bash", "-c", "/bin/rm -rf /private/var/folders/*/*/*/WindowServer/com.apple.WindowServer"],
+                       ["/bin/bash", "-c", "/usr/bin/chflags uchg /private/var/folders/*/*/*/WindowServer"]],
+          "stock WindowServer commands are byte-identical to upstream")
+    data = work / "Bob's SSD - Data"
+    cache = data / "private/var/folders/ab/cd/C/WindowServer/com.apple.WindowServer"
+    cache.mkdir(parents=True)
+    c.target = types.SimpleNamespace(data_mount=str(data), system_mount=str(work / "sys"))
+    ROOT_LOG.clear()
+    sys_patch_helpers.SysPatchHelpers(c).disable_window_server_caching()
+    rm, chflags = ROOT_LOG
+    _real_run(rm, check=True)
+    check(not cache.exists() and cache.parent.exists(), "rm command removes the cache under a Data mount named with a quote and spaces")
+    syntax = _real_run(["/bin/bash", "-n", "-c", chflags[2]]).returncode
+    check(syntax == 0 and chflags[2] == "/usr/bin/chflags uchg " + shlex.quote(f"{data}/private/var/folders") + "/*/*/*/WindowServer",
+          "chflags command is valid bash with the prefix quoted")
+
+    subprocess.run = fake_run
+    target_module.subprocess.run = fake_run
+    try:
+        # 3. release()
+        t = PatchTarget("disk9s1")
+        t.system_device, t.system_mount = "disk9s1", "/private/var/tmp/oclp-target/disk9s1"
+        MOUNT_TABLE[:] = ["/dev/disk9s1 on /private/var/tmp/oclp-target/disk9s1 (apfs, local, nobrowse)",
+                          "/dev/disk9s1s1 on /Volumes/macOS 1 (apfs, local, read-only)"]
+        ROOT_LOG.clear()
+        t.release()
+        check(ROOT_LOG == [["/sbin/umount", "/private/var/tmp/oclp-target/disk9s1"]], "release() unmounts the target System mount")
+        ROOT_LOG.clear()
+        t.release()
+        check(ROOT_LOG == [], "release() twice: nothing to do the second time (snapshot mount untouched)")
+        PatchTarget("x").release()
+        check(ROOT_LOG == [], "release() before resolve/mount does nothing")
+
+        # 4. leftover mount reuse
+        target_module.TARGET_MOUNT = str(work / "mnt")
+        leftover = work / "mnt/disk9s1"
+        (leftover / "System/Library/CoreServices").mkdir(parents=True)
+        plistlib.dump({"ProductBuildVersion": "25G241"}, (leftover / "System/Library/CoreServices/SystemVersion.plist").open("wb"))
+        for table, expect, message in [
+            ([], "not a mount", "leftover folder that is not a mount is refused"),
+            ([f"/dev/disk9s1 on {leftover} (apfs, local, read-only, nobrowse)"], "read-only", "leftover read-only mount is refused"),
+            ([f"/dev/disk9s2 on {leftover} (apfs, local, nobrowse)"], "not a mount", "leftover mount of another device is refused"),
+        ]:
+            MOUNT_TABLE[:] = table
+            t = PatchTarget("disk9s1")
+            t.system_device = "disk9s1"
+            try:
+                t.mount_system()
+                error = ""
+            except RuntimeError as e:
+                error = str(e)
+            check(expect in error, f"{message} ({error!r})")
+        MOUNT_TABLE[:] = [f"/dev/disk9s1 on {leftover} (apfs, local, nobrowse)"]
+        t = PatchTarget("disk9s1")
+        t.system_device = "disk9s1"
+        ROOT_LOG.clear()
+        check(t.mount_system() == str(leftover) and ROOT_LOG == [], "leftover read/write mount of the target is reused, nothing remounted")
+
+        # 5. Big Sur minimum, 6. same-build rule
+        for xnu, ok in ((19, False), (20, True), (25, True)):
+            t = PatchTarget("x")
+            t.xnu_major, t.product_version = xnu, "test"
+            try:
+                t.check_supported_os()
+                passed = True
+            except RuntimeError:
+                passed = False
+            check(passed == ok, f"Darwin {xnu} target {'accepted' if ok else 'refused'}")
+        t = PatchTarget("x")
+        t.product_build = "25G241"
+        results = []
+        for running, allow in (("25G241", False), ("25G325", False), ("25G325", True)):
+            try:
+                t.check_same_build(running, allow)
+                results.append(True)
+            except RuntimeError:
+                results.append(False)
+        check(results == [True, False, True], f"same build accepted, mismatch refused, --allow_build_mismatch accepts ({results})")
+
+        # 7. handler releases the mount on setup failure and on exceptions
+        saved_euid, saved_setup, saved_release, saved_patcher = os.geteuid, PatchTarget.setup, PatchTarget.release, arguments_module.sys_patch.PatchSysVolume
+        arguments_module.os.geteuid = lambda: 0
+        released = []
+        PatchTarget.release = lambda self: released.append(self.target)
+        try:
+            def setup_fails(self, global_constants, allow_build_mismatch=False):
+                self.system_device, self.system_mount = "disk9s1", str(leftover)
+                raise RuntimeError("mismatch")
+            def setup_ok(self, global_constants, allow_build_mismatch=False):
+                global_constants.target = self
+            class Raises:
+                def __init__(self, *a, **k): pass
+                def start_patch(self): raise Exception("EXECUTE patch sets are not supported")
+            class Succeeds:
+                def __init__(self, model, c, details): self.c = c
+                def start_patch(self): self.c.root_patcher_succeeded = True
+            for setup, patcher, expect, message in [
+                (setup_fails, Succeeds, 2, "setup failure"),
+                (setup_ok, Raises, 1, "exception in patching"),
+                (setup_ok, Succeeds, 0, "success"),
+            ]:
+                PatchTarget.setup = setup
+                arguments_module.sys_patch.PatchSysVolume = patcher
+                released.clear()
+                c = constants.Constants()
+                c.computer = types.SimpleNamespace(real_model="MacBookPro9,2")
+                handler = arguments_module.arguments.__new__(arguments_module.arguments)
+                handler.constants = c
+                handler.args = parse(["--patch_sys_vol", "--target", "disk9s1"])
+                try:
+                    handler._sys_patch_target_handler()
+                    code = None
+                except SystemExit as e:
+                    code = e.code
+                check(code == expect and released == ["disk9s1"], f"handler, {message}: exit {code}, released once ({released})")
+        finally:
+            arguments_module.os.geteuid = saved_euid
+            PatchTarget.setup = saved_setup
+            PatchTarget.release = saved_release
+            arguments_module.sys_patch.PatchSysVolume = saved_patcher
+    finally:
+        subprocess.run = _real_run
+        target_module.subprocess.run = _real_run
+
+    print(f"\n{len(failures)} failure(s)")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
