diff --git a/opencore_legacy_patcher/sys_patch/kernelcache/kernel_collection/explicit.py b/opencore_legacy_patcher/sys_patch/kernelcache/kernel_collection/explicit.py
new file mode 100644
index 0000000000000000000000000000000000000000..c6f731b318c427c781dcfe2586c3bfb176051cd3
--- /dev/null
+++ b/opencore_legacy_patcher/sys_patch/kernelcache/kernel_collection/explicit.py
@@ -0,0 +1,101 @@
+"""
+explicit.py: Boot and System Kernel Collections for an Intel target, built from an Apple silicon host (ssd-tools derivative)
+
+'kmutil create --update-all' fails on an arm64 host for an x86_64 target (rc 71: "unable to create release extension
+manager" / "bless2_bootobjects_path() failed: 103"). Two explicit creates do work there, and with the target's own
+kmutil and the target mounted at the same path they give byte-identical collections in recoveryOS (2026-10-22, BootKC
+2465b382, SystemKC 57138f02, patchset/tools/arm64-kmutil):
+  kmutil create -n boot -a x86_64 --allow-missing-kdk -R <root> -k <root>/System/Library/Kernels/kernel -V release -B <boot>
+  kmutil create -n sys  <same> -S <system> --elide-identifier <each id in BootKernelExtensions.kc.elides>
+-B/-S are paths inside the volume root, but a -B that also exists on the host (ex. the default
+/System/Library/KernelCollections/BootKernelExtensions.kc) is read from the HOST in the sys step, so the arm64 host's
+BootKC is linked against ("names a dependency on 'com.apple.kpi.libkern', which was not found"). Both collections are
+therefore built in a scratch folder inside the volume root that the host does not have, as in the reference run
+(/kcout-E1), then moved into place. --update-all also copies the Boot collection into the target's Preboot
+(<group>/boot/System/Library/KernelCollections), so that is done here too.
+-R is the mount path exactly as the kernel reports it (system_mount): kmutil then stores kext paths relative to it, as
+--update-all does. The few entries kmutil stores with an absolute path carry that mount path: recoveryOS reports
+/System/Volumes/Data/private/var/tmp/oclp-target/<name> (the reference KCs), a full macOS host /private/var/tmp/...
+(the kernel names the folder that way whichever spelling is mounted on), so collections built from a full macOS host
+differ from the recoveryOS-built ones in those strings only (2026-10-23).
+"""
+
+import logging
+import shutil
+import subprocess
+import tempfile
+
+from pathlib import Path
+
+from ..base.cache import BaseKernelCache
+from ....support import subprocess_wrapper
+
+
+KC_DIR = "/System/Library/KernelCollections"
+BUILD_DIR = "/.oclp-kc-build"      # inside the target volume root; must not exist on the host
+
+
+class ExplicitBootSystemKernelCollections(BaseKernelCache):
+
+    def __init__(self, mount_location: str, target) -> None:
+        self.mount_location = mount_location
+        self.target = target
+
+
+    def _kmutil(self, work: str) -> str:
+        """
+        The target's own kmutil (its build's KMBuildVersion ends up in the collections), ad-hoc signed in a temporary
+        folder: an Apple binary on a non-booted volume is not in this host's trust cache
+        """
+        kmutil = f"{work}/kmutil"
+        shutil.copyfile(f"{self.mount_location}/usr/bin/kmutil", kmutil)
+        Path(kmutil).chmod(0o755)
+        subprocess_wrapper.run_as_root_and_verify(["/usr/bin/codesign", "-s", "-", "-f", kmutil], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        return kmutil
+
+
+    def _create(self, args: list) -> bool:
+        result = subprocess_wrapper.run_as_root(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        if result.returncode != 0:
+            subprocess_wrapper.log(result)
+            return False
+        return True
+
+
+    def rebuild(self) -> bool:
+        root = self.mount_location
+        logging.info("- Rebuilding Boot and System Kernel Collections (explicit creates, Apple silicon host)")
+        elides = Path(f"{root}{KC_DIR}/BootKernelExtensions.kc.elides").read_text().split()
+
+        if Path(BUILD_DIR).exists():
+            raise RuntimeError(f"{BUILD_DIR} exists on this host; kmutil would read it instead of the target's")
+        build = f"{root}{BUILD_DIR}"
+        subprocess_wrapper.run_as_root_and_verify(["/bin/rm", "-rf", build], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        subprocess_wrapper.run_as_root_and_verify(["/bin/mkdir", build], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        try:
+            with tempfile.TemporaryDirectory() as work:
+                kmutil = self._kmutil(work)
+                common = [kmutil, "create", "-a", "x86_64", "--allow-missing-kdk", "-R", root,
+                          "-k", f"{root}/System/Library/Kernels/kernel", "-V", "release",
+                          "-B", f"{BUILD_DIR}/BootKernelExtensions.kc"]
+                if self._create(common[:2] + ["-n", "boot"] + common[2:]) is False:
+                    return False
+                elide_args = [arg for identifier in elides for arg in ("--elide-identifier", identifier)]
+                if self._create(common[:2] + ["-n", "sys"] + common[2:] + ["-S", f"{BUILD_DIR}/SystemKernelExtensions.kc"] + elide_args) is False:
+                    return False
+            for name in ("BootKernelExtensions.kc", "SystemKernelExtensions.kc"):
+                subprocess_wrapper.run_as_root_and_verify(["/bin/mv", "-f", f"{build}/{name}", f"{root}{KC_DIR}/{name}"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+                subprocess_wrapper.run_as_root_and_verify(["/bin/chmod", "755", f"{root}{KC_DIR}/{name}"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)   # as --update-all leaves them
+        finally:
+            subprocess_wrapper.run_as_root(["/bin/rm", "-rf", build], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+
+        preboot_dir, mounted_by_us = self.target.preboot_kernel_collections()
+        try:
+            logging.info(f"- Copying the Boot Kernel Collection to the target Preboot ({preboot_dir})")
+            subprocess_wrapper.run_as_root_and_verify(["/bin/mkdir", "-p", preboot_dir], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+            subprocess_wrapper.run_as_root_and_verify(["/bin/cp", f"{root}{KC_DIR}/BootKernelExtensions.kc", f"{preboot_dir}/BootKernelExtensions.kc"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        finally:
+            if mounted_by_us:
+                subprocess_wrapper.run_as_root(["/usr/sbin/diskutil", "unmount", str(Path(preboot_dir).parents[4])], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+
+        return True
