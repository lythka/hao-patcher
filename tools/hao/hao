        grid.add_row('Mac', Text.from_ansi(' · '.join(x for x in (profile['model'], gpu, mem) if x) + '   ' + check))
    else:
        grid.add_row('For', Text.from_ansi(' · '.join(x for x in (profile['model'], gpu) if x) + '   ' + check))
        grid.add_row('Host', Text.from_ansi(host_line(c)))
    grid.add_row('Packs', ' · '.join(profile.get('packs', [])))
