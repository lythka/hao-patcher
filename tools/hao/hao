def hook_backends(a, c, build=BUILD, inst=INST):
    """The console's view of the backends, set from here so their modules stay as builder writes them: every
    command they run goes through c.run (its output to the log, steps on screen, src/progress.py); the pack of each
    recipe comes from resolve(); the step plan is listed before the question only with --dry-run or --show."""
    resolve, show_steps, prepare_kit = (getattr(build.resolve, 'original', build.resolve),
                                        getattr(build.show_steps, 'original', build.show_steps),
                                        getattr(inst.prepare_kit, 'original', inst.prepare_kit))

    def resolve_hook(a2, c2, command):
        c2.muted = c2.level != 'json'          # the header below replaces resolve's own (events are still kept)
        try:
            out = resolve(a2, c2, command)
        finally:
            c2.muted = False
        if getattr(c2, 'run', None) is not None:
            c2.run.groups, c2.run.asm = out[3], out[2]
        header(c2, command, out[0], out[2])
        return out

    def show_steps_hook(c2, command, groups):
        if getattr(a, 'dry_run', False) or c2.at('files') or command not in ('install', 'build-disk'):
            return show_steps(c2, command, groups)
        c2.event('plan', command=command, steps=list(build.STEPS[command]))

    def prepare_kit_hook(a2, c2, path, run=None):
        return prepare_kit(a2, c2, path, run=run or getattr(c2, 'run', None) or subprocess.call)
    stick = getattr(inst, 'STICK', None)
    write = getattr(getattr(stick, 'write', None), 'original', getattr(stick, 'write', None))

    def write_hook(*args, on_step=None, **kw):
        """The stick's parts, each on a live line while it is written (the kit takes minutes)."""
        parts = iter(STICK_PARTS)
        live = [c.task('  ' + next(parts))]

        def told(text):
            live[0].drop()
            (on_step or (lambda t: None))(text)
            live[0] = c.task('  ' + next(parts, 'finish'))
        try:
            out = write(*args, on_step=told, **kw)
        except BaseException:
            live[0].end(False)
            raise
        live[0].drop()
        return out
    choose = getattr(inst, 'choose', None)
    choose = getattr(choose, 'original', choose)

    def choose_hook(c2, key, question, choices, default=1):
        """A choice as a numbered table on a Rich terminal; the same answers, retries and stop as installer.choose."""
        if not c2.rich:
            return choose(c2, key, question, choices, default)
        from rich import box
        from rich.table import Table
        from rich.text import Text
        numbered = [(label, value) for label, value in choices if value is not None]
        c2.event('question', key=key, question=question, choices=[label for label, _ in choices])
        c2.close()
        t = Table(title=question, title_justify='left', title_style='bold', box=box.ROUNDED, show_header=False,
                  border_style=c2.style('dim'), padding=(0, 1))
        t.add_column(justify='right', style=c2.style('bar'), no_wrap=True)
        t.add_column()
        n = 0
        for label, value in choices:
            label = SAFE.text(label)             # disk and volume names come from the disks: shown as text
            if value is None:
                t.add_row('', Text(label, style=c2.style('dim')))
            else:
                n += 1
                t.add_row(str(n), Text(label, style='bold' if n == default else ''))
        c2.block(t)
        for _ in range(3):
            text = inst._answer(c2, 'Choice [%d]: ' % default if default else 'Choice: ')
            if not text and default:
                text = str(default)
            if text.isdigit() and 1 <= int(text) <= len(numbered):
                label, value = numbered[int(text) - 1]
                c2.event('answer', key=key, choice=int(text), label=label)
                return value
            c2.print('Type a number from 1 to %d.' % len(numbered), 'quiet')
        raise CON.Stopped('no choice made', untouched='nothing was downloaded or written',
                          options=['run it again and type one of the numbers shown'])
    hooks = [(resolve_hook, resolve), (show_steps_hook, show_steps), (prepare_kit_hook, prepare_kit)]
    if choose is not None:
        hooks.append((choose_hook, choose))
        inst.choose = choose_hook
    if write is not None:
        hooks.append((write_hook, write))
        stick.write = write_hook
    for fn, orig in hooks:
        fn.original = orig
    build.resolve, build.show_steps, inst.prepare_kit = resolve_hook, show_steps_hook, prepare_kit_hook


