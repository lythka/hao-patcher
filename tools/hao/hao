                                         c.paint('dim', 'macOS 27 %s' % asm.get('golden_build', ''))))
    c.block(Panel(grid, title=head, title_align='left', border_style=c.style('dim'), padding=(1, 2), expand=False))
    detection(c, profile)
    c.event('header', command=command, model=profile.get('model'), packs=profile.get('packs'))


