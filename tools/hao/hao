        short(profile.get('gpu_name'))
    check = ('proven model ' + c.ok) if proven else c.paint('warn', 'not proven on this model')
    grid = Table.grid(padding=(0, 3))
    grid.add_column(style=c.style('dim'), no_wrap=True)
    grid.add_column()
