def signed_release(a, c, path, required=True):
    """PATH (a release.json) checked against its PATH.sig (an SSH signature) and the release keys hao carries, before anything in
    it is read; returns the private verified copy every later step uses. Exit 4 when the signature is missing or
    does not match; --unsigned (a checkout only) skips the check and says so."""
    path = Path(path)
    if not path.exists() and not required:
        return None
    if getattr(a, 'unsigned', False):
        if not (REPO / '.git').exists():
            raise CON.Stopped('--unsigned is refused: this hao is a release, not a checkout',
                              why='a release is used only when the owner\'s signature on it holds', code=5)
        c.item('%s: signature not checked (--unsigned, a checkout)' % path, ok=False, ev='release.signature',
               checked=False)
        return path
    try:
        copy = SIGN.verified(path)                        # the same verified copy for every later reader
        _, kid, hashed = SIGN._VERIFIED[os.path.abspath(str(path))]
    except SIGN.SignatureError as x:
        raise CON.Stopped('%s is not signed by hao: %s' % (path, x),
                          why='hao reads a release only when the signature beside it (%s.sig) is the owner\'s'
                              % path.name,
                          untouched='nothing was downloaded or written',
                          options=['download the release again from its GitHub release page'], code=4)
    if SIGN.is_unsigned(kid):
        c.item('%s is an UNSIGNED release: %s; %s. Its files are checked by sha256 only' % (path.name, kid, hashed),
               'quiet', ok=False, ev='release.unsigned', reason=kid)
    c.item('%s signed (key %s, %s)' % (path.name, kid, hashed), 'files', ok=True, ev='release.signature',
           checked=True, key=kid, hash=hashed)
    return copy


def signed_create(a, c):
    """create-installer: the release beside hao (or --release) verified first; a --kit build may have none."""
    path = Path(a.release) if a.release else HERE / 'release.json'
    if os.path.lexists(path):
        a.release = str(signed_release(a, c, path))     # whenever a release will be read: unsigned stops (exit 4)
    elif a.plan or (not a.dry_run and not a.image and not getattr(a, 'folder', None) and not a.kit):
        raise INST.no_release(path)                     # create-installer's own refusal for these runs; nothing read
    else:
        # a run that may go on without a release (--dry-run, --image, --kit): create-installer is given a name that
        # cannot exist (a new empty private folder), so a release.json put beside hao after this check is never read
        import tempfile
        a.release = str(Path(tempfile.mkdtemp(prefix='hao-no-release-')) / 'release.json')
    return a


def stick_release(a, c):
    """The install step: the USB installer's release.json checked against its signature and against the sha256 the
    drive's stick.json recorded when it was written. A drive written from a checkout carries no release."""
    stick = os.environ.get('HAO_STICK')
    if not stick:
        return
    rel = Path(stick) / 'release.json'
    try:
        recorded = json.loads((Path(stick) / 'stick.json').read_text()).get('release_sha256')
    except (OSError, ValueError, AttributeError):
        recorded = None
    if not rel.exists():
        if recorded:
            raise CON.Stopped('the USB installer\'s release.json is gone (stick.json records one)',
                              why='the drive was changed after it was written', code=4,
                              options=['write the USB installer again: ./hao create-installer'])
        c.item('this USB installer was written from a checkout: no release to check', 'files')
        return
    copy = signed_release(a, c, rel)
    if recorded and copy != rel and hashlib.sha256(Path(copy).read_bytes()).hexdigest() != recorded:
        raise CON.Stopped('the USB installer\'s release.json is not the one it was written with',
                          why='the drive was changed after it was written', code=4,
                          options=['write the USB installer again: ./hao create-installer'])


def kit_args(q):
    q.add_argument('--kit', help='a staged kit folder (on the USB installer: /Volumes/HAO/kit)')
    q.add_argument('--work', help='build folder (default ~/Library/Caches/hao/builds/DATE)')
    q.add_argument('--local', help='the assembly\'s writable folder (default WORK/local), not on the erased disk')


def cmd_help(a):
    """`hao` alone, `hao help [--all]`: the commands for where it runs."""
    c = CON.Console('steps')
    v = REP.version()
    FD.listing(c, FD.where(), all_=getattr(a, 'all', False),
               versions={'hao': v.get('release') or dev_label(v.get('commit'))})
    return 0


def main():
