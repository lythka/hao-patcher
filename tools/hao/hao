    q.set_defaults(fn=guarded(lambda a, c: (stick_release(a, c), BUILD.install(a, c, MAC.SystemHost(), run=c.run))[1],
                              log='install'))
    q = sub.add_parser('run', help='an ARM program through the hao runtime, with its diagnostic switches')
    q.add_argument('-v', dest='verbose', action='count', default=0, help='diagnostics (-vv for more)')
    q.add_argument('--interp', action='store_true', help='the interpreter only')
