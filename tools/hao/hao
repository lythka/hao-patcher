    q.add_argument('program', help='the ARM program to run')
    q.add_argument('args', nargs=argparse.REMAINDER, help='its arguments')
    q.set_defaults(fn=guarded(lambda a, c: RUN.run(a, c)))
    q = sub.add_parser('aot', help='the runtime\'s ahead-of-time caches: build, --status, --background, --clear')
    g = q.add_mutually_exclusive_group()
    g.add_argument('--status', action='store_true', help='valid, missing and stale caches, and the hao.aot job')
    g.add_argument('--background', action='store_true', help='build detached, at background priority (sudo)')
    g.add_argument('--clear', action='store_true', help='remove the caches in /private/var/db/hao (sudo)')
    CON.add_level_flags(q)
    q.set_defaults(fn=guarded(lambda a, c: AOT.aot(a, c), log='aot'))
    q = sub.add_parser('verify-release', help='check a release yourself: the owner\'s signatures, every file, the '
                       'public tag; or a USB installer against its signed release')
    q.add_argument('target', nargs='?', help='vX.Y.Z (downloads its signed files), a folder of release files, or a '
                   'USB installer (e.g. /Volumes/HAO); default: the release beside hao, or this USB installer')
    q.add_argument('--cache', type=Path, default=CACHE, help='downloads to check as well (default %s)' % CACHE)
