def cmd_fetch(a, c):
    acquire = runpy.run_path(str(ACQUIRE / 'acquire'))
    if a.host_check:
        r = subprocess.run([sys.executable, '-I', str(ACQUIRE / 'host-check')] + (['--json'] if c.level == 'json'
                                                                                 else []))
        if r.returncode:
            return r.returncode
    a.release = signed_release(a, c, a.release)
    try:
        rows = acquire['load'](a.release, a.assets_from)
    except acquire['AcquireError'] as x:
        raise CON.Stopped(str(x), why='every file a release names must be pinned by URL, size and sha256')
    kinds = [r['kind'] for r in rows]
    c.banner('hao fetch  %d files pinned by %s (%d downloads, %d assets)' % (
        len(rows), a.release, kinds.count('download'), kinds.count('asset')), release=a.release, cache=str(a.cache))
    if a.verify:
        bad = [r['name'] for r in rows if not r.get('stream') and not acquire['intact'](a.cache, r)]
        for r in rows:
            c.item('%-8s %-44s %s' % (r['kind'], r['name'], 'missing or damaged' if r['name'] in bad else 'sha256'),
                   ok=r['name'] not in bad, ev='file.verify', name=r['name'], kind=r['kind'],
                   intact=r['name'] not in bad)
        if bad:
            raise CON.Stopped('%d of %d files are missing or damaged' % (len(bad), len(rows)),
                              options=['hao fetch %s' % a.release])
        c.done('all %d files present and intact' % len(rows))
        return 0

    def on(ev):
        k = ev['ev']
        if k == 'progress':
            return
        c.event('fetch.' + k, **{x: y for x, y in ev.items() if x != 'ev'})
        if k in ('ok', 'reused'):
            c.item('%-44s %s' % (ev['name'], 'reused' if k == 'reused' else 'sha256'), ok=True)
        elif k == 'streamed':
            c.item('%-44s %s' % (ev['name'], 'read by range when the rows are made'), ok=True)
        elif k == 'mirror-failed':
            c.item('%-44s %s: %s' % (ev['name'], ev['url'], ev['error']), 'files')
    try:
        acquire['fetch'](rows, a.cache, on_event=on)
    except acquire['AcquireError'] as x:
        raise CON.Stopped(str(x), why='a file that is not the pinned one is never used', untouched='nothing kept')
    c.done('%d files present and checked in %s' % (len(rows), a.cache))
    return 0


def cmd_verify(a, c):
    root = Path(a.root)
    found = VERIFY.manifests(a.manifests, root)
    c.banner('hao verify  %s against %d pack manifests' % (root, len(found)), root=str(root))

    def on(row):
        c.event('file.verify', **row)
        if 'problem' in row:
            c.item('%-10s %-22s %s%s' % (row['problem'], row['pack'], row['path'],
                                          '  (%s)' % ', '.join(row['keys']) if row.get('keys') else ''), 'steps')
        elif row.get('changed'):
            c.item('%-10s %-22s %s  (changed as expected: %s)' % ('seed', row['pack'], row['path'],
                                                                  SAFE.text(row.get('reason'))), 'steps', ok=True)
        else:
            c.item('%-10s %-22s %s' % ('ok', row['pack'], row['path']), 'files')
    r = VERIFY.verify(root, found, on_file=on)
    for pack, n in r['packs'].items():
        c.print('  %-22s %d files' % (pack, n), 'files')
    if r['problems']:
        raise CON.Stopped('%d of %d files differ from their manifests' % (len(r['problems']),
                                                                          len(r['problems']) + r['ok']),
                          why='these files are not the ones the packs installed',
                          options=['see which: hao verify --show', 'put them back: hao patch OVERLAY... (or the '
                                   'installer for installer-phase packs)'], code=4)
    seeds = len(r.get('changed', []))
    c.done('%d files match their manifests%s' % (r['ok'], ' (%d seed%s changed as expected)' % (
        seeds, '' if seeds == 1 else 's') if seeds else ''), seeds_changed=seeds)
    return 0


def cmd_verify_release(a, c, opener=None):
    """hao verify-release [vX.Y.Z | PATH]: PASS, FAIL or SKIP per check (src/releasecheck.py); exit 4 on any FAIL."""
    if getattr(a, 'keys', None) and not (REPO / '.git').exists():
        raise CON.Stopped('--keys is refused: this hao is a release, not a checkout',
                          why='a release is verified against the owner\'s keys, which come with hao', code=5)
    try:
        keys = SIGN.load_keys(getattr(a, 'keys', None))
    except SIGN.SignatureError as x:
        if getattr(a, 'keys', None):
            raise CON.Stopped(str(x), why='a release is verified against the owner\'s keys', code=4)
        # v0.0.1 ships unsigned and without keys: an owner-waived release still checks out by its checksums; any
        # signature then fails as untrusted
        keys = {}
        c.item('this hao carries no release keys: only an owner-waived unsigned release can pass', 'quiet', ok=False,
               ev='release.keys', keys=None)
    target, stick = a.target, os.environ.get('HAO_STICK')
    here = None
    if target is None and stick:
        kind, where = 'drive', Path(stick)
    elif target is None and FD.where() == 'installer':
        kind, where = 'drive', REPO.parent                # hao run from the USB installer (/Volumes/HAO/hao)
    elif target is None:
        kind, where, here = 'folder', HERE, RC.checkout_commit()
    elif RC.TAG.match(target):
        if a.offline:
            raise CON.Stopped('verify-release %s downloads the release\'s signed files; --offline forbids it' % target,
                              options=['hao verify-release FOLDER (a folder with the files you downloaded)'], code=5)
        try:
            where = RC.download(target, opener or RC.opener_default, beside=HERE, keys=keys)
        except (OSError, ValueError) as x:
            raise CON.Stopped('the signed files of %s could not be downloaded: %s' % (target, SAFE.text(str(x))),
                              why='GitHub is not reachable from here', code=1,
                              options=['hao verify-release FOLDER (a folder with the files you downloaded)'])
        kind, here = 'folder', RC.checkout_commit()
    else:
        p = Path(target).expanduser()
        p = p if p.is_dir() else p.parent
        kind = 'drive' if os.path.lexists(p / 'stick.json') or os.path.lexists(p / 'manifest.json') else 'folder'
        where = p
    c.banner('hao verify-release  %s  (%s)' % (target or where, 'USB installer' if kind == 'drive' else 'release files'),
             target=str(target or where), kind=kind)
    if getattr(a, 'keys', None):
        c.item('keys from %s (--keys, a checkout): not the owner\'s unless that file is theirs' % a.keys, ok=False,
               ev='release.keys', keys=str(a.keys))
    if kind == 'drive':
        import stick as STICK
        checks = RC.check_drive(where, keys, STICK)
    else:
        tag = target if target and RC.TAG.match(target) else None
        checks = RC.check_folder(where, keys, cache=a.cache, tag=tag, opener=opener or RC.opener_default,
                                 offline=a.offline, here=here)
        if tag:
            checks += RC.tag_extra(where, keys, tag)
    for k in checks:
        c.item('%-4s  %-9s  %s' % (k['state'], k['name'], SAFE.text(k['detail'])), 'quiet',
               ok={'PASS': True, 'FAIL': False}.get(k['state']), ev='release.check', **{
                   x: y for x, y in k.items() if x in ('name', 'state', 'file')})
    if any(str(k.get('key', '')).startswith(SIGN.UNSIGNED) for k in checks):
        c.item('UNSIGNED release (owner waiver): nothing proves who made it; the checksums prove it is unchanged',
               'quiet', ok=False, ev='release.unsigned')
    candidate = any(SIGN.is_candidate(k.get('key')) for k in checks)
    if candidate:
        c.item('CANDIDATE, not a release: signed with the candidate key, for testing only', 'quiet', ok=False,
               ev='release.candidate')
    n = RC.summary(checks)
    if n['FAIL']:
        raise CON.Stopped('%d of %d checks failed: this is not the release that was published, or it was changed'
                          % (n['FAIL'], len(checks)), why='a signature, a file or the tag does not match',
                          untouched='nothing was changed', options=[
                              'download the release again from its GitHub release page',
                              'report it: hao report'], code=4)
    c.done('%s%d checks passed%s' % ('CANDIDATE, not a release: ' if candidate else '', n['PASS'],
                                     ', %d not made (SKIP: see why above)' % n['SKIP'] if n['SKIP'] else ''),
           passed=n['PASS'], skipped=n['SKIP'], candidate=candidate)
    return 0


