#!/usr/bin/env python3
"""hao: user commands of the hao builder (workflow plan step 9a and on).

  hao patch OVERLAY... --root ROOT [--state DIR] [--installer] [--dry-run] [--quiet | --show | --log json]
        apply pack overlays to ROOT: only files whose sha256 differs are written, each checked before and
        after; replaced files are backed up and new ones recorded, so --revert undoes both. Without
        --installer, packs whose phase is "installer" (and kernel collection members, dyld cache images, the
        cryptex, the booter and EFI files of any pack) are not applied and are listed as needing Recovery.
  hao patch --revert --root ROOT [--state DIR] [--id ID]      undo the newest (or the named) patch
  hao patch --list [--root ROOT | --live] [--state DIR]       applied and reverted patches
  hao patch --probe [--log json]                              read-only: the running Mac's System and Data
        volumes, snapshots, SIP, mounts, and which steps of a live patch would work
  hao patch OVERLAY... --live [--dry-run] --i-have-a-backup [--bless mount|oclp] [--mount-point DIR]
  hao patch --revert --live --i-have-a-backup
        the running Mac's own System volume (sudo): written directly, booted as a new snapshot after a reboot,
        reverted by booting the snapshot that ran before. Not proven yet (step 9a laptop run): it refuses to
        write without --i-have-a-backup; --dry-run and --probe only read.
  hao explain [NAME | PATH]                                   what a declared file comes from and every edit
  hao inspect STORE PATH                                      original and patched files side by side

  hao detect [--out FILE]                                     this Mac's hardware, OCLP patch sets and packs, as a
        profile file for --profile (run it on the target: its Recovery or an installed macOS; read-only)
  hao fetch RELEASE.json [--cache DIR] [--verify] [--host-check]  download (or check) every file the release pins
  hao verify [ROOT] [--manifests DIR|FILE]...                 every installed pack file against its manifest
  hao build-image REPO (--model M | --profile F) [--assembly NAME] [--overlay-system ROOT] [--dry-run]
        assemble an image in the builder VM (pipeline/golden-run), committed to the image repository REPO
  hao build-disk /dev/diskN (--model M | --profile F) [--dry-run] [--confirm diskN]   (sudo; external SSD)
  hao create-installer /dev/diskN (--model M | --profile F) [--dry-run] [--confirm ERASE]  (sudo; USB stick)
  hao install /dev/diskN [--profile F] [--dry-run] [--confirm ERASE]  (on the target, from the stick's Recovery)
        build-disk, create-installer and install check the disk and show their plan; their disk steps wait for
        the relocatable kit (workflow plan step 16) and stop, before writing, until it exists.

Detail levels for every command: --quiet, default, --show (files), --show-edits (edits), --log json.

--state defaults to ROOT/private/var/db/hao, and with --live to /private/var/db/hao. Deferred steps come from
--deferred FILE, else from deferred.json beside the overlays (the materialiser's output folder), when there is one.
"""
import argparse
import json
from pathlib import Path
import runpy
import subprocess
import sys

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
sys.path.insert(0, str(HERE / 'src'))
import livepatch as LP   # noqa: E402
import macos as MAC      # noqa: E402
import console as CON    # noqa: E402
import detect as DETECT  # noqa: E402
import verify as VERIFY  # noqa: E402
import builder as BUILD  # noqa: E402

ACQUIRE = REPO / 'tools' / 'acquire'
CACHE = Path.home() / 'Library' / 'Caches' / 'hao'


def _snap(s):
    return s if isinstance(s, str) or s is None else s.get('name')


def printer(level):
    def emit(ev):
        k = ev['ev']
        if level == 'json':
            print(json.dumps(ev), flush=True)
            return
        if k == 'warning':
            print('warning: %s' % ev['text'], file=sys.stderr, flush=True)
            return
        if level == 'quiet' and k not in ('done', 'reverted'):
            return
        if k == 'plan':
            print('%d to write, %d to set attributes on, %d already current' % (ev['write'], ev.get('attrs', 0),
                                                                                ev['same']))
            if ev.get('folders'):
                print('%d folders to create' % ev['folders'])
            if ev['needs_recovery']:
                print('needs Recovery (installer-only packs, not applied live): %s' % ', '.join(ev['needs_recovery']))
            for f in ev.get('needs_recovery_files', []):
                print('  %-6s %-22s %s  (%s)' % ('later', f['pack'], f['path'], f['reason']))
        elif k == 'live':
            print('live: System %s, Data %s, booted %s (sealed: %s)' % (ev['system'], ev['data'], ev['booted'],
                                                                         ev['sealed']))
        elif k == 'mount':
            print('mounted %s read-write at %s' % (ev['device'], ev['point']))
        elif k == 'snapshot':
            print({'pre': 'named snapshot %s taken before writing', 'boot': 'next boot: new snapshot %s',
                   'root-to': 'next boot: snapshot %s'}[ev['kind']] % ev['name'])
        elif k == 'file.write':
            print('  %-6s %-22s %s' % ('new' if ev['new'] else 'write', ev['pack'], ev['path']))
            if level == 'show':
                print('         %s -> %s' % ((ev['old_sha256'] or 'none')[:16], ev['sha256'][:16]))
        elif k == 'file.attrs':
            print('  %-6s %-22s %s  (%s)' % ('attrs', ev['pack'], ev['path'], ', '.join(ev['keys'])))
        elif k == 'file.revert':
            print('  %-6s %s' % ('remove' if ev['removed'] else 'attrs' if ev.get('attrs_only') else 'restore',
                                 ev['path']))
        elif k == 'rolled-back':
            print('rolled back %s: %d files put back (%s)' % (ev['id'], ev['files'], ev['error']))
        elif k == 'restart':
            who = 'pid %s %s' % (ev['pid'], ev['command']) if ev['kind'] == 'process' else \
                  'launchd %s/%s' % (ev['domain'], ev['label'])
            print('  %-7s %s uses %s' % ('reboot' if ev['when'] == 'reboot' else 'restart', who, ev['path']))
        elif k == 'deferred':
            if level == 'show' or ev['status'] != 'needs-recovery' or ev['stale']:
                print('  %-14s %s  (%s)%s' % (ev['status'], ev['path'], ev['reason'],
                                              ' stale: made from the installed files' if ev['stale'] else ''))
        elif k == 'done':
            if ev['id'] is None:
                print('nothing to do: %d files already current' % ev['same'])
                return
            print('applied %s: %d written, %d attributes set, %d unchanged%s' % (
                ev['id'], ev['written'], ev.get('attrs', 0), ev['same'],
                ', snapshot ' + _snap(ev['snapshot']) if _snap(ev['snapshot']) else ''))
            if ev.get('not_set'):
                print('not root: owners and system flags of %d files were not set (see the record)' % ev['not_set'])
            if ev.get('reboot'):
                print('reboot to run it; undo: sudo hao patch --revert --live --i-have-a-backup')
            else:
                print('undo: hao patch --revert --root ROOT --id %s' % ev['id'])
        elif k == 'reverted':
            print('reverted %s: %d files%s' % (ev['id'], ev['files'],
                                               '; reboot to run snapshot %s' % ev['snapshot'] if ev.get('reboot') else ''))
    return emit


def print_probe(r, level):
    if level == 'json':
        print(json.dumps(r, indent=1, default=str))
        return
    f = r['facts']
    print('machine %s, euid %d, csr %s, authenticated root %s, boot %s' % (
        r['machine'], r['euid'], 'unknown' if r['csr'] is None else '0x%x' % r['csr'], r['authenticated_root'],
        r['boot']))
    print('booted: %s (%s) from %s, sealed: %s' % (f['booted'].get('name'), f['booted'].get('uuid'),
                                                   f.get('root_device'), f.get('sealed')))
    if f.get('system'):
        print('System volume: %s "%s"; Data volume: %s at %s' % (f['system']['device'], f['system']['name'],
                                                               (f.get('data') or {}).get('device'),
                                                               (f.get('data') or {}).get('mount')))
    for m in f.get('system_mounts', []):
        print('System volume mounted at %s (%s)' % (m['point'], ', '.join(m['options'])))
    print('snapshots of the System volume:')
    for s in f.get('snapshots', []):
        print('  %s %-60s xid %s%s' % ('*' if s.get('booted') else ' ', s['name'], s['xid'],
                                       ', RootTo' if s.get('root_to') else ''))
    for rec in r['records']:
        print('hao %s %s, snapshot %s (booted before: %s)' % (rec['id'], rec['state'], rec['snapshot'],
                                                            rec['booted_before']))
    for s in r['steps']:
        print('%-4s %s: %s' % ('ok' if s['ok'] else 'NO', s['step'], s['why']))
    print('live patch would %s' % ('run' if r['ok'] else 'be refused'))


def deferred_entries(a):
    path = Path(a.deferred) if a.deferred else None
    if path is None and a.overlays:
        parents = {Path(o).resolve().parent for o in a.overlays}
        if len(parents) == 1 and (parents.pop() / 'deferred.json').is_file():
            path = Path(a.overlays[0]).resolve().parent / 'deferred.json'
    return json.loads(path.read_text()) if path else []


def cmd_patch(a):
    level = 'json' if a.log == 'json' else 'quiet' if a.quiet else 'show' if a.show else 'steps'
    try:
        if a.probe:
            r = MAC.probe(MAC.SystemHost(), a.state or MAC.STATE, a.mount_point)
            print_probe(r, level)
            return 0 if r['ok'] else 3
        if a.live and a.root:
            print('hao: --live patches the running system; --root is for a folder', file=sys.stderr)
            return 2
        root = Path('/') if a.live else Path(a.root) if a.root else None
        state = Path(a.state) if a.state else Path(MAC.STATE) if a.live else (root / 'private/var/db/hao' if root
                                                                                else None)
        if a.list:
            for r in LP.records(state):
                print('%-22s %-11s %3d files  packs %s%s' % (r['id'], r['state'], len(r['files']), ', '.join(r['packs']),
                                                            '  snapshot ' + r['snapshot'] if r.get('snapshot') else ''))
            return 0
        if root is None:
            print('hao: --root (a folder) or --live (this Mac) is required', file=sys.stderr)
            return 2
        backend = MAC.MacOSLiveBackend(acknowledged=a.i_have_a_backup, mount_point=a.mount_point,
                                       bless=a.bless) if a.live else None
        if a.revert:
            LP.revert(root, state, patch_id=a.id, backend=backend, on_event=printer(level))
            return 0
        if not a.overlays:
            print('hao: no overlays given', file=sys.stderr)
            return 2
        overlays = [LP.load_overlay(o) for o in a.overlays]
        deferred = deferred_entries(a)
        mode = 'installer' if a.installer else 'live'
        if a.dry_run:
            emit = printer(level)
            if backend:
                for problem in backend.inspect():
                    emit({'ev': 'warning', 'text': 'a live patch would be refused: ' + problem})
                p = LP.plan(overlays, root, mode, backend.attributes(root), resolve=backend.booted_path,
                            classify=backend.classifier(root))
            else:
                p = LP.plan(overlays, root, mode, classify=LP.Classifier(root) if mode == 'live' else None)
            emit(LP.plan_event(p))
            for row in p['write']:
                print('  %-6s %-22s %s' % ('new' if row['old_sha256'] is None else 'write', row['pack'], row['path']))
            for row in p['attrs']:
                print('  %-6s %-22s %s  (%s)' % ('attrs', row['pack'], row['path'], ', '.join(row['attrs'])))
            classify = backend.classifier(root) if backend else LP.Classifier(root)
            for ev in LP.deferred_report(deferred, {m['pack']: m['phase'] for m in overlays}, classify,
                                         bool(p['write'])):
                emit(ev)
            return 0
        LP.apply(overlays, root, state, mode=mode, backend=backend, on_event=printer(level), deferred=deferred)
        return 0
    except LP.PatchError as x:
        print('hao patch: %s' % x, file=sys.stderr)
        return 1


def guarded(fn):
    """Run FN(a, console); a Stopped check prints its report and exits 1."""
    def run(a):
        c = CON.Console(CON.level_of(a))
        try:
            return fn(a, c)
        except CON.Stopped as x:
            c.stopped(x)
            return 1
        except (LP.PatchError, DETECT.DetectError) as x:
            c.stopped(CON.Stopped(str(x)))
            return 1
    return run


def cmd_detect(a, c, host=None):
    p = DETECT.profile(DETECT.facts(host or MAC.SystemHost()))
    p['target'] = DETECT.target_for_model(p['model'])[0]
    DETECT.show(c, p)
    if a.out:
        Path(a.out).write_text(json.dumps(p, indent=1) + '\n')
        c.done('profile written to %s' % a.out, profile=a.out)
    elif c.level != 'json':
        print(json.dumps(p, indent=1))
    return 0


def cmd_fetch(a, c):
    acquire = runpy.run_path(str(ACQUIRE / 'acquire'))
    if a.host_check:
        r = subprocess.run([sys.executable, '-I', str(ACQUIRE / 'host-check')] + (['--json'] if c.level == 'json'
                                                                                 else []))
        if r.returncode:
            return r.returncode
    try:
        rows = acquire['load'](a.release)
    except acquire['AcquireError'] as x:
        raise CON.Stopped(str(x))
    c.banner('hao fetch  %d files pinned by %s' % (len(rows), a.release), release=a.release, cache=str(a.cache))
    if a.verify:
        bad = [r['name'] for r in rows if not acquire['intact'](a.cache, r)]
        for r in rows:
            c.item('%-44s %s' % (r['name'], 'missing or damaged' if r['name'] in bad else 'sha256'),
                   ok=r['name'] not in bad, ev='file.verify', name=r['name'], intact=r['name'] not in bad)
        if bad:
            raise CON.Stopped('%d of %d files are missing or damaged' % (len(bad), len(rows)),
                              options=['hao fetch %s' % a.release])
        c.done('all %d files present and intact' % len(rows))
        return 0

    def on(ev):
        k = ev['ev']
        if k == 'progress':
            return
        c.event('fetch.' + k, **{x: y for x, y in ev.items() if x != 'ev'})
        if k in ('ok', 'reused'):
            c.item('%-44s %s' % (ev['name'], 'reused' if k == 'reused' else 'sha256'), ok=True)
        elif k == 'mirror-failed':
            c.item('%-44s %s: %s' % (ev['name'], ev['url'], ev['error']), 'files')
    try:
        acquire['fetch'](rows, a.cache, on_event=on)
    except acquire['AcquireError'] as x:
        raise CON.Stopped(str(x), why='a file that is not the pinned one is never used', untouched='nothing kept')
    c.done('%d files present and checked in %s' % (len(rows), a.cache))
    return 0


def cmd_verify(a, c):
    root = Path(a.root)
    found = VERIFY.manifests(a.manifests, root)
    c.banner('hao verify  %s against %d pack manifests' % (root, len(found)), root=str(root))

    def on(row):
        c.event('file.verify', **row)
        if 'problem' in row:
            c.item('%-10s %-22s %s%s' % (row['problem'], row['pack'], row['path'],
                                          '  (%s)' % ', '.join(row['keys']) if row.get('keys') else ''), 'steps')
        else:
            c.item('%-10s %-22s %s' % ('ok', row['pack'], row['path']), 'files')
    r = VERIFY.verify(root, found, on_file=on)
    for pack, n in r['packs'].items():
        c.print('  %-22s %d files' % (pack, n), 'files')
    if r['problems']:
        raise CON.Stopped('%d of %d files differ from their manifests' % (len(r['problems']),
                                                                          len(r['problems']) + r['ok']),
                          why='these files are not the ones the packs installed',
                          options=['see which: hao verify --show', 'put them back: hao patch OVERLAY... (or the '
                                   'installer for installer-phase packs)'])
    c.done('%d files match their manifests' % r['ok'])
    return 0


def builder_args(q, disk=True):
    if disk:
        q.add_argument('disk', nargs='?')
        q.add_argument('--confirm', help='the typed confirmation, given ahead (scripts)')
    g = q.add_mutually_exclusive_group()
    g.add_argument('--model'); g.add_argument('--profile')
    q.add_argument('--assembly'); q.add_argument('--dry-run', action='store_true')
    CON.add_level_flags(q)


def main():
    p = argparse.ArgumentParser(prog='hao', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='action', required=True)
    q = sub.add_parser('patch')
    q.add_argument('overlays', nargs='*')
    q.add_argument('--root'); q.add_argument('--state'); q.add_argument('--id'); q.add_argument('--deferred')
    q.add_argument('--installer', action='store_true'); q.add_argument('--dry-run', action='store_true')
    q.add_argument('--revert', action='store_true'); q.add_argument('--list', action='store_true')
    q.add_argument('--live', action='store_true', help='the running Mac (sudo)')
    q.add_argument('--i-have-a-backup', action='store_true', help='run the live backend before step 9a proves it')
    q.add_argument('--probe', action='store_true', help='read-only report of the running Mac')
    q.add_argument('--bless', choices=sorted(MAC.BLESS_FORMS), default='oclp')
    q.add_argument('--mount-point', default=MAC.MOUNT_POINT)
    g = q.add_mutually_exclusive_group()
    g.add_argument('--quiet', action='store_true'); g.add_argument('--show', action='store_true')
    g.add_argument('--log', choices=['json'])
    q.set_defaults(fn=cmd_patch)
    q = sub.add_parser('explain'); q.add_argument('what', nargs='?')
    q.set_defaults(fn=lambda a: subprocess.call([sys.executable, '-I', str(REPO / 'pipeline/patches.py'), 'explain']
                                                + ([a.what] if a.what else [])))
    q = sub.add_parser('inspect'); q.add_argument('store'); q.add_argument('path')
    q.set_defaults(fn=lambda a: subprocess.call([sys.executable, '-I', str(REPO / 'tools/edit-engine/edit-engine'),
                                                 'inspect', a.store, a.path]))
    q = sub.add_parser('detect'); q.add_argument('--out'); CON.add_level_flags(q)
    q.set_defaults(fn=guarded(cmd_detect))
    q = sub.add_parser('fetch'); q.add_argument('release'); q.add_argument('--cache', type=Path, default=CACHE)
    q.add_argument('--verify', action='store_true'); q.add_argument('--host-check', action='store_true')
    CON.add_level_flags(q); q.set_defaults(fn=guarded(cmd_fetch))
    q = sub.add_parser('verify'); q.add_argument('root', nargs='?', default='/')
    q.add_argument('--manifests', action='append', default=[]); CON.add_level_flags(q)
    q.set_defaults(fn=guarded(cmd_verify))
    q = sub.add_parser('build-image'); q.add_argument('out', metavar='REPO'); builder_args(q, disk=False)
    q.add_argument('--overlay-system'); q.add_argument('--overlay-store')
    q.set_defaults(fn=guarded(lambda a, c: BUILD.build_image(a, c)))
    q = sub.add_parser('build-disk'); builder_args(q)
    q.set_defaults(fn=guarded(lambda a, c: BUILD.build_disk(a, c, MAC.SystemHost())))
    q = sub.add_parser('create-installer'); builder_args(q)
    q.add_argument('--minimum-bytes', type=int, default=32 * 10 ** 9)
    q.set_defaults(fn=guarded(lambda a, c: BUILD.create_installer(a, c, MAC.SystemHost())))
    q = sub.add_parser('install'); builder_args(q)
    q.set_defaults(fn=guarded(lambda a, c: BUILD.install(a, c, MAC.SystemHost())))
    a = p.parse_args()
    return a.fn(a)


if __name__ == '__main__':
    sys.exit(main())
