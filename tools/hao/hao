            mem = ('%d GB' % profile['memory_gb'] if profile['memory_gb'] else '') if 'memory_gb' in profile else \
                '%d GB' % round(os.sysconf('SC_PHYS_PAGES') * os.sysconf('SC_PAGE_SIZE') / 2.0 ** 30)
        except (ValueError, OSError):
