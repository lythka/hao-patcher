def detection(c, profile, packs_dir=REPO / 'packs'):
    """--show-edits: the mockups' detection table, one row per pack: what on this Mac chose it (a device and the OCLP
    patch set it gets, the board id, or any Intel Mac) -> the pack."""
    if not c.at('edits'):
        return
    have = profile.get('oclp_patchsets') or []
    gpu = profile.get('gpu_name') or ', '.join(d.get('name', '') for d in profile.get('gpu', []))
    names = {'audio': ', '.join(d.get('name', '') for d in profile.get('audio', [])) or 'HDA codec',
             'wifi': ', '.join(d.get('name', '') for d in profile.get('wifi', [])) or 'Wi-Fi card'}
    rows = []
    for pack in profile.get('packs', []):
        try:
            rule = json.loads((Path(packs_dir) / (pack + '.json')).read_text()).get('detect', {})
        except (OSError, ValueError):
            continue
        sets = [x for x in rule.get('oclp_patchsets', []) if x in have]
        if sets:
            role = 'Audio' if 'Audio' in sets[0] else 'Wi-Fi' if 'Wireless' in sets[0] else 'GPU'
            device = names['audio'] if role == 'Audio' else names['wifi'] if role == 'Wi-Fi' else gpu
            rows.append((role, device, sets[0], pack))
        elif rule.get('board_ids'):
            rows.append(('Board', profile.get('board_id') or '', profile.get('model', ''), pack))
        elif rule.get('any_intel'):
            rows.append(('CPU', 'Intel', 'any Intel', pack))
    if not rows:
        return
    plain = ['', c.paint('bold', 'Detect hardware') + '  ' + c.paint('dim', 'OCLP-style: device → patch set → pack')]
    plain += ['  %-8s%-30s%-28s→ %s' % (role, device.replace('Graphics ', '').split(' (')[0][:28], '→ ' + via,
                                       c.paint('bold', pack)) for role, device, via, pack in rows]

    def table():
        from rich import box
        from rich.table import Table
        t = Table(title='Detect hardware', title_justify='left', title_style='bold', box=box.SIMPLE_HEAD,
                  show_edge=False, header_style=c.style('dim'), padding=(0, 2))
        for name in ('', 'device', 'OCLP patch set', 'pack'):
            t.add_column(name, no_wrap=True)
        for role, device, via, pack in rows:
            t.add_row(role, device.replace('Graphics ', '').split(' (')[0][:28], via, pack, style=None)
        return t
    c.block(table, plain, 'edits')


def host_line(c):
    """macOS 26.7 · Apple silicon · Xcode 26.1 ✓ · 1,369 GB free ✓ (the mockups' host line)."""
    import platform
    import shutil
    mac = platform.mac_ver()[0]
    arch = 'Apple silicon' if platform.machine() == 'arm64' else 'Intel'
    try:
        free = '%s GB free %s' % (format(shutil.disk_usage(str(CACHE.parent if CACHE.parent.exists() else Path.home()))
                                         .free // 10 ** 9, ','), c.ok)
    except OSError:
        free = ''
    xcode = ''
    try:
        r = subprocess.run(['xcodebuild', '-version'], capture_output=True, text=True, timeout=20)
        if r.returncode == 0 and r.stdout.startswith('Xcode'):
            xcode = '%s %s' % (r.stdout.split('\n')[0], c.ok)
    except (OSError, subprocess.SubprocessError):
        pass
    xcode = xcode or c.paint('warn', 'no Xcode (needed for the Metal libraries)')
    return ' · '.join(x for x in ('macOS ' + mac if mac else '', arch, xcode, free) if x)


def finish_line(c, command):
    """Replace the backends' last line with the mockups' ("Installed ... in 41m 18s · ...", "Done in ...")."""
    done = c.done

    def wrapped(text, more=(), **fields):
        took = CON.elapsed(c.clock() - c.started)
        log = getattr(getattr(c, 'run', None), 'log', None)
        more = list(more) + (['Log: %s' % log] if log else [])
        low = text.lower()
        installed = command in ('install', 'build-disk') and ('installed on ' in low or low.startswith('installed macos 27 on '))
        if installed and c.level == 'quiet':
            return done('Installed in %s. Details are in the log%s.' % (took, ': %s' % log if log else ''), **fields)
        if installed:
            disk = text.split(' on ', 1)[1].split(';')[0]
            s = getattr(c.run, 'summary', {}) if getattr(c, 'run', None) else {}
            parts = ['macOS 27 on %s in %s' % (disk, took)]
            if s.get('files'):
                parts.append('%s files from packs' % format(s['files'], ','))
            if s.get('edits'):
                parts.append('%s edits' % format(s['edits'], ','))
            if s.get('repairs'):
                parts.append('%d kernel repairs' % s['repairs'])
            parts.append('no notes' if not s.get('notes') else '%d notes' % s['notes'])
            rows = [('Time', took), ('Disk', disk)]
            rows += [('Files from packs', format(s['files'], ','))] if s.get('files') else []
            rows += [('Edits', format(s['edits'], ','))] if s.get('edits') else []
            rows += [('Kernel repairs', str(s['repairs']))] if s.get('repairs') else []
            rows += [('Log', str(log))] if log else []
            restart = 'restart to use it' in text
            card = dict(title=c.paint('ok', '✓ ') + c.paint('bold', 'macOS 27 is installed'), rows=rows,
                        next=['Restart the Mac to start macOS 27. Setup Assistant opens first.'] if restart else [])
            return done(' · '.join(parts), lead=c.paint('ok', 'Installed'),
                        more=more + (['Restart to use it.'] if restart else []), card=card, **fields)
        if command == 'create-installer' and not text.startswith('dry run'):
            text = text.replace('USB stick', 'USB installer').replace('stick image', 'USB installer image')
            head, _, rest = text.partition('. ')
            card = dict(title=c.paint('ok', '✓ ') + c.paint('bold', head[:1].upper() + head[1:]),
                        rows=[('Time', took)] + ([('Log', str(log))] if log else []),
                        next=[rest] if rest else [])
            return done('in %s. %s' % (took, text[:1].upper() + text[1:]), lead=c.paint('ok', 'Done'), more=more,
                        card=card, **fields)
        return done(text, **fields)
    c.done = wrapped


