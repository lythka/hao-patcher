    r.add_argument('--no-hash', action='store_true', help='skip the stick sha256')
    l = sub.add_parser('laptop', help='the same checks on a real laptop from its NetBoot Recovery, hands-free')
    l.add_argument('--laptop', default='auto', help='a laptop name as the laptop shell knows it (its LAPTOP_NAME), or auto')
    l.add_argument('--candidates', default='laptop2', help='with --laptop auto: the laptops to try, in order (owner 2026-11-17: laptop 2 is the batch bench; laptop 1 the live-fix bench)')
    l.add_argument('--stick', help='the USB installer image (create-installer --image); or --kit-url')
    l.add_argument('--kit-url', help='a network kit (one tar stream of the HAO folder, builder): erased onto the USB SSD as HAO-NET, no stick')
    l.add_argument('--kit-artifact', help='with --kit-url: the candidate cut folder for arm-gate')
    l.add_argument('--kit-min-bytes', type=int, default=40_000_000_000, help='with --kit-url: the USB SSD must be at least this large')
    l.add_argument('--stick-sha256', help='its expected sha256 (else hashed here)')
    l.add_argument('--usb-disk', help='the USB drive on the laptop (diskN), when it has more than one')
    l.add_argument('--hao', type=Path, help='the released hao command (for the docs check on this host)')
    l.add_argument('--out', required=True)
    l.add_argument('--source', help='the commit or release id under test (recorded)')
    l.add_argument('--break-setid', metavar='PATH')
    l.add_argument('--install-timeout', type=int, default=3 * 3600)
    l.add_argument('--boot-timeout', type=int, default=75 * 60)
    l.add_argument('--no-hash', action='store_true', help='with --stick-sha256: do not hash the file here')
    l.add_argument('--dry-run', action='store_true', help='read-only: check the laptop is ready, change nothing (no lock)')
    l.add_argument('--return-from-image', action='store_true', help='restart a dev image (root SSH) into the NetBoot Recovery')
    l.add_argument('--usb-verified-by', metavar='RUN', help='an earlier run folder that wrote and read back this image on the drive')
    l.add_argument('--plug', metavar='ADDR', help='the laptop\'s Shelly Plug (Gen2+, local RPC): power-cycle it when it does not come back')
    l.add_argument('--resume-after-install', action='store_true', help='continue a stopped run whose install runs (or ran) in the Recovery; with --usb-verified-by')
    l.add_argument('--hold-file', help='before the first boot, wait while this file exists')
