    j.add_argument('--source')
    j.add_argument('--memory', default='16G')
    j.add_argument('--boot-timeout', type=int, default=90 * 60)
    s = sub.add_parser('report')
    s.add_argument('dir')
    a = p.parse_args()
    if a.op == 'report':
        print(markdown(json.loads((Path(a.dir) / 'result.json').read_text())))
        return 0
    if a.op == 'laptop':
        if a.laptop == 'auto':
            a.laptop = pick_laptop(a)
            if not a.laptop:
                print('no laptop of %s is free and ready (Recovery, NetBoot default, one USB drive)' % a.candidates)
                return 3
        return laptop(a)
    if a.op == 'job':
        return job(a)
    if not a.hao and not a.stick and not a.from_run2:
        p.error('--hao or --stick')
    return run(a)


