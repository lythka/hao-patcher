    j.add_argument('--stick', required=True, help='the USB installer image whose Recovery arms the job')
    j.add_argument('--job', required=True, help='the job script (sh); it gets OUT and PAYLOAD')
    j.add_argument('--payload', help='a folder copied next to the job (probes, kexts)')
    j.add_argument('--esp-side', action='append', required=True, metavar='NAME=DIR', help='one boot per ESP folder')
