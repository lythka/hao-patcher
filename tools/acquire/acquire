#!/usr/bin/env python3.14
"""acquire: download every file a release pins, by URL, size and sha256 (workflow plan step 12).

  acquire fetch MANIFEST --cache DIR [--only NAME ...] [--assets-from DIR|URL] [--quiet | --log json]
  acquire verify MANIFEST --cache DIR          every pinned file present and intact, nothing fetched
  acquire path MANIFEST NAME --cache DIR       where NAME is (after fetch)

MANIFEST is JSON: {"downloads": [{"name": NAME, "url": URL, "size": BYTES, "sha256": HEX, "mirrors": [URL, ...]}]}
(the "downloads" part of a release.json), and a release.json's "assets" too ({"row", "file", "url", "size",
"sha256"}; NAME is the file). --assets-from fetches the assets from that folder or URL prefix first (DIR/FILE), and
from their own URLs only when it lacks them. Files are kept content-addressed in DIR/sha256/<hex>. A file already
there with the right hash is never fetched again. A partial download (DIR/partial/<hex>) resumes with an HTTP Range
request. A file whose size or sha256 differs is refused, removed and never moved into place; the next mirror is tried.
An entry without a URL, a sha256 that is not 64 lower-case hex digits, a name with a path in it or a URL that is not
https, http or file is refused before anything is written. DIR, DIR/sha256 and DIR/partial (the last two never links)
must be folders owned by the user running acquire (root under sudo) and not writable by group or others; a partial or
cached file is opened without following links and must be a regular file of ours, and the open file that is hashed is
the one moved into place. A partial is kept for resuming only when the download stopped; wrong bytes are removed. A download marked "stream" (the IPSW, the installer) is not fetched: the producers
read only the members they need from its URL, each checked against the release's "pins" (pipeline/unpack/ranged.py).

For a candidate, hosted assets (including rehosted Python downloads) come only from --assets-from,
HAO_BOOTSTRAP_FILES, or the manifest's folder, in that order, or the hash-addressed mirror below. Missing or corrupt
candidate files never fall back to their unpublished release URLs. Upstream download rows keep their origins.

A local mirror: with HAO_MIRROR=URL set, each entry's first source is URL/sha256/<its sha256>, then its own url and
mirrors; the size and sha256 checks are the same. A mirror miss (HTTP error, no connection, fewer bytes than pinned)
prints one line, `mirror miss NAME SHA256` (stderr), and the origin sources are tried; with HAO_MIRROR_STRICT=1 it is
an error naming the entry and its sha256, nothing is fetched from elsewhere and its partial is removed. Wrong bytes
from the mirror are refused like wrong bytes from any source (and with HAO_MIRROR_STRICT=1 end the fetch). HAO_MIRROR
is an IPv4 (or host name) URL, e.g. http://192.168.64.1:PORT (an IPv6 address is refused); no proxy applies to it.
HTTPS is checked against the default certificate store; when that is empty (python.org's Python before its
certificates are installed) and SSL_CERT_FILE is not set, /etc/ssl/cert.pem (macOS's own) is loaded into it.
Standard library only.
"""
import argparse
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import ssl
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request

CHUNK = 1 << 20
HEX = re.compile(r'[0-9a-f]{64}')
SCHEMES = ('https', 'http', 'file')
NOFOLLOW = os.O_NOFOLLOW | os.O_CLOEXEC


class AcquireError(RuntimeError):
    pass


class WrongBytes(AcquireError):
    """A source served bytes that are not the pinned ones (more bytes, or the right size with another sha256)."""


def mirror_url(sha256):
    """URL/sha256/SHA256 of the local mirror HAO_MIRROR names, or None when it is not set."""
    base = os.environ.get('HAO_MIRROR', '').strip()
    if not base:
        return None
    url = base.rstrip('/') + '/sha256/' + sha256
    u = urllib.parse.urlsplit(url)
    if u.scheme.lower() not in SCHEMES:
        raise AcquireError('HAO_MIRROR %r is not a %s URL' % (base, ', '.join(SCHEMES)))
    if '[' in u.netloc or '%' in u.netloc:
        raise AcquireError('HAO_MIRROR %r: an IPv6 address is not supported; use an IPv4 URL such as '
                           'http://192.168.64.1:PORT' % base)
    return url


def mirror_strict():
    return os.environ.get('HAO_MIRROR_STRICT', '') == '1'


SYSTEM_CA = '/etc/ssl/cert.pem'


def https_context(create=ssl.create_default_context, system=SYSTEM_CA):
    """The TLS context for https: the default store, plus SYSTEM when that store is empty and SSL_CERT_FILE is unset."""
    ctx = create()
    if not os.environ.get('SSL_CERT_FILE') and not ctx.get_ca_certs() and os.path.isfile(system):
        ctx.load_verify_locations(cafile=system)
    return ctx


def opener(direct=False, context=None):
    """An opener with the https context; DIRECT: the local mirror is reached with no proxy from the environment."""
    handlers = [urllib.request.HTTPSHandler(context=context or https_context())]
    if direct:
        handlers.insert(0, urllib.request.ProxyHandler({}))
    return urllib.request.build_opener(*handlers)


def asset_source(where):
    """The URL prefix --assets-from names: a folder (as a file:// URL) or a URL."""
    if '://' in str(where):
        return str(where).rstrip('/') + '/'
    return Path(where).resolve().as_uri().rstrip('/') + '/'


def load(manifest, assets_from=None):
    """The entries MANIFEST pins: its downloads, then its assets (named by their file), each with its "kind"."""
    with open(manifest) as f:
        m = json.load(f)
    rows = [dict(r, kind='download') for r in m.get('downloads') or []]
    for a in m.get('assets') or []:
        row = {'name': a.get('file'), 'url': a.get('url'), 'size': a.get('size'), 'sha256': a.get('sha256'),
               'mirrors': list(a.get('mirrors', [])), 'kind': 'asset', 'row': a.get('row')}
        if assets_from and isinstance(row['name'], str):
            # the folder release-cut staged: our assets at its top, those another repository hosts in external/
            row['mirrors'] = [asset_source(assets_from) + 'external/' + urllib.parse.quote(row['name'])] + (
                [row['url']] if row['url'] else []) + row['mirrors']
            row['url'] = asset_source(assets_from) + urllib.parse.quote(row['name'])
        rows.append(row)
    if m.get('candidate'):
        # Candidate release URLs do not exist. Never fall back to them, even
        # when the local copy is absent or corrupt. Fetch still verifies bytes.
        source = assets_from or os.environ.get('HAO_BOOTSTRAP_FILES') or Path(manifest).parent
        prefix = asset_source(source)
        for row in rows:
            if row['kind'] == 'asset' or str(row.get('url', '')).startswith(
                    'https://github.com/lythka/hao-assets/releases/download/'):
                row['url'] = prefix + urllib.parse.quote(row['name'])
                row['mirrors'] = []
    if not rows:
        raise AcquireError('%s has no downloads or assets' % manifest)
    names = set()
    for r in rows:
        for k, t in (('name', str), ('url', str), ('size', int), ('sha256', str)):
            if not isinstance(r.get(k), t) or isinstance(r.get(k), bool):
                raise AcquireError('%s: %s %r needs %s' % (manifest, r['kind'], r.get('name') or r.get('row'), k))
        if r['name'] in names:
            raise AcquireError('%s: %s listed twice' % (manifest, r['name']))
        problem = check_row(r)
        if problem:
            raise AcquireError('%s: %s %r %s' % (manifest, r['kind'], r['name'], problem))
        names.add(r['name'])
    return rows


def check_row(r):
    """What is wrong with entry R's sha256, size, name or URLs, or None."""
    if not isinstance(r.get('sha256'), str) or not HEX.fullmatch(r['sha256']):
        return 'has a sha256 that is not 64 lower-case hex digits'
    if not isinstance(r.get('size'), int) or isinstance(r['size'], bool) or r['size'] < 0:
        return 'has a size that is not a whole number of bytes'
    n = r.get('name')
    if not isinstance(n, str) or not n or n in ('.', '..') or any(c in n for c in '/\\\0'):
        return 'has a name that is not a plain file name'
    mirrors = r.get('mirrors', [])
    if not isinstance(mirrors, list):
        return 'has mirrors that are not a list'
    for u in [r.get('url')] + mirrors:
        if not isinstance(u, str) or urllib.parse.urlsplit(u).scheme.lower() not in SCHEMES:
            return 'has a URL that is not %s: %r' % (', '.join(SCHEMES), u)
    return None


def sha256_fd(fd):
    """The sha256 of the open file FD, read from its start."""
    h = hashlib.sha256()
    off = 0
    while block := os.pread(fd, CHUNK, off):
        h.update(block)
        off += len(block)
    return h.hexdigest()


def sha256_file(path):
    fd = os.open(path, os.O_RDONLY | NOFOLLOW)
    try:
        return sha256_fd(fd)
    finally:
        os.close(fd)


def final_path(cache, row):
    return Path(cache) / 'sha256' / row['sha256']


def owned_file(fd, what):
    """FD's stat; refused unless it is a regular file of ours with one link."""
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_nlink != 1:
        raise AcquireError('%s is not a regular file owned by uid %d; remove it' % (what, os.geteuid()))
    return st


def open_cached(name, dir_fd=None):
    """A read FD of cached file NAME (relative to DIR_FD), never through a link; None if it is not there."""
    try:
        return os.open(name, os.O_RDONLY | NOFOLLOW, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError as x:
        raise AcquireError('%s: %s (a link or not a file); remove it' % (name, x.strerror))


def matches(fd, row):
    st = os.fstat(fd)
    return stat.S_ISREG(st.st_mode) and st.st_size == row['size'] and sha256_fd(fd) == row['sha256']


def intact(cache, row):
    try:
        fd = open_cached(final_path(cache, row))
    except AcquireError:
        return False
    if fd is None:
        return False
    try:
        return matches(fd, row)
    finally:
        os.close(fd)


def private_dir(name, dir_fd=None):
    """A FD of folder NAME (relative to DIR_FD), made if missing; refused unless it is a folder (not a link) owned
    by this user and not writable by group or others."""
    try:
        if dir_fd is None:
            os.makedirs(name, mode=0o755, exist_ok=True)
        else:
            os.mkdir(name, 0o755, dir_fd=dir_fd)
    except FileExistsError:
        pass
    except OSError as x:
        raise AcquireError('cache folder %s: %s' % (name, x.strerror))
    try:
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | (NOFOLLOW if dir_fd is not None else os.O_CLOEXEC),
                     dir_fd=dir_fd)
    except OSError as x:
        raise AcquireError('cache folder %s: %s (it must be a folder, not a link)' % (name, x.strerror))
    st = os.fstat(fd)
    if st.st_uid != os.geteuid() or st.st_mode & 0o022:
        os.close(fd)
        raise AcquireError('cache folder %s must be owned by uid %d and not writable by group or others '
                           '(it has owner uid %d, mode %o); remove it or fix its owner and mode'
                           % (name, os.geteuid(), st.st_uid, stat.S_IMODE(st.st_mode)))
    return fd


def open_partial(name, pdir):
    """A FD of partial NAME in folder PDIR: an existing one of ours to resume, or a new one made exclusively."""
    try:
        fd = os.open(name, os.O_RDWR | NOFOLLOW, dir_fd=pdir)
    except FileNotFoundError:
        return os.open(name, os.O_RDWR | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o644, dir_fd=pdir)
    except OSError as x:
        raise AcquireError('partial/%s: %s (a link or not a file); remove it' % (name, x.strerror))
    try:
        owned_file(fd, 'partial/' + name)
    except AcquireError:
        os.close(fd)
        raise
    return fd


def _download(url, fd, size, emit, name, direct=False):
    """Add URL's bytes to the open partial FD, resuming from its length with a Range request."""
    have = os.fstat(fd).st_size
    if have > size:
        os.ftruncate(fd, 0)
        have = 0
    req = urllib.request.Request(url, headers={'User-Agent': 'hao-acquire/1'})
    if have:
        req.add_header('Range', 'bytes=%d-' % have)
    with opener(direct).open(req, timeout=60) as resp:
        status = getattr(resp, 'status', 200)
        if have and status != 206:            # the server ignored the range: start again
            os.ftruncate(fd, 0)
            have = 0
        done = have
        for block in iter(lambda: resp.read(CHUNK), b''):
            if done + len(block) > size:
                raise WrongBytes('%s: more than the pinned %d bytes' % (name, size))
            view = memoryview(block)
            while view:
                n = os.pwrite(fd, view, done)
                done += n
                view = view[n:]
            emit({'ev': 'progress', 'name': name, 'done': done, 'size': size})


def _drop(name, fd, pdir):
    """Remove partial NAME if it is still the file FD."""
    try:
        st, now = os.fstat(fd), os.stat(name, dir_fd=pdir, follow_symlinks=False)
        if (st.st_dev, st.st_ino) == (now.st_dev, now.st_ino):
            os.unlink(name, dir_fd=pdir)
    except OSError:
        pass


def _fetch_row(row, pdir, sdir, emit):
    """Download ROW into partial/, check the open file and move that same file into sha256/; the errors, or None."""
    name, errors = row['sha256'], []
    local = mirror_url(row['sha256'])
    sources = ([(local, True)] if local else []) + [(u, False) for u in [row['url']] + list(row.get('mirrors', []))]
    for url, is_mirror in sources:
        fd = None
        try:
            emit({'ev': 'fetch', 'name': row['name'], 'url': url, 'size': row['size']})
            fd = open_partial(name, pdir)
            try:
                _download(url, fd, row['size'], emit, row['name'], is_mirror)
            except AcquireError:
                _drop(name, fd, pdir)
                raise
            except (OSError, urllib.error.URLError, http.client.HTTPException):
                if os.fstat(fd).st_size == 0 or (is_mirror and mirror_strict()):   # nothing to resume from
                    _drop(name, fd, pdir)
                raise
            st = owned_file(fd, 'partial/' + name)
            digest = sha256_fd(fd)
            if st.st_size != row['size'] or digest != row['sha256']:
                _drop(name, fd, pdir)
                raise (WrongBytes if st.st_size >= row['size'] else AcquireError)('got %d bytes, sha256 %s; pinned %d, %s' % (st.st_size, digest, row['size'],
                                                                             row['sha256']))
            now = os.stat(name, dir_fd=pdir, follow_symlinks=False)
            if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
                raise AcquireError('partial/%s changed while it was checked' % name)
            os.fchmod(fd, 0o644)
            os.rename(name, name, src_dir_fd=pdir, dst_dir_fd=sdir)
            emit({'ev': 'ok', 'name': row['name'], 'sha256': digest})
            return None
        except (OSError, urllib.error.URLError, http.client.HTTPException, AcquireError) as x:
            if is_mirror and mirror_strict():
                raise AcquireError('%s (sha256 %s): %s from the mirror %s: %s; HAO_MIRROR_STRICT=1, no other source '
                                   'is tried' % (row['name'], row['sha256'], 'wrong bytes' if isinstance(x, WrongBytes)
                                                 else 'not served', url, x)) from None
            if is_mirror and not isinstance(x, WrongBytes):
                print('mirror miss %s %s' % (row['name'], row['sha256']), file=sys.stderr, flush=True)
                continue
            errors.append('%s: %s' % (url, x))
            emit({'ev': 'mirror-failed', 'name': row['name'], 'url': url, 'error': str(x)})
        finally:
            if fd is not None:
                os.close(fd)
    return errors


def fetch(rows, cache, *, only=None, on_event=None):
    emit = on_event or (lambda e: None)
    cache = Path(cache)
    for row in rows:
        problem = check_row(row)
        if problem:
            raise AcquireError('%s %s' % (row.get('name'), problem))
    root = private_dir(str(cache))
    try:
        sdir = private_dir('sha256', root)
        try:
            pdir = private_dir('partial', root)
        except AcquireError:
            os.close(sdir)
            raise
    finally:
        os.close(root)
    results = {}
    try:
        for row in rows:
            if only and row['name'] not in only:
                continue
            if row.get('stream'):
                emit({'ev': 'streamed', 'name': row['name'], 'size': row['size']})
                continue
            fd = open_cached(row['sha256'], sdir)
            if fd is not None:
                try:
                    hit = matches(fd, row)
                finally:
                    os.close(fd)
                if hit:
                    emit({'ev': 'reused', 'name': row['name'], 'sha256': row['sha256']})
                    results[row['name']] = str(final_path(cache, row))
                    continue
            errors = _fetch_row(row, pdir, sdir, emit)
            if errors:
                raise AcquireError('%s: no source gave the pinned file:\n  %s' % (row['name'], '\n  '.join(errors)))
            results[row['name']] = str(final_path(cache, row))
    finally:
        os.close(sdir)
        os.close(pdir)
    return results


def printer(level):
    last = {}

    def emit(ev):
        if level == 'json':
            print(json.dumps(ev), flush=True)
            return
        k = ev['ev']
        if level == 'quiet' and k != 'mirror-failed':
            return
        if k == 'reused':
            print('  %-40s already here, sha256 ok' % ev['name'])
        elif k == 'streamed':
            print('  %-40s not downloaded: read by range when the rows are made' % ev['name'])
        elif k == 'fetch':
            print('  %-40s %s' % (ev['name'], ev['url']))
        elif k == 'progress':
            pct = 100 * ev['done'] // max(ev['size'], 1)
            if pct // 10 != last.get(ev['name']):
                last[ev['name']] = pct // 10
                print('    %3d%%  %d / %d bytes' % (pct, ev['done'], ev['size']))
        elif k == 'ok':
            print('  %-40s sha256 ok' % ev['name'])
        elif k == 'mirror-failed':
            print('  %-40s FAILED from %s: %s' % (ev['name'], ev['url'], ev['error']), file=sys.stderr)
    return emit


def main():
    p = argparse.ArgumentParser(prog='acquire', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='action', required=True)
    for name in ('fetch', 'verify', 'path'):
        q = sub.add_parser(name)
        q.add_argument('manifest')
        if name == 'path':
            q.add_argument('name')
        q.add_argument('--cache', required=True)
        if name == 'fetch':
            q.add_argument('--only', nargs='+')
            q.add_argument('--assets-from', help='fetch the assets from this folder or URL prefix first')
            g = q.add_mutually_exclusive_group()
            g.add_argument('--quiet', action='store_true'); g.add_argument('--log', choices=['json'])
    a = p.parse_args()
    try:
        rows = load(a.manifest, getattr(a, 'assets_from', None))
        if a.action == 'fetch':
            level = 'json' if a.log == 'json' else 'quiet' if a.quiet else 'steps'
            fetch(rows, a.cache, only=set(a.only or []), on_event=printer(level))
        elif a.action == 'verify':
            bad = [r['name'] for r in rows if not r.get('stream') and not intact(a.cache, r)]
            for n in bad:
                print('missing or damaged: %s' % n)
            if bad:
                return 1
            print('acquire: %d files present and intact' % len(rows))
        else:
            row = next((r for r in rows if r['name'] == a.name), None)
            if row is None or not intact(a.cache, row):
                print('acquire: %s is not here (run fetch)' % a.name, file=sys.stderr)
                return 1
            print(final_path(a.cache, row))
    except AcquireError as x:
        print('acquire: %s' % x, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
