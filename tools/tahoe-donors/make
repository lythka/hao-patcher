#!/usr/bin/env python3
"""Extract declared Tahoe donors; never construct a Tahoe installation."""
import argparse
import ctypes
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import plistlib
import shutil
import stat
import subprocess

UNIT = Path(__file__).resolve().parent
REVISION = 10


def sha(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda: stream.read(8 << 20), b''):
            h.update(block)
    return h.hexdigest()


def relative(value):
    p = PurePosixPath(value)
    if p.is_absolute() or '..' in p.parts or not p.parts:
        raise ValueError('expected relative donor path: '+str(value))
    return Path(*p.parts)


def write(path, data):
    path.write_text(json.dumps(data, indent=2, sort_keys=True)+'\n')


def xattrs(path):
    # CPython's Darwin build has no os.listxattr; use the native no-follow API.
    if hasattr(os, 'listxattr'):
        return {n:os.getxattr(path,n,follow_symlinks=False).hex()
                for n in os.listxattr(path,follow_symlinks=False)}
    libc=ctypes.CDLL(None,use_errno=True)
    libc.listxattr.restype=ctypes.c_ssize_t
    libc.getxattr.restype=ctypes.c_ssize_t
    source=os.fsencode(path)
    length=libc.listxattr(source,None,0,1)
    if length < 0: raise OSError(ctypes.get_errno(),str(path))
    names=ctypes.create_string_buffer(length)
    if length: libc.listxattr(source,names,length,1)
    result={}
    for name in names.raw.split(b'\0'):
        if not name: continue
        length=libc.getxattr(source,name,None,0,0,1)
        if length < 0: raise OSError(ctypes.get_errno(),str(path))
        value=ctypes.create_string_buffer(length)
        if length: libc.getxattr(source,name,value,length,0,1)
        result[os.fsdecode(name)]=value.raw.hex()
    return result


def set_xattr(path,name,value):
    if hasattr(os,'setxattr'):
        os.setxattr(path,name,value,follow_symlinks=False)
    else:
        libc=ctypes.CDLL(None,use_errno=True)
        if libc.setxattr(os.fsencode(path),os.fsencode(name),value,len(value),0,1):
            raise OSError(ctypes.get_errno(),str(path))


def metadata(path, links):
    rows = {}
    for line in Path(path).read_text().splitlines():
        name, typ, uid, gid, mode, flags, sec, ns, attrs = line.split('\t')
        if typ == 'H':
            continue  # Hard-link records carry no metadata; use the source inode.
        rows[name] = dict(uid=int(uid), gid=int(gid), mode=mode, flags=flags,
                          mtime_ns=int(sec)*10**9+int(ns) if sec != '-' else None,
                          xattrs={} if attrs == '-' else dict(x.split('=', 1) for x in attrs.split(',')))
    master = None
    aliases = {}
    for line in Path(links).read_text().splitlines():
        if line.startswith('='):
            master = line[1:]
        elif line.startswith('+'):
            aliases[line[1:]] = master
    for alias, master in aliases.items():
        if master in rows:
            rows[alias] = dict(rows[master], hardlink_metadata_from=master)
    return rows


def entries(source, excluded=()):
    yield source
    if source.is_dir() and not source.is_symlink():
        for p in sorted(source.iterdir()):
            if p.name not in excluded:
                yield from entries(p, excluded)


def copy_entry(source, destination):
    destination.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    if source.is_symlink():
        destination.symlink_to(os.readlink(source))
    elif source.is_dir():
        destination.mkdir(mode=0o755, exist_ok=True)
    elif source.is_file():
        # Mounted Apple images carry restricted flags that an unprivileged host
        # cannot reapply. Keep payload bytes writable; final metadata lives in
        # the manifest and is restored only inside maintenance macOS.
        shutil.copyfile(source, destination)
        value = source.stat()
        os.chmod(destination, stat.S_IMODE(value.st_mode) | stat.S_IWUSR)
        os.utime(destination, ns=(value.st_atime_ns,value.st_mtime_ns))
    else:
        raise ValueError('donor is not a file, directory or symlink: '+str(source))


def describe(source, destination, role, path, overrides=None):
    s = source.lstat()
    row = dict(role=role, path=path.as_posix(), uid=s.st_uid, gid=s.st_gid,
               mode=format(stat.S_IMODE(s.st_mode), 'o'), flags=format(getattr(s, 'st_flags', 0), 'x'),
               mtime_ns=s.st_mtime_ns,
               xattrs=xattrs(source),
               metadata_source='source-lstat', source=str(source))
    if overrides is not None:
        row.update(overrides); row['metadata_source'] = 'installer-sys.tsv'
    if source.is_symlink():
        row.update(kind='symlink', link_target=os.readlink(source), size=0)
    elif source.is_dir():
        row.update(kind='directory', size=0)
    else:
        row.update(kind='file', size=s.st_size, sha256=sha(source))
    return row


def package(args):
    recipe = json.loads(args.recipe.read_text())
    args.output.mkdir(mode=0o755, parents=True, exist_ok=False)
    payload = args.output/'payload'; payload.mkdir(mode=0o755)
    rows, inputs = [], [args.recipe]
    def add(source, role, path, overrides=None):
        target = payload/role/path
        copy_entry(source, target)
        rows.append(describe(source, target, role, path, overrides))
    if args.command == 'native':
        attrs = metadata(args.metadata,args.links); inputs.extend([args.metadata,args.links])
        for root in recipe['system_roots']:
            start = args.tree/relative(root)
            for p in entries(start,recipe.get('excluded_names',[])):
                rel = p.relative_to(args.tree)
                if rel.as_posix() not in attrs:
                    raise ValueError('required installer metadata is absent: '+rel.as_posix())
                add(p, 'system', rel, attrs[rel.as_posix()])
        for name in recipe['build_tools']:
            p = args.tree/relative(name)
            add(p, 'build-tools', relative(name), attrs[name])
    elif args.command == 'extensions':
        attrs = metadata(args.metadata,args.links); inputs.extend([args.metadata,args.links])
        for root in recipe['extensions_roots']:
            for p in entries(args.tree/relative(root),recipe.get('excluded_names',[])):
                rel=p.relative_to(args.tree)
                if rel.as_posix() not in attrs:
                    raise ValueError('required installer metadata is absent: '+rel.as_posix())
                add(p, 'extensions', rel, attrs[rel.as_posix()])
    elif args.command == 'driverkit':
        sources = [args.source] if isinstance(args.source,(str,Path)) else args.source
        names = {}
        for source in sources:
            for p in sorted(Path(source).glob('dyld_shared_cache_x86_64*')):
                if p.is_dir():
                    raise ValueError('DriverKit family member is a directory: '+str(p))
                if p.name in names:
                    if sha(p) != sha(names[p.name]):
                        raise ValueError('ambiguous DriverKit family member: '+p.name)
                    continue
                names[p.name] = p
        if not names:
            raise ValueError('supplied DriverKit cache directory has no x86_64 family')
        for family in recipe.get('required_driverkit_families',[]):
            if family not in names:
                raise ValueError('required DriverKit family missing: '+family)
        attrs = metadata(args.metadata, os.devnull) if getattr(args,'metadata',None) else {}
        if attrs: inputs.append(args.metadata)
        for name,p in sorted(names.items()):
            if attrs and name not in attrs:
                raise ValueError('DriverKit metadata has no row for '+name)
            uid = attrs[name]['uid'] if attrs else p.lstat().st_uid
            if 'driverkit_owner_uid' in recipe and uid != recipe['driverkit_owner_uid']:
                raise ValueError('DriverKit source owner differs; mount source read-only with owners on: '+str(p))
            add(p, 'driverkit-cache', Path(name), attrs.get(name))
        inputs.extend(getattr(args,'source_image',None) or [])
    elif args.command in ('boot', 'recovery'):
        inputs.append(args.map)
        for line in args.map.read_text().splitlines():
            volume, path, size, digest, kind, sources = line.split('\t')
            if volume != ('preboot' if args.command == 'boot' else 'recovery') or kind != 'matched':
                continue
            rel = Path(*relative(path).parts[1:])  # Volume group is selected at install time.
            if args.command == 'boot' and (rel.as_posix() in recipe['preboot_exclude'] or 'KernelCollections' in rel.parts):
                continue
            origin = relative(sources.split(';')[0])
            source = (args.tree/Path(*origin.parts[1:])) if origin.parts[0] == 'tree' else args.unpack/origin
            if source.stat().st_size != int(size) or sha(source) != digest:
                raise ValueError('mapped donor source differs: '+str(source))
            add(source, 'preboot' if args.command == 'boot' else 'recovery', rel)
            rows[-1]['original_map_path'] = path
            rows[-1]['mapped_source'] = sources
            rows[-1]['metadata_source'] = 'source-lstat-map'
            rows[-1].update(uid=0,gid=0)
        if args.command == 'boot':
            origin = args.unpack/'zip/AssetData/boot/BuildManifest.plist'; inputs.append(origin)
            manifest = plistlib.loads(origin.read_bytes())
            manifest['BuildIdentities'] = [i for i in manifest['BuildIdentities'] if i['Info'].get('Variant') != 'Customer Software Update']
            for name in ['cryptex1/current/BuildManifest.plist', 'restore/BuildManifest.plist']:
                p = payload/'preboot'/name; p.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
                p.write_bytes(plistlib.dumps(manifest, fmt=plistlib.FMT_XML, sort_keys=True))
                row = describe(p, p, 'preboot', Path(name)); row['source'] = str(origin)
                row['transformation'] = 'remove Customer Software Update identities; sorted XML plist'
                row.update(uid=0,gid=0,mode='644',flags='0')
                rows.append(row)
    totals = {}
    for role in sorted({r['role'] for r in rows}):
        selected = [r for r in rows if r['role'] == role]
        totals[role] = dict(files=sum(r['kind']=='file' for r in selected),
                            symlinks=sum(r['kind']=='symlink' for r in selected),
                            directories=sum(r['kind']=='directory' for r in selected),
                            regular_bytes=sum(r['size'] for r in selected if r['kind']=='file'))
    manifest = dict(schema=1, origin=recipe['origin'], operation=args.command,
                    required_image_roles=recipe['required_image_roles'], totals=totals, entries=rows)
    if args.command == 'driverkit':
        manifest['required_driverkit_families'] = recipe.get('required_driverkit_families',[])
    manifest['replacement_policy'] = recipe.get('replacement_policy','replace-maximal-declared-roots')
    write(args.output/'manifest.json', manifest)
    root = UNIT.parents[1]
    record = dict(unit='tools/tahoe-donors', revision=REVISION, operation=args.command,
                  date=datetime.now(timezone.utc).isoformat(),
                  commit=subprocess.check_output(['git','-C',str(root),'rev-parse','HEAD'],text=True).strip(),
                  dirty=bool(subprocess.check_output(['git','-C',str(root),'status','--porcelain'],text=True)),
                  inputs=[dict(path=str(p.resolve()), sha256=sha(p)) for p in inputs],
                  source_inputs=[dict(path=str(p), sha256=sha(p)) for p in [Path(__file__)]],
                  origin=recipe['origin'], totals=totals,
                  manifest_sha256=sha(args.output/'manifest.json'),
                  scope='Donor role only. No Tahoe install, original kernel/KCs, KDK/OCLP content or complete image is produced.')
    write(args.output/'build.json', record)
    return manifest


def install_native(artifact, system, role='system'):
    """Run inside maintenance macOS as root, after Golden Gate filesystem install."""
    manifest = json.loads((artifact/'manifest.json').read_text())
    rows = [r for r in manifest['entries'] if r['role'] == role]
    if not rows:
        raise ValueError('artifact has no requested donor role: '+role)
    # The manifest is the metadata source. Reading attributes on a virtiofs
    # symlink can return ELOOP even when readlink/stat show a direct file link.
    # Never ask a recursive copier to inspect shared source symlink metadata.
    if manifest.get('replacement_policy','replace-maximal-declared-roots') != 'replace-maximal-declared-roots':
        raise ValueError('unsupported donor replacement policy')
    if role == 'driverkit-cache':
        provided={r['path'] for r in rows}
        for family in manifest.get('required_driverkit_families',[]):
            if family not in provided:
                raise ValueError('required DriverKit family missing: '+family)
    paths = {relative(r['path']) for r in rows}
    for p in sorted(paths,key=lambda p:(len(p.parts),p.as_posix())):
        if any(parent in paths for parent in p.parents):
            continue
        dest = system/p; dest.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        if os.path.lexists(dest):
            subprocess.run(['chflags','-h' if dest.is_symlink() else '-RP',
                            'noschg,nouchg,norestricted',str(dest)],check=True)
        if dest.is_symlink() or dest.is_file():
            dest.unlink()
        elif dest.is_dir():
            shutil.rmtree(dest)
    for row in sorted(rows,key=lambda r:(len(relative(r['path']).parts),r['path'])):
        p = relative(row['path']); destination = system/p
        destination.parent.mkdir(mode=0o755,parents=True,exist_ok=True)
        if row['kind'] == 'directory':
            destination.mkdir(mode=0o755,exist_ok=True)
        elif row['kind'] == 'symlink':
            destination.symlink_to(row['link_target'])
        elif row['kind'] == 'file':
            source = artifact/'payload'/role/p
            # O_NOFOLLOW also refuses a regular-file payload replaced by a
            # symlink. Hash while copying the bytes already required by this step.
            digest = hashlib.sha256()
            with os.fdopen(os.open(source,os.O_RDONLY|os.O_NOFOLLOW),'rb') as src, destination.open('xb') as dst:
                for block in iter(lambda:src.read(8<<20),b''):
                    dst.write(block);digest.update(block)
            if digest.hexdigest() != row['sha256']:
                raise ValueError('donor file differs from manifest: '+str(source))
        else:
            raise ValueError('unknown donor entry kind: '+row['kind'])
    for row in sorted(rows, key=lambda r:len(Path(r['path']).parts), reverse=True):
        p = system/relative(row['path'])
        os.lchown(p, row['uid'], row['gid'])
        if row['kind'] != 'symlink':
            os.chmod(p, int(row['mode'], 8))
        elif hasattr(os,'lchmod'):
            os.lchmod(p,int(row['mode'],8))
        else:
            libc=ctypes.CDLL(None,use_errno=True)
            libc.lchmod.argtypes=[ctypes.c_char_p,ctypes.c_uint16]
            if libc.lchmod(os.fsencode(p),int(row['mode'],8)):
                raise OSError(ctypes.get_errno(),str(p))
        for name, value in row['xattrs'].items():
            set_xattr(p, name, bytes.fromhex(value))
        if row['mtime_ns'] is not None:
            os.utime(p, ns=(row['mtime_ns'],row['mtime_ns']), follow_symlinks=False)
        # Match pristine hmeta: logical-byte copies must keep their actual
        # storage compression state, and firmlink objects come from APFS fsctl.
        flags = (int(row['flags'],16) & ~0x00800020) | (getattr(p.lstat(),'st_flags',0) & 0x20)
        os.chflags(p, flags, follow_symlinks=False)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command')
    for name in ['native','extensions','driverkit','boot','recovery']:
        p = sub.add_parser(name)
        p.add_argument('--recipe',type=Path,required=True)
        p.add_argument('--output',type=Path,required=True)
        if name in ('native','extensions','boot','recovery'):
            p.add_argument('--tree',type=Path,required=True)
        if name in ('native','extensions'):
            p.add_argument('--metadata',type=Path,required=True)
            p.add_argument('--links',type=Path,required=True)
        if name == 'driverkit':
            p.add_argument('--source',type=Path,action='append',required=True,help='repeat for generic and Haswell cache source directories')
            p.add_argument('--metadata',type=Path,help='owners, modes, flags and times of the cache files (sys.tsv format), when the copies do not carry them')
            p.add_argument('--source-image',type=Path,action='append',help='retained source image identity recorded in build.json')
        if name in ('boot','recovery'):
            p.add_argument('--unpack',type=Path,required=True)
            p.add_argument('--map',type=Path,required=True)
    for name in ['install-native','install-extensions']:
        p = sub.add_parser(name,help='guest-only: apply donor files and recorded metadata')
        p.add_argument('--artifact',type=Path,required=True);p.add_argument('--system',type=Path,required=True)
    p = sub.add_parser('install-driverkit',help='guest-only: restore Intel cache family metadata before sealing')
    p.add_argument('--artifact',type=Path,required=True);p.add_argument('--cryptex',type=Path,required=True)
    p = sub.add_parser('install-role',help='guest-only: copy a bootstrap role with its manifest metadata')
    p.add_argument('--artifact',type=Path,required=True)
    p.add_argument('--role',choices=['preboot','recovery'],required=True)
    p.add_argument('--destination',type=Path,required=True)
    args = parser.parse_args()
    if args.command == 'install-role':
        install_native(args.artifact,args.destination,args.role)
    elif args.command == 'install-driverkit':
        install_native(args.artifact,args.cryptex/'System/DriverKit/System/Library/dyld','driverkit-cache')
    elif args.command in ('install-native','install-extensions'):
        install_native(args.artifact,args.system,'system' if args.command=='install-native' else 'extensions')
    elif args.command:
        result=package(args);print(json.dumps(result['totals'],sort_keys=True))
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
