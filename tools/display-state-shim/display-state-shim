#!/usr/bin/env python3
"""Build the Golden Gate Intel display-state adapter into a new artifact directory."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import subprocess

HERE = Path(__file__).resolve().parent
UNIT = 'tools/display-state-shim'
REVISION = 4
INPUTS = ('src/dss_shim.c', 'src/dss_builds.h', 'src/dss_convert.c', 'src/dss_convert.h',
          'stubs/CoreDisplay.tbd')


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def builds():
    """The SkyLight and CoreDisplay UUIDs src/dss_builds.h lists, by build, in table order."""
    found = {}
    for line in (HERE / 'src/dss_builds.h').read_text().splitlines():
        match = re.match(r'(SKYLIGHT|COREDISPLAY)_BUILD\("([^"]+)".*// ([0-9A-F-]{36})$', line)
        if match:
            found.setdefault(match[2], {})[match[1].lower() + '_uuid'] = match[3]
    return found


def report(*args):
    return subprocess.check_output(args, cwd=HERE, text=True).strip()


def build(output):
    output = output.resolve()
    output.mkdir(mode=0o755, parents=True)
    dylib = output / 'dss_shim.dylib'
    command = ['xcrun', 'clang', '-arch', 'x86_64', '-mmacosx-version-min=26.0',
               '-O2', '-Wall', '-Wextra', '-dynamiclib', '-o', str(dylib),
               '-install_name', '/usr/local/lib/dss_shim.dylib',
               'src/dss_shim.c', 'src/dss_convert.c', 'stubs/CoreDisplay.tbd']
    subprocess.run(command, cwd=HERE, check=True)
    subprocess.run(['codesign', '-s', '-', '-f', str(dylib)], check=True)
    record = dict(unit=UNIT, revision=REVISION,
                  date=datetime.now(timezone.utc).isoformat(),
                  commit=report('git', 'rev-parse', 'HEAD'),
                  dirty=bool(report('git', 'status', '--porcelain')),
                  inputs=[dict(path=str(HERE / name), sha256=digest(HERE / name))
                          for name in (*INPUTS, 'display-state-shim')],
                  compiler=report('xcrun', 'clang', '--version'),
                  sdk=report('xcrun', '--show-sdk-version'),
                  command=command,
                  applicability=dict(architecture='x86_64', builds=builds()),
                  outputs={'dss_shim.dylib': digest(dylib)})
    (output / 'build.json').write_text(json.dumps(record, indent=2) + '\n')
    print(dylib)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--out', type=Path, required=True,
                        help='new artifact directory; existing output is never changed')
    import sys
    if len(sys.argv) == 1:
        parser.print_help()
        return
    args = parser.parse_args()
    build(args.out)


if __name__ == '__main__':
    main()
