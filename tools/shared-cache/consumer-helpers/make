#!/usr/bin/env python3.14
"""Produce the fixed x86_64 Swift witness consumer and constructor collector."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'src'))
from dyld_rebuild.witness_consumer import produce
from dyld_rebuild.witness_graph import compile_fixture, compile_replay


def build(a):
    a.output.mkdir(parents=True,exist_ok=False)
    produce(a.toolchain,a.devkit,a.output/'consumer',a.llvm)
    graph=a.output/'graph';graph.mkdir()
    compile_fixture(a.toolchain,a.devkit,graph,a.llvm)
    records={}
    for name,source in [('witness-consumer',a.output/'consumer/witness-consumer'),('witness-graph',graph/'swift-capture')]:
        target=a.output/name
        shutil.copy2(source,target)
        from dyld_rebuild.helper_sign import sign
        sign(target, 'org.hao.'+name)
        records[name]=hashlib.sha256(target.read_bytes()).hexdigest()
    for name in ('dependency-replay', 'dependency-installed', 'dependency-runtime'):
        binary = compile_replay(a.toolchain, a.devkit, a.output/name, a.llvm, name, a.runtime_object)
        records[name] = hashlib.sha256(binary.read_bytes()).hexdigest()
    (a.output/'build.json').write_text(json.dumps(records,indent=2)+'\n')
    print(json.dumps(records,indent=2))


if __name__=='__main__':
    ap=argparse.ArgumentParser(description=__doc__)
    for name in ('output','toolchain','devkit','llvm','runtime-object'):
        ap.add_argument('--'+name,type=Path,required=True)
    build(ap.parse_args())
