	PROGRAM
	SHADER c6

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r34;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, u0;
	MOV r2.x, i0.x;



	MOV r34.x, 1;
	MOV r8.x, 0;
	MOV r9.x, 8;
	MOV_SWZ r10, r9.x, r8.x, r8.x, r8.x;
	MOV r11, r10;
	LADD r12, r0, r11;
	LD_RAW_PTR r3, r12, C0;
	LD_RAW_PTR r4, r0, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r13, r4;
	MOV r14.x, r13;
	MOV r15.x, r4;
	ICMP.eq r16.x, r14.x, r15.x;
	AND r16.x, r16.x, 0x1;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r17, r3;
	MOV r18.x, r17;
	MOV r19.x, r3;
	ICMP.eq r20.x, r18.x, r19.x;
	AND r20.x, r20.x, 0x1;
	AND r21.x, r16.x, r20.x;

	MOV r22.x, 0;
	MOV r23.x, 1;
	MOV_CND.nz r24.x, r21.x, r23.x, r22.x;
	ICMP.ne r25.x, r24.x, r23.x;
	AND r25.x, r25.x, 0x1;
	MOV r34.x, r25.x;
	BREAK_CND.z r25.x;
	ENDLOOP;

	MOV r34.x, 1;
	SHR r26.x, r2.x, 28;
	SHL r27.x, r2.x, 4;
	MOV r28.x, 0;
	MOV_SWZ r29, r27.x, r26.x, r28.x, r28.x;
	MOV r30, r29;
	LADD r31, r1, r30;
	MOV r32.x, 0x00000000;
	MOV_SWZ r33, r32.x, r32.x, r32.x, r32.x;
	STORE_RAW_PTR u0, r31, r33;

	RET;

	END
