	PROGRAM
	SHADER c4

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 2,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_RESOURCE t0, 2D, FLOAT =
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 2, 0,
	  EMULATION_ARGUMENT, FALSE,
	  SAMPLER_NUM, [0]
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r31;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, u0;
	MOV r2.x, i0.x;



	MOV r31.x, 1;
	MOV r9.x, 0;
	MOV r10.x, 8;
	MOV_SWZ r11, r10.x, r9.x, r9.x, r9.x;
	MOV r12, r11;
	LADD r13, r0, r12;
	LD_RAW_PTR r3, r13, C0;
	MOV_SWZ r14, r9.x, r9.x, r9.x, r9.x;
	MOV r4, r14;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r15, r3;
	MOV r16.x, r15;
	MOV r17.x, r3;
	MOV r18.x, 0x00000000;
	MOV r19.x, 0x3F000000;
	MOV_SWZ r20, r19.x, r19.x, r18.x, r18.x;
	MOV r21.x, r4;
	SAMPLE_L r5, r20(0, 0, 0), t0, s0[r16.x], r18, 2D;
	ICMP.ne r24.x, r16.x, r17.x;
	AND r24.x, r24.x, 0x1;
	MOV r31.x, r24.x;
	BREAK_CND.z r24.x;
	ENDLOOP;

	MOV r31.x, 1;
	SHR r25.x, r2.x, 28;
	SHL r26.x, r2.x, 4;
	MOV r27.x, 0;
	MOV_SWZ r28, r26.x, r25.x, r27.x, r27.x;
	MOV r29, r28;
	LADD r30, r1, r29;
	STORE_RAW_PTR u0, r30, r5;

	RET;

	END
