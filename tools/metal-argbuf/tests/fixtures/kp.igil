	PROGRAM
	SHADER kp

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 4,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_RESOURCE t0, 2D, FLOAT =
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 2, 0,
	  EMULATION_ARGUMENT, FALSE,
	  SAMPLER_NUM, [0, 1]
	};

	DCL_CONSTANTREGISTER c0 =
	{
		SAMPLER_NORMALIZED_COORDS, 2, 0,
		SAMPLER_ADDRESS_MODE, 2, 0,
		SAMPLER_NORMALIZED_COORDS, 1, 0,
		SAMPLER_ADDRESS_MODE, 1, 0
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 3,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_SAMPLER s0 =
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 3, 0,
	  EMULATION_ARGUMENT, FALSE
	};

	DCL_SAMPLER s1 =
	{
	  KERNEL_ARGUMENT, 2,
	  LOCATION_INDEX, 5, 0,
	  EMULATION_ARGUMENT, FALSE
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r86;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, u0;
	MOV r2.x, i0.x;



	MOV r86.x, 1;
	MOV r13.x, 0x00000000;
	MOV r14.x, 0x3F000000;
	MOV_SWZ r15, r14.x, r14.x, r13.x, r13.x;
	MOV r16.x, r15.x;
	MOV r17.x, r16.x;
	SHR r18.x, r17.x, 31;
	AND r19.x, r18.x, 1;
	MOV r20.x, 0xBF800000;
	MOV_CND.nz r21.x, r19.x, r20.x, r16.x;
	MOV_SWZ r22.xy, r21.x, r15.y, 0, 0;
	MOV r23.x, r22.y;
	MOV r24.x, r23.x;
	SHR r25.x, r24.x, 31;
	AND r26.x, r25.x, 1;
	MOV_CND.nz r27.x, r26.x, r20.x, r23.x;
	MOV_SWZ r28.xy, r22.x, r27.x, 0, 0;
	MOV r29.x, 2;
	ICMP.eq r30.x, c0.w, r29.x;
	AND r30.x, r30.x, 0x1;
	MOV_CND.nz r31, r30.x, r15, r28;
	MOV r32.x, 8;
	ICMP.eq r33.x, c0.z, r32.x;
	AND r33.x, r33.x, 0x1;
	MOV_CND.nz r34, r33.x, r15, r31;
	MOV r35.x, 0;
	SAMPLE_L r36, r34(0, 0, 0), t0, s0, r13, 2D;
	MOV r39.x, 0x3E800000;
	MOV_SWZ r40, r39.x, r39.x, r13.x, r13.x;
	MOV r41.x, r40.x;
	MOV r42.x, r41.x;
	SHR r43.x, r42.x, 31;
	AND r44.x, r43.x, 1;
	MOV_CND.nz r45.x, r44.x, r20.x, r41.x;
	MOV_SWZ r46.xy, r45.x, r40.y, 0, 0;
	MOV r47.x, r46.y;
	MOV r48.x, r47.x;
	SHR r49.x, r48.x, 31;
	AND r50.x, r49.x, 1;
	MOV_CND.nz r51.x, r50.x, r20.x, r47.x;
	MOV_SWZ r52.xy, r46.x, r51.x, 0, 0;
	ICMP.eq r53.x, c0.y, r29.x;
	AND r53.x, r53.x, 0x1;
	MOV_CND.nz r54, r53.x, r40, r52;
	ICMP.eq r55.x, c0.x, r32.x;
	AND r55.x, r55.x, 0x1;
	MOV_CND.nz r56, r55.x, r40, r54;
	MOV r57.x, 1;
	SAMPLE_L r58, r56(0, 0, 0), t0, s1, r13, 2D;
	FADD r3, r58, r36;
	MOV_SWZ r61, r32.x, r35.x, r35.x, r35.x;
	MOV r62, r61;
	LADD r63, r0, r62;
	LD_RAW_PTR r4, r63, C0;
	LD_RAW_PTR r5, r0, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r64, r5;
	MOV r65.x, r64;
	MOV r66.x, r5;
	ICMP.eq r67.x, r65.x, r66.x;
	AND r67.x, r67.x, 0x1;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r68, r4;
	MOV r69.x, r68;
	MOV r70.x, r4;
	ICMP.eq r71.x, r69.x, r70.x;
	AND r71.x, r71.x, 0x1;
	AND r72.x, r67.x, r71.x;

	MOV r73.x, 0;
	MOV r74.x, 1;
	MOV_CND.nz r75.x, r72.x, r74.x, r73.x;
	ICMP.ne r76.x, r75.x, r74.x;
	AND r76.x, r76.x, 0x1;
	MOV r86.x, r76.x;
	BREAK_CND.z r76.x;
	ENDLOOP;

	MOV r86.x, 1;
	MOV r77.x, 0x00000000;
	MOV_SWZ r78, r77.x, r77.x, r77.x, r77.x;
	FADD r79, r3, r78;
	SHR r80.x, r2.x, 28;
	SHL r81.x, r2.x, 4;
	MOV r82.x, 0;
	MOV_SWZ r83, r81.x, r80.x, r82.x, r82.x;
	MOV r84, r83;
	LADD r85, r1, r84;
	STORE_RAW_PTR u0, r85, r79;

	RET;

	END
