	PROGRAM
	SHADER c3

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 2,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_RESOURCE t0, 2D, FLOAT =
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 2, 0,
	  EMULATION_ARGUMENT, FALSE,
	  SAMPLER_NUM, [0]
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_SAMPLER s0 =
	{
	  INLINE,
	  AIR_SAMPLER_STATE, 2155609856 526921
		// S_ADDRESS_CLAMP_TO_EDGE
		// T_ADDRESS_CLAMP_TO_EDGE
		// R_ADDRESS_CLAMP_TO_EDGE
		// MAG_FILTER_LINEAR
		// MIN_FILTER_LINEAR
		// MIP_FILTER_NONE
		// NORMALIZED_TRUE
		// COMPARE_FUNC_NEVER
		// MAX_ANISOTROPY_LEVEL, 0
		// LOD_MIN_VALUE, 0
		// LOD_MAX_VALUE, 31743
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r41;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, u0;
	MOV r2.x, i0.x;



	MOV r41.x, 1;
	MOV r9.x, 0x00000000;
	MOV r10.x, 0x3F000000;
	MOV_SWZ r11, r10.x, r10.x, r9.x, r9.x;
	MOV r12.x, 0;
	SAMPLE_L r3, r11(0, 0, 0), t0, s0, r9, 2D;
	MOV r15.x, 8;
	MOV_SWZ r16, r15.x, r12.x, r12.x, r12.x;
	MOV r17, r16;
	LADD r18, r0, r17;
	LD_RAW_PTR r4, r18, C0;
	LD_RAW_PTR r5, r0, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r19, r5;
	MOV r20.x, r19;
	MOV r21.x, r5;
	ICMP.eq r22.x, r20.x, r21.x;
	AND r22.x, r22.x, 0x1;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r23, r4;
	MOV r24.x, r23;
	MOV r25.x, r4;
	ICMP.eq r26.x, r24.x, r25.x;
	AND r26.x, r26.x, 0x1;
	AND r27.x, r22.x, r26.x;

	MOV r28.x, 0;
	MOV r29.x, 1;
	MOV_CND.nz r30.x, r27.x, r29.x, r28.x;
	ICMP.ne r31.x, r30.x, r29.x;
	AND r31.x, r31.x, 0x1;
	MOV r41.x, r31.x;
	BREAK_CND.z r31.x;
	ENDLOOP;

	MOV r41.x, 1;
	MOV r32.x, 0x00000000;
	MOV_SWZ r33, r32.x, r32.x, r32.x, r32.x;
	FADD r34, r3, r33;
	SHR r35.x, r2.x, 28;
	SHL r36.x, r2.x, 4;
	MOV r37.x, 0;
	MOV_SWZ r38, r36.x, r35.x, r37.x, r37.x;
	MOV r39, r38;
	LADD r40, r1, r39;
	STORE_RAW_PTR u0, r40, r34;

	RET;

	END
