	PROGRAM
	SHADER t1

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r28;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, u0;
	MOV r2.x, i0.x;



	MOV r28.x, 1;
	LD_RAW_PTR r3, r0, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r8, r3;
	MOV r9.x, r8;
	MOV r10.x, r3;
	MOV r11.x, 0;
	MOV_SWZ r12, r11.x, r11.x, r11.x, r11.x;
	MOV r12.w, 0;
	LD_UAV_TYPED r4, r12, u[r9.x];
	ICMP.ne r14.x, r9.x, r10.x;
	AND r14.x, r14.x, 0x1;
	MOV r28.x, r14.x;
	BREAK_CND.z r14.x;
	ENDLOOP;

	MOV r28.x, 1;
	MOV r15.x, 0;
	MOV r16.x, 8;
	MOV_SWZ r17, r16.x, r15.x, r15.x, r15.x;
	MOV r18, r17;
	LADD r19, r0, r18;
	LD_RAW_PTR r20, r19, C0;
	LD_RAW_PTR r21, r20, u0;
	FADD r22, r21, r4;
	SHR r23.x, r2.x, 28;
	SHL r24.x, r2.x, 4;
	MOV_SWZ r25, r24.x, r23.x, r15.x, r15.x;
	MOV r26, r25;
	LADD r27, r1, r26;
	STORE_RAW_PTR u0, r27, r22;

	RET;

	END
