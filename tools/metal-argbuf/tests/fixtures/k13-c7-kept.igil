	PROGRAM
	SHADER c7

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 3,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_RESOURCE t0, 2D, FLOAT =
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 2, 0,
	  EMULATION_ARGUMENT, FALSE,
	  SAMPLER_NUM, [0]
	};

	DCL_CONSTANTREGISTER c0 =
	{
		SAMPLER_NORMALIZED_COORDS, 1, 0,
		SAMPLER_ADDRESS_MODE, 1, 0,
		UNUSED, 0, 0,
		UNUSED, 0, 0
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 2,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_SAMPLER s0 =
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 3, 0,
	  EMULATION_ARGUMENT, FALSE
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r71;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, u0;
	MOV r2.x, i0.x;



	MOV r71.x, 1;
	MOV r11.x, 0;
	MOV_SWZ r12, r11.x, r11.x, r11.x, r11.x;
	MOV r10, r12;
	MOV r9, r10;
	MOV r13.x, 8;
	MOV_SWZ r14, r13.x, r11.x, r11.x, r11.x;
	MOV r15, r14;
	LADD r16, r0, r15;
	LD_RAW_PTR r3, r16, C0;
	LD_RAW_PTR r4, r0, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r17, r4;
	MOV r18.x, r17;
	MOV r19.x, r4;
	ICMP.eq r20.x, r18.x, r19.x;
	AND r20.x, r20.x, 0x1;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r21, r3;
	MOV r22.x, r21;
	MOV r23.x, r3;
	ICMP.eq r24.x, r22.x, r23.x;
	AND r24.x, r24.x, 0x1;
	MOV r25.x, 0x00000000;
	MOV r26.x, 0x3F000000;
	MOV_SWZ r27, r26.x, r26.x, r25.x, r25.x;
	SAMPLE_L r5, r27(0, 0, 0), t[r18.x], s0[r22.x], r25, 2D;
	AND r30.x, r20.x, r24.x;

	MOV r31.x, 0;
	MOV r32.x, 1;
	MOV_CND.nz r33.x, r30.x, r32.x, r31.x;
	ICMP.ne r34.x, r33.x, r32.x;
	AND r34.x, r34.x, 0x1;
	MOV r71.x, r34.x;
	BREAK_CND.z r34.x;
	ENDLOOP;

	MOV r71.x, 1;
	MOV r37.x, r9;
	MOV r38.x, 0x00000000;
	MOV r39.x, 0x3F000000;
	MOV_SWZ r40, r39.x, r39.x, r38.x, r38.x;
	MOV r41.x, r40.x;
	MOV r42.x, r41.x;
	SHR r43.x, r42.x, 31;
	AND r44.x, r43.x, 1;
	MOV r45.x, 0xBF800000;
	MOV_CND.nz r46.x, r44.x, r45.x, r41.x;
	MOV_SWZ r47.xy, r46.x, r40.y, 0, 0;
	MOV r48.x, r47.y;
	MOV r49.x, r48.x;
	SHR r50.x, r49.x, 31;
	AND r51.x, r50.x, 1;
	MOV_CND.nz r52.x, r51.x, r45.x, r48.x;
	MOV_SWZ r53.xy, r47.x, r52.x, 0, 0;
	MOV r54.x, 2;
	ICMP.eq r55.x, c0.y, r54.x;
	AND r55.x, r55.x, 0x1;
	MOV_CND.nz r56, r55.x, r40, r53;
	MOV r57.x, 8;
	ICMP.eq r58.x, c0.x, r57.x;
	AND r58.x, r58.x, 0x1;
	MOV_CND.nz r59, r58.x, r40, r56;
	MOV r60.x, r10;
	SAMPLE_L r61, r59(0, 0, 0), t0, s0, r38, 2D;
	FADD r64, r61, r5;
	SHR r65.x, r2.x, 28;
	SHL r66.x, r2.x, 4;
	MOV r67.x, 0;
	MOV_SWZ r68, r66.x, r65.x, r67.x, r67.x;
	MOV r69, r68;
	LADD r70, r1, r69;
	STORE_RAW_PTR u0, r70, r64;

	RET;

	END
