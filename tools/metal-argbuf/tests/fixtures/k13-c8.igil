	PROGRAM
	SHADER c8

	VERSION_3_0

	DCL_THREADGROUP VARIABLE;

	DCL_UAVRAW u0, TRUE =
	{
	  KERNEL_ARGUMENT, 2,
	  LOCATION_INDEX, 1, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 16, 16
	};

	DCL_CONSTANTBUFFER C0=
	{
	  KERNEL_ARGUMENT, 0,
	  LOCATION_INDEX, 0, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_CONSTANTBUFFER C1=
	{
	  KERNEL_ARGUMENT, 1,
	  LOCATION_INDEX, 2, 0,
	  EMULATION_ARGUMENT, FALSE,
	  STRIDE, 8, 8
	};

	DCL_INPUT i0.xyz, THREAD_ID;

	DCL_TEMPS r0..r68;
	ADDRESS_OF r0, C0;
	ADDRESS_OF r1, C1;
	ADDRESS_OF r2, u0;
	MOV r3.x, i0.x;



	MOV r68.x, 1;
	MOV r67.x, 1;
	MOV r14.x, 0;
	MOV r15.x, 8;
	MOV_SWZ r16, r15.x, r14.x, r14.x, r14.x;
	MOV r17, r16;
	LADD r18, r0, r17;
	LD_RAW_PTR r4, r18, C0;
	LD_RAW_PTR r5, r0, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r19, r5;
	MOV r20.x, r19;
	MOV r21.x, r5;
	ICMP.eq r22.x, r20.x, r21.x;
	AND r22.x, r22.x, 0x1;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r23, r4;
	MOV r24.x, r23;
	MOV r25.x, r4;
	ICMP.eq r26.x, r24.x, r25.x;
	AND r26.x, r26.x, 0x1;
	MOV r27.x, 0x00000000;
	MOV r28.x, 0x3F000000;
	MOV_SWZ r29, r28.x, r28.x, r27.x, r27.x;
	SAMPLE_L r6, r29(0, 0, 0), t[r20.x], s0[r24.x], r27, 2D;
	AND r32.x, r22.x, r26.x;

	MOV r33.x, 0;
	MOV r34.x, 1;
	MOV_CND.nz r35.x, r32.x, r34.x, r33.x;
	ICMP.ne r36.x, r35.x, r34.x;
	AND r36.x, r36.x, 0x1;
	MOV r67.x, r36.x;
	BREAK_CND.z r36.x;
	ENDLOOP;

	MOV r67.x, 1;
	MOV r37.x, 0;
	MOV r38.x, 8;
	MOV_SWZ r39, r38.x, r37.x, r37.x, r37.x;
	MOV r40, r39;
	LADD r41, r1, r40;
	LD_RAW_PTR r7, r41, C0;
	LD_RAW_PTR r8, r1, C0;

	LOOP;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r42, r8;
	MOV r43.x, r42;
	MOV r44.x, r8;
	ICMP.eq r45.x, r43.x, r44.x;
	AND r45.x, r45.x, 0x1;
	GET_VALUE_FROM_FIRST_ACTIVE_LANE r46, r7;
	MOV r47.x, r46;
	MOV r48.x, r7;
	ICMP.eq r49.x, r47.x, r48.x;
	AND r49.x, r49.x, 0x1;
	MOV r50.x, 0x00000000;
	MOV r51.x, 0x3F000000;
	MOV_SWZ r52, r51.x, r51.x, r50.x, r50.x;
	SAMPLE_L r9, r52(0, 0, 0), t[r43.x], s0[r47.x], r50, 2D;
	AND r55.x, r45.x, r49.x;

	MOV r56.x, 0;
	MOV r57.x, 1;
	MOV_CND.nz r58.x, r55.x, r57.x, r56.x;
	ICMP.ne r59.x, r58.x, r57.x;
	AND r59.x, r59.x, 0x1;
	MOV r68.x, r59.x;
	BREAK_CND.z r59.x;
	ENDLOOP;

	MOV r68.x, 1;
	FADD r60, r9, r6;
	SHR r61.x, r3.x, 28;
	SHL r62.x, r3.x, 4;
	MOV r63.x, 0;
	MOV_SWZ r64, r62.x, r61.x, r63.x, r63.x;
	MOV r65, r64;
	LADD r66, r2, r65;
	STORE_RAW_PTR u0, r66, r60;

	RET;

	END
