	MOV r18.x, 288;
	IMUL r20.x, r19.x, r15.x, r18.x;
	IADD r21.x, r17.x, r19.x;
	SHR r22.x, r21.x, 4;
	MOV r23, C0[r22.x];
	AND r24.x, i0.x, 7;
	SHL r25.x, r24.x, 2;
	IADD r26.x, r25.x, r0.x;
