#!/usr/bin/env python3.14
"""place: put what `hao fetch` downloaded where the pipeline's input rows read it (a fresh store, no copies).

  place RELEASE.json CACHE [--dry-run]

For every download and asset of RELEASE.json, the row of that name is found as release-cut found it (the assembly's
pipeline/inputs/golden/BUILD, then the donor build, then common; first lock folder wins) and its file is put at the
row's PATH: a file as an APFS clone of CACHE/sha256/SHA256 (a copy elsewhere), a folder row's tar asset unpacked into
PATH, and an archive whose release class says `unpack` ({"strip": N, "into": "parent"}) unpacked with its first N path
parts dropped, into PATH's parent when `into` is parent (hao-runtime's public archive: its payload/ is the row). Every placed row is then checked as every build checks it (lock.py path: its sha256). A row already in place
and matching is left alone; one in place that does not match is refused, never overwritten. Before it is used, each
cached file is checked against the release's size and sha256 (64 lower-case hex digits), never through a link: an
archive is hashed as it is copied into an unlinked file of this process beside PATH and unpacked from that copy (what
is unpacked is what was checked, whoever can write the cache), and a file is cloned into a private folder beside PATH,
checked there and then moved to PATH.

Rows made on the Mac (the producers) and harvested rows are not downloads: they are listed as still missing. A placed
row that waits for files made on this Mac is listed as waiting; a made-on-Mac file that is a plain copy out of another
row (from_row + path_in_row, no producer) is copied here once that row is in place and checks, so running place again
after the producers completes such rows.
"""
import argparse, hashlib, json, os, re, shutil, stat, subprocess, sys, tarfile, tempfile
from pathlib import Path

TOP = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TOP / 'pipeline'))
import lock  # noqa: E402

CLASSES = json.loads((TOP / 'pipeline/release-classes.json').read_text())
CLASSES = CLASSES.get('rows', CLASSES)


def lock_folders(release):
    a = json.loads((TOP / 'pipeline/assemblies' / (release['assembly'] + '.json')).read_text())
    return [TOP / 'pipeline/inputs/golden' / a['golden_build'], TOP / 'pipeline/inputs' / a['donor_build'],
            TOP / 'pipeline/inputs/common']


def find_row(folders, name):
    for f in folders:
        if (f / name).is_file():
            want, p = lock.rows(str(f))[name]
            return f, want, Path(p)
    return None


MACHO = {b'\xca\xfe\xba\xbe', b'\xca\xfe\xba\xbf', b'\xcf\xfa\xed\xfe', b'\xce\xfa\xed\xfe'}


def clone(src, dest):
    """Clone SRC to DEST; mode 0755 for a Mach-O file (thin or universal: programs and libraries, as the producers
    leave them), 0644 otherwise. The fetch cache keeps every file 0644."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    if subprocess.run(['cp', '-c', str(src), str(dest)], capture_output=True).returncode:
        shutil.copy2(src, dest)
    with open(dest, 'rb') as f:
        dest.chmod(0o755 if f.read(4) in MACHO else 0o644)


HEX = re.compile(r'[0-9a-f]{64}')
CHUNK = 1 << 20


class PlaceError(RuntimeError):
    pass


def sha256_fd(fd):
    h, off = hashlib.sha256(), 0
    while block := os.pread(fd, CHUNK, off):
        h.update(block)
        off += len(block)
    return h.hexdigest()


def check_fd(fd, entry, what):
    """Refuse the open file FD unless it is a regular file with ENTRY's size and sha256."""
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        raise PlaceError('%s is not a regular file' % what)
    if st.st_size != entry['size']:
        raise PlaceError('%s has %d bytes; the release pins %d' % (what, st.st_size, entry['size']))
    digest = sha256_fd(fd)
    if digest != entry['sha256']:
        raise PlaceError('%s has sha256 %s; the release pins %s' % (what, digest, entry['sha256']))


def open_checked(path, entry):
    """PATH open for reading (never through a link), checked against ENTRY's size and sha256."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as x:
        raise PlaceError('%s: %s' % (path, x.strerror))
    try:
        check_fd(fd, entry, str(path))
    except BaseException:
        os.close(fd)
        raise
    return os.fdopen(fd, 'rb')


def private_copy(path, entry, near):
    """A private copy of PATH (opened without following a link) checked against ENTRY's size and sha256: the bytes are
    hashed as they are copied into a file this process created (mode 0600) in folder NEAR and unlinked at once, so
    no one can open or change it, and it is what is read after the check. The open copy, at its start."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as x:
        raise PlaceError('%s: %s' % (path, x.strerror))
    out = None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise PlaceError('%s is not a regular file' % path)
        near.mkdir(parents=True, exist_ok=True)
        out = tempfile.TemporaryFile(dir=near)
        st = os.fstat(out.fileno())
        if st.st_nlink != 0 or st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) & 0o077:
            raise PlaceError('the private copy of %s in %s is not private' % (path, near))
        h, size = hashlib.sha256(), 0
        while block := os.read(fd, CHUNK):
            h.update(block)
            out.write(block)
            size += len(block)
        if size != entry['size']:
            raise PlaceError('%s has %d bytes; the release pins %d' % (path, size, entry['size']))
        if h.hexdigest() != entry['sha256']:
            raise PlaceError('%s has sha256 %s; the release pins %s' % (path, h.hexdigest(), entry['sha256']))
        out.flush()
        out.seek(0)
        return out
    except BaseException:
        if out is not None:
            out.close()
        raise
    finally:
        os.close(fd)


def entry_problem(entry):
    """What is wrong with a release entry's row name, size or sha256, or None."""
    row = entry.get('row')
    if not isinstance(row, str) or not row or row in ('.', '..') or any(c in row for c in '/\\\0'):
        return 'row %r is not a plain name' % (row,)
    if entry.get('stream'):
        return None
    if not isinstance(entry.get('sha256'), str) or not HEX.fullmatch(entry['sha256']):
        return '%s: sha256 %r is not 64 lower-case hex digits' % (row, entry.get('sha256'))
    if not isinstance(entry.get('size'), int) or isinstance(entry['size'], bool) or entry['size'] < 0:
        return '%s: size %r is not a whole number of bytes' % (row, entry.get('size'))
    return None


def place_copy(src, dest, entry):
    """Clone SRC into a private folder beside DEST, check the copy on its open file, then move it to DEST."""
    if not stat.S_ISREG(os.lstat(src).st_mode):
        raise PlaceError('%s is not a regular file' % src)
    dest.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix='.place-', dir=dest.parent))
    try:
        copy = stage / dest.name
        clone(src, copy)
        open_checked(copy, entry).close()
        os.rename(copy, dest)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def tar_open(src):
    return tarfile.open(src) if isinstance(src, (str, Path)) else tarfile.open(fileobj=src, mode='r:*')


def unpack(src, dest):
    dest.mkdir(parents=True, exist_ok=True)
    with tar_open(src) as t:
        t.extractall(dest, filter='data')


def unpack_archive(src, dest, how):
    """Unpack SRC (any tar, compressed or not; a path or an open file) with its first `strip` path parts dropped,
    into DEST or its parent."""
    strip, into = int(how.get('strip', 0)), dest.parent if how.get('into') == 'parent' else dest
    into.mkdir(parents=True, exist_ok=True)
    with tar_open(src) as t:
        members = []
        for m in t.getmembers():
            parts = Path(m.name).parts
            if len(parts) <= strip:
                continue
            m.name = '/'.join(parts[strip:])
            if m.islnk():
                m.linkname = '/'.join(Path(m.linkname).parts[strip:])
            members.append(m)
        t.extractall(into, members=members, filter='data')


def made_label(m):
    return m.get('producer') or 'a copy out of row %s' % m['from_row']


def copy_made(folders, name, dest):
    """Copy the plain from-row files of row NAME into DEST; return the ones whose source row is not in place yet."""
    pending = []
    for m in CLASSES.get(name, {}).get('made_on_mac_files', []):
        if m.get('producer') or not m.get('path_in_row'):
            continue
        found = find_row(folders, m['from_row'])
        try:
            if found is None or not found[2].exists():
                raise SystemExit('not in place')
            lock.path(str(found[0]), m['from_row'])
        except SystemExit:
            pending.append(m)
            continue
        clone(found[2] / m['path_in_row'], dest / m['path'])
    return pending


def check_or_wait(folders, folder, name, dest, waiting, problems):
    """Check a placed row, after its plain copies; True if it matches, else it is listed as waiting or a problem."""
    if dest.is_dir():
        copy_made(folders, name, dest)
    try:
        lock.path(str(folder), name)
        return True
    except SystemExit as e:
        made = CLASSES.get(name, {}).get('made_on_mac_files')
        if made:
            waiting.append('%s: placed; waits for %d file(s) made on this Mac (%s)'
                           % (name, len(made), '; '.join(sorted({made_label(m) for m in made}))))
        else:
            problems.append('%s: placed, but the row check fails: %s' % (name, e))
        return False


def place(release_path, cache, dry_run=False, out=print):
    release = json.loads(Path(release_path).read_text())
    folders = lock_folders(release)
    placed, kept, problems, waiting, streamed = [], [], [], [], []
    entries = [(d, 'file') for d in release.get('downloads', [])] + \
              [(a, a.get('format', 'file')) for a in release.get('assets', [])]
    for entry, form in entries:
        if entry.get('role') in ('bootstrap', 'builder-kit'):
            continue  # consumed before hao starts; not an installed input row
        bad = entry_problem(entry)
        if bad:
            problems.append(bad)
            continue
        name = entry['row']
        found = find_row(folders, name)
        if found is None:
            problems.append('%s: no input row of that name' % name)
            continue
        folder, want, dest = found
        if entry.get('stream'):
            streamed.append(name)              # read by range by its producers (make-on-mac), never placed
            continue
        src = Path(cache) / 'sha256' / entry['sha256']
        if not src.is_file():
            problems.append('%s: not fetched (%s missing; run hao fetch)' % (name, src))
            continue
        if dest.exists():
            if CLASSES.get(name, {}).get('made_on_mac_files'):
                if not dry_run and check_or_wait(folders, folder, name, dest, waiting, problems):
                    kept.append(name)
                continue
            try:
                lock.path(str(folder), name)
                kept.append(name)
            except SystemExit as e:
                problems.append('%s: %s is there and is not the row\'s bytes (%s); not overwritten' % (name, dest, e))
            continue
        pinned = CLASSES.get(name, {}).get('source_sha256')
        if pinned and entry['sha256'] != pinned:
            # an archive this checkout pins (its producers run from it): only those bytes are unpacked
            problems.append('%s: the release names %s, not the archive this checkout pins (%s); not placed'
                            % (name, entry['sha256'], pinned))
            continue
        if not dry_run:
            how = CLASSES.get(name, {}).get('unpack')
            try:
                if how or form == 'tar':
                    with private_copy(src, entry, dest.parent) as f:
                        if how:
                            unpack_archive(f, dest, how)
                        else:
                            unpack(f, dest)
                else:
                    place_copy(src, dest, entry)
            except PlaceError as x:
                problems.append('%s: %s; not placed' % (name, x))
                continue
            if not check_or_wait(folders, folder, name, dest, waiting, problems):
                continue
        placed.append(name)
    made = [m['row'] for m in release.get('made_on_mac', [])]
    harvested = [h if isinstance(h, str) else h.get('row') for h in release.get('harvested', [])]
    missing = [r for r in made + harvested if find_row(folders, r) is None or not find_row(folders, r)[2].exists()]
    out('placed %d, already there %d, waiting for made-on-Mac files %d, problems %d%s'
        % (len(placed), len(kept), len(waiting), len(problems),
           ', read by range when made: ' + ' '.join(streamed) if streamed else ''))
    for w in waiting:
        out('  ~ ' + w)
    for p in problems:
        out('  ! ' + p)
    if missing:
        out('still missing (made on this Mac or harvested): ' + ' '.join(missing))
    return placed, kept, problems, missing


def main():
    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    p.add_argument('release'); p.add_argument('cache'); p.add_argument('--dry-run', action='store_true')
    a = p.parse_args()
    return 1 if place(a.release, a.cache, a.dry_run)[2] else 0


if __name__ == '__main__':
    sys.exit(main())
