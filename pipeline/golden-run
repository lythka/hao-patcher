"""golden-run RECIPE --repo EXPERIMENTAL_IMAGE_REPOSITORY: GG-first assembly in an isolated VZ builder."""
import argparse
from contextlib import contextmanager
import datetime
import hashlib
import json
import os
from pathlib import Path
import runpy
import shlex
import shutil
import signal
import subprocess
import sys
import time
import tempfile
import uuid
import zipfile

TOP = Path(__file__).resolve().parent.parent
GUEST = '/private/var/ssdshare'


def q(value):
    return shlex.quote(str(value))


def write(path, data):
    Path(path).write_text(json.dumps(data, indent=2)+'\n')


def digest(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda: stream.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


@contextmanager
def builder_lock(path, owner):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.mkdir()  # The builder lock shared with pipeline/run; never steal a held lock.
    try:
        (path/'owner').write_text(owner+'\n')
        yield
    finally:
        (path/'owner').unlink()
        path.rmdir()


def create_workspace_image(path, size_bytes):
    with Path(path).open('xb') as stream:
        stream.truncate(size_bytes)
    Path(path).chmod(0o644)


# Every golden set starts with these two: every later recipe edits the kernel collections and userspace they produce.
FIRST_RECIPES = ('darwin27-kernel', 'golden-gate-userspace')


def set_order(share):
    """The set's (stage, name, staged folder) rows in set order, after checking that set order is run order:
    darwin27-kernel then golden-gate-userspace first, every oclp-hook recipe through src/kc-hook.sh only
    (golden-image.py runs them in one loop), and no oclp-hook after a post (posts run after the snapshot)."""
    rows = []
    for number, line in enumerate((share/'patches.txt').read_text().splitlines(), 1):
        stage, name, *inputs = line.split()
        rows.append((stage, name, '%02d-%s' % (number, name)))
    hooks = [name for stage, name, _ in rows if stage == 'oclp-hook']
    if tuple(hooks[:2]) != FIRST_RECIPES:
        raise ValueError('a golden set must start with darwin27-kernel then golden-gate-userspace (found %s): every '
                         'later recipe edits the kernel collections and userspace those two produce' % ', '.join(hooks[:2]))
    for stage, name, folder in rows:
        if stage != 'oclp-hook':
            continue
        if (share/'hooks'/folder/'hook.sh').is_file():
            raise ValueError(name+': src/hook.sh is the Tahoe-first runner\'s OCLP hook; golden sets run each recipe '
                             'once, in set order, through src/kc-hook.sh')
        if not (share/'hooks'/folder/'kc-hook.sh').is_file():
            raise ValueError(name+': an oclp-hook recipe in a golden set needs src/kc-hook.sh')
    stages = [stage for stage, _, _ in rows]
    if 'post' in stages and 'oclp-hook' in stages[stages.index('post'):]:
        raise ValueError('a post recipe precedes an oclp-hook recipe; posts run after the snapshot, so list them last '
                         'and the set reads in run order')
    return rows


def guest_config(recipe, share, local):
    rows = set_order(share)
    hooks = [(name, folder) for stage, name, folder in rows if stage == 'oclp-hook']
    selected = dict(hooks)
    kdk, = (share/'kdk').iterdir()
    return dict(image=local+'/target.img', work=local+'/work',size_bytes=recipe['size_bytes'],name=recipe['name'],
                python=local+'/py/bin/python3.12',layout_helper=local+'/source/golden-layout.py',
                pristine_script=local+'/source/golden-pristine.sh',
                # Base layers read two recipe inputs: the 27.x filesystem (golden-system) and the x86_64 kernel file
                # (golden-finalize: the hardware overlay checks its Darwin version; darwin27-kernel links around it).
                payload=GUEST+'/hooks/'+selected['golden-gate-userspace']+'/inputs/golden_gate_userspace',
                kernel=local+'/hooks/'+selected['darwin27-kernel']+'/inputs/darwin27_kernel',kdk=GUEST+'/kdk/'+kdk.name,
                kdk_preparer=local+'/source/kdk_intel_payload.py',fl=local+'/source/fl',
                donor_tool=local+'/source/tahoe-donors/make',
                donors={role:GUEST+'/assembly-inputs/'+role for role in ('native','extensions','boot','driverkit','recovery')},
                esp=local+'/source/esp',hardware=dict(tool=local+'/source/hardware/apply',artifact=GUEST+'/assembly-inputs/hardware'),
                hooks=[dict(name=name,kc_hook=local+'/hooks/'+folder+'/kc-hook.sh') for name,folder in hooks],
                posts=[dict(name=name,script=local+'/post/'+folder+'/apply.sh',folder=local+'/post/'+folder)
                       for stage,name,folder in rows if stage=='post'],
                environment=dict(PYTHONPATH=local+'/site',PYTHONDONTWRITEBYTECODE='1',TMPDIR=local+'/tmp',S=GUEST,OCLP=GUEST+'/oclp'))


def job_script(local, share=GUEST, owner='root:wheel', workspace=None):
    """Execute source locally, retain logs even on failure, and publish completion last."""
    workspace_script=''
    if workspace:
        helper=(TOP/'pipeline/stages/golden-workspace.py').read_text()
        marker='GOLDEN_WORKSPACE_'+uuid.uuid4().hex
        workspace_script=('"$G/py/bin/python3.12" -I - --size-bytes '+str(workspace['size_bytes'])+
                          ' --mount '+q(workspace['mount'])+' --name '+q(workspace['name'])+
                          ' --record "$G/out-golden/workspace.json" --source-sha256 '+hashlib.sha256(helper.encode()).hexdigest()+
                          " <<'"+marker+"'\n"+helper+'\n'+marker+'\n')
    return '''set -u
set -o pipefail
umask 022
G=%s
W=%s
install -d -m 755 "$G/out-golden"
exec >"$G/out-golden/golden.log" 2>&1
rc=0
prepare_workspace() {
%s
}
prepare_workspace || rc=$?
if [ "$rc" = 0 ]; then
    install -d -m 755 "$W/source" "$W/hooks" "$W/post" "$W/py" "$W/site" "$W/tmp"
fi
export TMPDIR="$W/tmp"
echo "Maintenance storage before assembly:"
df -k "$W"
bootstrap() {
    (cd "$G/assembly-source" && tar -cf - .) | (cd "$W/source" && tar -xf -) || return $?
    (cd "$G/py" && tar -cf - .) | (cd "$W/py" && tar -xf -) || return $?
    (cd "$G/site" && tar -cf - .) | (cd "$W/site" && tar -xf -) || return $?
    "$W/py/bin/python3.12" -I "$W/source/copy-hooks.py" "$G/hooks" "$W/hooks" --owner %s || return $?
    (cd "$G/post" && tar -cf - .) | (cd "$W/post" && tar -xf -) || return $?
    chown -R %s "$W/source" "$W/py" "$W/site" "$W/post" || return $?
}
[ "$rc" != 0 ] || bootstrap || rc=$?
echo "Maintenance storage after local source/hook copies:"
df -k "$W"
if [ "$rc" = 0 ]; then
    PYTHONPATH="$W/site" "$W/py/bin/python3.12" -I "$W/source/golden-image.py" "$G/guest-config.json"
    rc=$?
fi
# Never infer completion from nested pristine/hook RESULT lines.
if [ -d "$W/work" ]; then
    mkdir -p "$G/out-golden/guest"
    (cd "$W/work" && tar -cf - .) | (cd "$G/out-golden/guest" && tar -xf -) || { export_rc=$?; [ "$rc" != 0 ] || rc=$export_rc; }
fi
if [ "$rc" = 0 ] && [ %s = legacy ]; then
    (cd "$W" && tar -cf - target.img) | (cd "$G/out-golden" && tar -xf -) || rc=$?
fi
sync
printf 'RESULT rc=%%s\\n' "$rc"
printf '%%s\\n' "$rc" > "$G/out-golden/result.new"
mv "$G/out-golden/result.new" "$G/out-golden/result"
''' % (q(share),q(local),workspace_script or ':',q(owner),q(owner),'workspace' if workspace else 'legacy')


def wait_job(output, timeout, poll=5):
    deadline = time.monotonic()+timeout
    offset = 0
    while True:
        log = output/'golden.log'
        if log.exists():
            with log.open() as stream:
                stream.seek(offset); text=stream.read();offset=stream.tell()
            if text:
                print(text,end='',flush=True)
        result = output/'result'
        if result.exists():
            return int(result.read_text().strip())
        if time.monotonic() >= deadline:
            raise TimeoutError('Golden guest has no final completion; logs: '+str(output))
        time.sleep(poll)


def assembled(output):
    record = json.loads((output/'guest/build.json').read_text())
    if record['status'] != 'assembled' or record['attached_device'] is not None:
        raise RuntimeError('guest image is not successfully assembled and detached')
    return record


def skipped_groups(recipe, skip_optional=()):
    """Optional patch groups to leave out: the assembly's "skip_optional" list plus --skip-optional."""
    groups=recipe.get('skip_optional',[])
    if not isinstance(groups,list) or not all(isinstance(g,str) and g for g in groups):
        raise ValueError('assembly skip_optional must be a list of optional group names')
    return sorted(set(groups)|set(skip_optional))


def run(recipe_path, repository, work=None, record=None, base=None, timeout=14400, skip_optional=()):
    recipe_path = Path(recipe_path).resolve(); recipe=json.loads(recipe_path.read_text())
    if recipe['schema'] != 1:
        raise ValueError('unsupported Golden assembly recipe')
    skip=skipped_groups(recipe,skip_optional)
    pipeline=TOP/'pipeline';store=(TOP/'store').resolve()
    stamp=datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:6]
    job='golden-'+recipe['golden_build']+'-'+stamp
    work=Path(work).resolve() if work else store/'tmp'/job
    record=Path(record).resolve() if record else store/'runs'/job
    repository=Path(repository).resolve();share=work/'share'
    workspace=dict(size_bytes=recipe.get('workspace_size_bytes',160*1024**3),
                   mount='/Volumes/builder-work-'+stamp,name='builder-work-'+stamp)
    local=workspace['mount']+'/job'
    workspace_image=work/'workspace.img'
    work.mkdir(parents=True,exist_ok=False);record.mkdir(parents=True,exist_ok=False)
    env=dict(os.environ,VMBIN=os.environ.get('VMBIN',str(store/'vm/bin')),VMCTL=str(pipeline/'vm/vmctl'),
             GOLDEN_LOCK=str(pipeline/'inputs/golden'/recipe['golden_build']),SKIP_OPTIONAL=' '.join(skip))
    state=dict(unit='pipeline',operation='golden-first',recipe=recipe,recipe_sha256=digest(recipe_path),
               workspace=str(TOP),work=str(work),repository=str(repository),guest_local=local,
               guest_workspace=dict(workspace,image=str(workspace_image)),
               commit=subprocess.check_output(['git','-C',str(TOP),'rev-parse','HEAD'],text=True).strip(),
               dirty=bool(subprocess.check_output(['git','-C',str(TOP),'status','--porcelain'],text=True)),
               status='staging',validation='BUILD ONLY; QEMU/native/fresh-install acceptance remains separate')
    shutil.copy2(recipe_path,record/'assembly.json')
    write(record/'build.json',state)
    vm=None;started=False
    def command(args, **kwargs):
        print('+ '+shlex.join(map(str,args)),flush=True)
        return subprocess.run(list(map(str,args)),env=env,check=True,**kwargs)
    def stop():
        nonlocal started
        if started:
            command(['zsh',pipeline/'vm/stop.sh',vm]);started=False
    lock=store/'tmp/builder.lock'
    with builder_lock(lock,job+' pid='+str(os.getpid())):
        try:
            lockrows=runpy.run_path(str(pipeline/'lock.py'))
            build_lock=pipeline/'inputs'/recipe['donor_build'];common=pipeline/'inputs/common'
            # Rows of the Golden Gate build come first: inputs/golden/<golden_build>, then the donor build, then common.
            golden_lock=pipeline/'inputs/golden'/recipe['golden_build']
            def lock_of(row):
                return next(d for d in (golden_lock,build_lock,common) if (d/row).is_file())
            command(['zsh',pipeline/'stages/inputs.sh',share,pipeline/'targets'/(recipe['target']+'.json'),
                     build_lock,common,recipe['oclp'],pipeline/'sets'/(recipe['patch_set']+'.txt'),'golden-first'])
            set_order(share)  # refuse a set whose order is not its run order before any further staging
            # Which optional patches (e.g. harvested caches) ran or were skipped, and why.
            state['optional']=json.loads((share/'optional.json').read_text());write(record/'build.json',state)
            shutil.copy2(share/'optional.json',record/'optional.json')
            used_rows=set(recipe['inputs'].values()) | {'kdk','python_arm64','python_site','fl','opencore_debug'}
            for line in (share/'patches.txt').read_text().splitlines():
                used_rows.update(line.split()[2:])
            manifest=(share/'MANIFEST.txt').read_text()
            psp_line=next(line for line in manifest.splitlines() if 'PatcherSupportPkg ' in line)
            used_rows.add('psp_'+psp_line.split('PatcherSupportPkg ',1)[1].split()[0])
            input_records={}
            for row in sorted(used_rows):
                row_lock=lock_of(row)
                value=lockrows['rows'](str(row_lock))[row]
                input_records[row]=dict(sha256=value[0],path=value[1],row=(row_lock/row).read_text())
            write(record/'inputs.json',input_records)
            sources={}
            extras=share/'assembly-inputs';extras.mkdir(mode=0o755)
            for role,row in recipe['inputs'].items():
                source=Path(lockrows['path'](str(lock_of(row)),row))
                command(['ditto',source,extras/role]);sources[role]=dict(row=row,path=str(source))
                if (source/'build.json').exists():shutil.copy2(source/'build.json',record/(role+'-input.json'))
            source=share/'assembly-source';source.mkdir(mode=0o755)
            for name in ('golden-image.py','golden-layout.py','golden-pristine.sh','golden-workspace.py'):
                shutil.copy2(pipeline/'stages'/name,source/name)
            shutil.copy2(pipeline/'stages/copy-hooks.py',source/'copy-hooks.py')
            shutil.copy2(share/'oclp/opencore_legacy_patcher/sys_patch/utilities/kdk_intel_payload.py',source/'kdk_intel_payload.py')
            shutil.copy2(share/'pristine/fl',source/'fl')
            shutil.copytree(TOP/'tools/tahoe-donors',source/'tahoe-donors',ignore=shutil.ignore_patterns('__pycache__'))
            shutil.copytree(extras/'hardware/install-tools',source/'hardware')
            command([share/'py/bin/python3.12','-I',pipeline/'stages/build-efi.py',
                     '--source',share/'oclp','--site',share/'site',
                     '--target',pipeline/'targets'/(recipe['target']+'.json'),
                     '--revision',recipe['oclp'],'--opencore',lockrows['path'](str(lock_of('opencore_debug')),'opencore_debug'),
                     '--out',source/'esp','--record',record/'base-efi.json'])
            config=guest_config(recipe,share,local);write(share/'guest-config.json',config)
            shutil.copy2(share/'guest-config.json',record/'guest-config.json')
            for name in ('patches.txt','MANIFEST.txt','profile.json'):
                shutil.copy2(share/name,record/name)
            state.update(inputs=sources,source_files={str(p.relative_to(source)):digest(p) for p in source.rglob('*') if p.is_file() and not p.is_symlink()},status='starting')
            clone=command([sys.executable,'-I',pipeline/'vm/clones.py','clone',job,'--base',base or store/'vm/base'],capture_output=True,text=True)
            vm=Path(json.loads(clone.stdout)['vm']);state['vm']=str(vm);write(record/'build.json',state)
            create_workspace_image(workspace_image,workspace['size_bytes'])
            started=True
            command([sys.executable,'-I',pipeline/'vm/clones.py','start',vm,share,'--usb',workspace_image])
            script=job_script(local,workspace=workspace)
            (record/'guest-job.sh').write_text(script)
            submission='(\n'+script+'\n) >/dev/null 2>&1 </dev/null & echo started'
            reply=command([pipeline/'vm/vmctl',vm,'exec',submission],capture_output=True,text=True)
            if reply.stdout.strip()!='started':raise RuntimeError('guest start reply uncertain; do not resubmit automatically')
            state['status']='assembling';write(record/'build.json',state)
            output=share/'out-golden';rc=wait_job(output,timeout)
            if rc:raise RuntimeError('Golden guest failed with status '+str(rc)+'; inspect '+str(output))
            assembled(output);stop()
            state['status']='capturing';write(record/'build.json',state)
            capture_workspace(state,output,command)
        except BaseException as error:
            state.update(status='failed',error=str(error))
            raise
        finally:
            try:stop()
            except Exception as error:state['stop_error']=str(error)
            output=share/'out-golden'
            if output.exists():
                record_output=record/'guest-output';record_output.mkdir(exist_ok=True)
                for item in output.iterdir():
                    if item.name=='target.img':continue
                    if item.is_dir():shutil.copytree(item,record_output/item.name,dirs_exist_ok=True,symlinks=True)
                    else:shutil.copy2(item,record_output/item.name)
            write(record/'build.json',state)
    print('Golden image committed: '+str(repository),flush=True)
    print('Record: '+str(record),flush=True)
    return state



@contextmanager
def readonly_workspace(state, command):
    """Read a cleanly stopped builder workspace; never format or alter host disks."""
    vm=Path(state['vm'])
    if runpy.run_path(str(TOP/'pipeline/vm/clones.py'))['running'](vm):
        raise RuntimeError('builder must be stopped before mounting its workspace')
    workspace=state['guest_workspace']
    relative=Path(state['guest_local']).relative_to(workspace['mount'])/'target.img'
    if '..' in relative.parts:
        raise ValueError('image path leaves the workspace')
    with tempfile.TemporaryDirectory(prefix='golden-capture-') as directory:
        mount=Path(directory)/'source';mount.mkdir()
        attached=False
        try:
            command(['hdiutil','attach','-readonly','-nobrowse','-mountpoint',mount,workspace['image']],capture_output=True)
            attached=True
            image=mount/relative
            if not image.is_file() or image.is_symlink() or image.stat().st_size!=state['recipe']['size_bytes']:
                raise ValueError('completed workspace image is missing or has the wrong size')
            yield image
        finally:
            if attached:command(['hdiutil','detach',mount],capture_output=True)


# The exported EFI redistributes OpenCore and OCLP-generated files: their license texts go with it.
EFI_LICENSES={'LICENSES/OpenCorePkg-LICENSE.txt':TOP/'pipeline/licenses/OpenCorePkg-LICENSE.txt',
              'LICENSES/OpenCore-Legacy-Patcher-LICENSE.txt':TOP/'tools/oclp-integration/LICENSE.txt'}


def boot_efi_archive(prepared,repository):
    """boot-efi.zip from the guest's prepared EFI (payload/, manifest.json) plus EFI_LICENSES."""
    archive=shutil.make_archive(str(Path(repository)/'boot-efi'),'zip',root_dir=prepared)
    with zipfile.ZipFile(archive,'a',zipfile.ZIP_DEFLATED) as bundle:
        for name,source in EFI_LICENSES.items():bundle.write(source,name)
    return archive


def capture_workspace(state,output,command):
    assembled(output)
    repository=Path(state['repository'])
    ssdimg=Path(os.environ.get('SSDIMG',str(TOP/'tools/bin/ssdimg')))
    with readonly_workspace(state,command) as image:
        if not (repository/'image.json').exists():command([ssdimg,'init',repository])
        command([ssdimg,'-C',repository,'capture','--force',image])
        command([ssdimg,'-C',repository,'fsck'])
        command([ssdimg,'-C',repository,'commit','-m','Golden Gate '+state['recipe']['golden_build']+'; '+state['commit']])
    prepared=output/'guest/boot-efi'
    if prepared.exists() and json.loads((prepared/'manifest.json').read_text())['kernel_repairs_applied']:
        archive=boot_efi_archive(prepared,repository)
        state['boot_efi']=dict(path=archive,sha256=digest(archive),manifest=json.loads((prepared/'manifest.json').read_text()))
    state.update(status='committed',capture_source='read-only stopped builder workspace',capture_tool_sha256=digest(Path(__file__)))


def capture_record(record):
    record=Path(record).resolve();state=json.loads((record/'build.json').read_text())
    output=Path(state['work'])/'share/out-golden'
    assembled(output)
    def command(args,**kwargs):
        print('+ '+shlex.join(map(str,args)),flush=True)
        return subprocess.run(list(map(str,args)),check=True,**kwargs)
    with builder_lock(TOP/'store/tmp/builder.lock','capture completed image pid='+str(os.getpid())):
        state['previous_capture_status']=dict(status=state['status'],error=state.pop('error',None))
        try:
            capture_workspace(state,output,command)
        finally:write(record/'build.json',state)
    print('Golden image committed: '+state['repository'],flush=True)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('recipe',type=Path,nargs='?');parser.add_argument('--repo',type=Path)
    parser.add_argument('--capture-record',type=Path,help='capture a successfully assembled image from its stopped builder workspace')
    parser.add_argument('--work',type=Path);parser.add_argument('--record',type=Path);parser.add_argument('--base',type=Path)
    parser.add_argument('--timeout',type=int,default=14400)
    parser.add_argument('--skip-optional',action='append',default=[],metavar='GROUP',
                        help='leave out the optional patches of GROUP (e.g. caches) even when their inputs are there')
    args=parser.parse_args()
    signal.signal(signal.SIGTERM,lambda *_:(_ for _ in ()).throw(KeyboardInterrupt('terminated')))
    if args.capture_record:
        if args.recipe or args.repo or args.skip_optional:parser.error('capture-record does not take a recipe, repository or --skip-optional')
        capture_record(args.capture_record)
    else:
        if not args.recipe or not args.repo:parser.error('recipe and --repo are required')
        run(args.recipe,args.repo,args.work,args.record,args.base,args.timeout,args.skip_optional)


if __name__=='__main__':main()
