def source_identity():
    """{commit, dirty} of this checkout: from git, or on a Mac without git from TOP/.hao-source (written when the
    source archive was fetched: {"commit": ..., "source": URL}); dirty is then None (unknown)."""
    try:
        git=['git','-c','safe.directory='+str(TOP),'-C',str(TOP)]   # this checkout only: it may be a user's, run under sudo
        commit=subprocess.run(git+['rev-parse','HEAD'],capture_output=True,text=True,check=True).stdout.strip()
        dirty=bool(subprocess.run(git+['status','--porcelain'],capture_output=True,text=True,check=True).stdout)
        return dict(commit=commit,dirty=dirty)
    except (OSError,subprocess.CalledProcessError):
        marker=TOP/'.hao-source'
        if marker.is_file():
            data=json.loads(marker.read_text())
            return dict(commit=data['commit'],dirty=None,source=data.get('source'))
        raise SystemExit('golden-run: no git and no .hao-source: cannot say which source this build is from')


def opencore_row_of(recipe):
    """The OpenCore archive row: RELEASE by default (a normal boot shows no OpenCore text; owner 2026-11-13), DEBUG
    only when the assembly says "opencore": "debug" (diagnosis: early OpenCore lines on screen, full ESP log)."""
    variant=recipe.get('opencore','release')
    if variant not in ('release','debug'):
        raise SystemExit('assembly "opencore" is release or debug, not %r' % variant)
    return 'opencore_'+variant

def q(value):
    return shlex.quote(str(value))


def write(path, data):
    Path(path).write_text(json.dumps(data, indent=2)+'\n')


def digest(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda: stream.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


@contextmanager
def builder_lock(path, owner):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.mkdir()  # The builder lock shared with pipeline/run; never steal a held lock.
    try:
        (path/'owner').write_text(owner+'\n')
        yield
    finally:
        (path/'owner').unlink()
        path.rmdir()


def create_workspace_image(path, size_bytes):
    with Path(path).open('xb') as stream:
        stream.truncate(size_bytes)
    Path(path).chmod(0o644)


# Every golden set starts with these two: every later recipe edits the kernel collections and userspace they produce.
FIRST_RECIPES = ('darwin27-kernel', 'golden-gate-userspace')


def set_order(share):
    """The set's (stage, name, staged folder) rows in set order, after checking that set order is run order:
    darwin27-kernel then golden-gate-userspace first, every oclp-hook recipe through src/kc-hook.sh only
    (golden-image.py runs them in one loop), and no oclp-hook after a post (posts run after the snapshot)."""
    rows = []
    for number, line in enumerate((share/'patches.txt').read_text().splitlines(), 1):
        stage, name, *inputs = line.split()
        rows.append((stage, name, '%02d-%s' % (number, name)))
    hooks = [name for stage, name, _ in rows if stage == 'oclp-hook']
    if tuple(hooks[:2]) != FIRST_RECIPES:
        raise ValueError('a golden set must start with darwin27-kernel then golden-gate-userspace (found %s): every '
                         'later recipe edits the kernel collections and userspace those two produce' % ', '.join(hooks[:2]))
    for stage, name, folder in rows:
        if stage != 'oclp-hook':
            continue
        if (share/'hooks'/folder/'hook.sh').is_file():
            raise ValueError(name+': src/hook.sh is the Tahoe-first runner\'s OCLP hook; golden sets run each recipe '
                             'once, in set order, through src/kc-hook.sh')
        if not (share/'hooks'/folder/'kc-hook.sh').is_file():
            raise ValueError(name+': an oclp-hook recipe in a golden set needs src/kc-hook.sh')
    stages = [stage for stage, _, _ in rows]
    if 'post' in stages and 'oclp-hook' in stages[stages.index('post'):]:
        raise ValueError('a post recipe precedes an oclp-hook recipe; posts run after the snapshot, so list them last '
                         'and the set reads in run order')
    return rows


CRYPTEX_CACHE_KEEP = 2   # entries kept in store/cache/cryptex (about 13 GB each), the newest first


def userspace_folder(share):
    """SHARE/hooks/NN-golden-gate-userspace, the staged recipe."""
    return share/'hooks'/dict((name, folder) for _, name, folder in set_order(share))['golden-gate-userspace']


def prepare_cryptex_cache(recipe, share, store, lockrows, locks):
    """Write SHARE/cryptex-cache/key.json (the host part of golden-gate-userspace's cryptex key, its
    src/cryptex_cache.py) and clone every entry of STORE (store/cache/cryptex) with that host key into in/KEY/,
    where the guest finds the one whose full key (with its tool lines) matches. Returns the record for build.json."""
    folder=userspace_folder(share)
    cache=runpy.run_path(str(folder/'cryptex_cache.py'))
    def row(name):
        lock=next(Path(l) for l in locks if (Path(l)/name).is_file())
        return lockrows['key_line']('row:'+name,str(TOP/'store'),[str(l) for l in locks]),lockrows['rows'](str(lock))[name][1]
    lines=cache['host_lines'](folder,{name:row(name) for name in cache['ROWS']},row(recipe['inputs']['driverkit']),
                              share/'assembly-source/tahoe-donors')
    host_key=cache['key_of'](lines)
    out=share/'cryptex-cache';(out/'in').mkdir(parents=True)
    write(out/'key.json',dict(host_key=host_key,host_lines=lines))
    staged=[]
    for entry in sorted(Path(store).glob('*/entry.json')) if Path(store).is_dir() else []:
        data=json.loads(entry.read_text())
        if data.get('lines',[])[:len(lines)]!=lines:continue
        target=out/'in'/entry.parent.name
        # APFS clones: free, and the guest's copy can never write into the store
        subprocess.run(['cp','-cR',str(entry.parent),str(target)],check=True)
        staged.append(entry.parent.name)
    return dict(host_key=host_key,staged=staged,store=str(store))


def collect_cryptex_cache(share, store, record, keep=CRYPTEX_CACHE_KEEP):
    """Read the guest's SHARE/cryptex-cache/result.json into RECORD; move a new entry from out/KEY/ into STORE after
    checking its images' sha256 here, and keep the KEEP newest entries."""
    out=share/'cryptex-cache'
    if (out/'result.json').is_file():record['result']=json.loads((out/'result.json').read_text())
    for entry in sorted((out/'out').glob('*/entry.json')) if (out/'out').is_dir() else []:
        data=json.loads(entry.read_text());started=time.monotonic()
        for name,want in data['files'].items():
            got=dict(sha256=digest(entry.parent/name),size=(entry.parent/name).stat().st_size)
            if got!=want:raise RuntimeError('cryptex cache: %s/%s is %s, the guest recorded %s'%(entry.parent,name,got,want))
        Path(store).mkdir(parents=True,exist_ok=True)
        target=Path(store)/entry.parent.name
        if target.exists():shutil.rmtree(target)
        os.rename(entry.parent,target);os.utime(target/'entry.json')
        record['stored']=dict(key=target.name,check_seconds=round(time.monotonic()-started,1))
    used=record.get('result',{}).get('key')
    if used and (Path(store)/used/'entry.json').is_file():os.utime(Path(store)/used/'entry.json')   # newest: just used
    # this build's entry first, then the most recently used or stored
    entries=sorted(Path(store).glob('*/entry.json'),key=lambda p:(p.parent.name!=used,-p.stat().st_mtime)) if Path(store).is_dir() else []
    record['pruned']=[]
    for entry in entries[keep:]:
        shutil.rmtree(entry.parent);record['pruned'].append(entry.parent.name)
    return record


TARGET_DATA='target-data.json'     # in the kit: the target's platform_data, which hooks read at HAO_TARGET_DATA


def target_of(recipe):
    """(model, platform_data) of the assembly RECIPE's target, pipeline/targets/TARGET.json."""
    t=json.loads((TOP/'pipeline/targets'/(recipe['target']+'.json')).read_text())
    data=t.get('platform_data',{})
    if not isinstance(t.get('model'),str) or not t['model'] or not isinstance(data,dict):
        raise ValueError('target %s needs a "model" and an object "platform_data" (or none)'%recipe['target'])
    return t['model'],data


def target_json(recipe):
    """pipeline/targets/TARGET.json of the assembly RECIPE, parsed."""
    return json.loads((TOP/'pipeline/targets'/(recipe['target']+'.json')).read_text())


def hardware_overlay(recipe, inputs=True):
    """Whether the image gets OCLP's legacy hardware overlay (golden-image.py's step hardware, from the assembly's
    "hardware" input): when the target's OCLP hardware profile (tools/oclp-hardware/profiles/TARGET.json) selects
    patch sets. A target whose profile selects none (the generic one: software graphics, no GPU, Wi-Fi or audio
    patches) gets no overlay, and its assembly names no "hardware" input. Either mismatch stops: an overlay is never
    taken from another target's input, and a selected patch set is never dropped silently (INPUTS false: the target
    alone decides, unchecked; run checks before staging). An assembly without a target (test fixtures) keeps it."""
    if 'target' not in recipe:
        return True
    patchsets=runpy.run_path(str(TOP/'pipeline/patches.py'))['oclp_patchsets'](TOP/'pipeline/targets'/(recipe['target']+'.json'))
    named='hardware' in recipe.get('inputs',{})
    if not inputs:
        return bool(patchsets)
    if patchsets and not named:
        raise ValueError('target %s selects OCLP patch sets (%s) but the assembly names no "hardware" input: its '
                         'legacy hardware overlay would be missing'%(recipe['target'],', '.join(sorted(patchsets))))
    if not patchsets and named:
        raise ValueError('target %s selects no OCLP patch sets, so its image gets no hardware overlay, but the '
                         'assembly names the "hardware" input %s (another target\'s overlay?): remove it'
                         %(recipe['target'],recipe['inputs']['hardware']))
    return bool(patchsets)


def efi_build_of(recipe):
    """The target's "efi_build" (the base ESP stages/build-efi.py makes with the pinned OpenCore release: base "oclp",
    the default, from the pinned OCLP source; base "qemu_reference" from the qemu_reference_efi row; the set's post
    recipes then complete it), or a refusal naming what is missing or unknown. Checked before anything is staged. The
    image's ESP never comes from another target's data: a target without "efi_build" has no ESP yet."""
    t=target_json(recipe)
    if 'efi_build' in t:
        runpy.run_path(str(TOP/'pipeline/stages/build-efi.py'))['base_of'](t,recipe['target'])
        return t['efi_build']
    if t.get('generic'):
        raise ValueError(
            'target %s has no "efi_build": its ESP base is not decided yet. OCLP\'s OpenCore build for %s is the '
            'Apple firmware layout of that model (a 5K iMac: OpenCore hidden as System/Library/CoreServices/'
            '.diagnostics/Drivers/HardwareDrivers/Product.efi behind Apple\'s diagnostics launcher \\boot.efi, '
            'Misc.Boot.LauncherPath \\boot.efi; with boot_efi true OCLP\'s build fails), and there is no '
            'EFI/BOOT/BOOTx64.efi, the path non-Apple firmware (OVMF) starts. Decide the generic ESP\'s base (an '
            'OCLP build with that layout undone, or OpenCore\'s release with the qemu_reference_efi tree) and record '
            'it in the target before building' % (recipe['target'], t.get('model')))
    raise ValueError('target %s has no "efi_build": stages/build-efi.py cannot make its ESP' % recipe['target'])


def stage_target(recipe, share):
    """Write the target's platform_data into the kit (SHARE/target-data.json); the model goes in the environment."""
    write(share/TARGET_DATA,target_of(recipe)[1])


def target_environment(recipe, kit_root):
    """HAO_TARGET_MODEL and HAO_TARGET_DATA for every hook and post (none for an assembly without a target)."""
    if 'target' not in recipe:
        return {}
    return dict(HAO_TARGET_MODEL=target_of(recipe)[0],HAO_TARGET_DATA=kit_root+'/'+TARGET_DATA)


