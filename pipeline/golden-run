def system_build(root):
    """ProductBuildVersion of the system root ROOT (a mounted file system), or None."""
    import plistlib
    path=Path(root)/'System/Library/CoreServices/SystemVersion.plist'
    return plistlib.loads(path.read_bytes()).get('ProductBuildVersion') if path.is_file() else None


def declared_files(share):
    """{recipe: {"pack": P, "files": [path, ...], "seed": {path: reason}}} of the set's recipes (SHARE/patches.txt),
    from each patch.json's declared files ("seed": those with "content": "seed"): golden-image writes one manifest per
    recipe of these, as installed, for `hao verify`."""
    out={}
    for line in (share/'patches.txt').read_text().splitlines():
        parts=line.split()
        if len(parts)<2:continue
        p=json.loads((TOP/'patches'/parts[1]/'patch.json').read_text())
        out[parts[1]]=dict(pack=p.get('pack'),files=sorted({f['path'] for f in p.get('files',[]) if f.get('path')}),
                           seed={f['path']:f.get('reason') for f in p.get('files',[]) if f.get('content')=='seed'})
    return out


def prepare_overlays(recipe, share, work, record, source, options):
    """Materialise the set, plan the overlay installs for SHARE/patches.txt and stage them on the share.
    OPTIONS: system (the Golden Gate root), store, hooks (recipes kept on their hooks). Returns the record."""
    system=Path(options['system']).resolve()
    if system_build(system)!=recipe['golden_build']:
        raise ValueError('--overlay-system %s is build %s, the assembly builds %s'%(system,system_build(system),recipe['golden_build']))
    materialize=runpy.run_path(str(TOP/'pipeline/materialize.py'))
    overlays=runpy.run_path(str(TOP/'pipeline/overlays.py'))
    out=work/'overlays';store=Path(options['store']).resolve()
    results=lambda:sum(1 for _ in store.glob('results/*.json'))
    before=results();started=time.monotonic()
    report,ledger=materialize['run'](runpy.run_path(str(TOP/'pipeline/patches.py'))['set_path'](recipe['patch_set']),
                                     str(TOP/'pipeline/targets'/(recipe['target']+'.json')),recipe['donor_build'],
                                     str(out),str(store),str(system),golden=recipe['golden_build'])
    made=time.monotonic()
    plan=overlays['schedule'](overlays['read_rows'](share/'patches.txt'),ledger,report,overlays['load_manifests'](out),
                              force_hook=set(options.get('hooks',())),links=overlays['firmlinks'](system))
    write(share/'overlay-plan.json',plan);shutil.copy2(share/'overlay-plan.json',record/'overlay-plan.json')
    shutil.copy2(out/'report.json',record/'overlay-report.json');shutil.copy2(out/'deferred.json',record/'overlay-deferred.json')
    staged=overlays['stage_files'](plan,out,share/'overlay-files')
    for files in out.glob('*/files'):shutil.rmtree(files)   # staged files are links; the manifests and report stay
    shutil.copy2(TOP/'pipeline/stages/golden-overlays.py',source/'golden-overlays.py')
    shutil.copy2(TOP/'tools/hao/src/livepatch.py',source/'livepatch.py')
    print(overlays['render'](plan),flush=True)
    counts={}
    for r in report:counts[r['outcome']]=counts.get(r['outcome'],0)+1
    return dict(system=str(system),store=str(store),materialize=counts,plan=plan['counts'],staged_bytes=staged,
                materialize_seconds=round(made-started,1),plan_seconds=round(time.monotonic()-made,1),
                store_results=dict(before=before,new=results()-before),hooks=sorted(options.get('hooks',())))


def job_script(local, share=GUEST, owner='root:wheel', workspace=None, recovery_commands=False):
    """Execute source locally, retain logs even on failure, and publish completion last."""
    workspace_script=''
    if workspace:
        helper=(TOP/'pipeline/stages/golden-workspace.py').read_text()
        marker='GOLDEN_WORKSPACE_'+uuid.uuid4().hex
        workspace_script=('"$G/py/bin/python3.12" -I - --size-bytes '+str(workspace['size_bytes'])+
                          ' --mount '+q(workspace['mount'])+' --name '+q(workspace['name'])+
                          ' --record "$G/out-golden/workspace.json" --source-sha256 '+hashlib.sha256(helper.encode()).hexdigest()+
                          " <<'"+marker+"'\n"+helper+'\n'+marker+'\n')
    return '''set -u
set -o pipefail
umask 022
G=%s
W=%s
install -d -m 755 "$G/out-golden"
exec >"$G/out-golden/golden.log" 2>&1
rc=0
prepare_workspace() {
%s
}
prepare_workspace || rc=$?
echo "Maintenance storage before assembly:"
df -k "$W"
# The same assembly an Intel Mac or the target's Recovery runs from a kit (hao build-disk, hao install).
if [ "$rc" = 0 ]; then
    %ssh "$G/assembly-source/golden-assemble.sh" "$G" "$W" --owner %s
    rc=$?
fi
# Never infer completion from nested pristine/hook RESULT lines.
if [ -d "$W/work" ]; then
    mkdir -p "$G/out-golden/guest"
    (cd "$W/work" && tar -cf - .) | (cd "$G/out-golden/guest" && tar -xf -) || { export_rc=$?; [ "$rc" != 0 ] || rc=$export_rc; }
fi
if [ "$rc" = 0 ] && [ %s = legacy ]; then
    (cd "$W" && tar -cf - target.img) | (cd "$G/out-golden" && tar -xf -) || rc=$?
fi
sync
printf 'RESULT rc=%%s\\n' "$rc"
printf '%%s\\n' "$rc" > "$G/out-golden/result.new"
mv "$G/out-golden/result.new" "$G/out-golden/result"
''' % (q(share),q(local),workspace_script or ':',
       'HAO_RECOVERY_COMMANDS="$G/assembly-source/recovery-commands.txt" ' if recovery_commands else '',
       q(owner),'workspace' if workspace else 'legacy')


EXEC_UNDELIVERED=75   # pipeline/vm/vmctl exec: the guest never took the command and it was withdrawn


def submit_job(run, vmctl, vm, submission, output, attempts=3, say=print):
    """Send the guest job (it answers "started" at once) through `vmctl VM exec`. vmctl's stderr is printed on any
    failure. The job is sent again only when vmctl withdrew it undelivered and OUTPUT (the job's first act is to make
    it) does not exist, so a job never runs twice; when OUTPUT exists the job started and is waited for."""
    for attempt in range(1,attempts+1):
        reply=run([str(vmctl),str(vm),'exec',submission])
        if reply.returncode==0:
            if reply.stdout.strip()!='started':raise RuntimeError('guest start reply uncertain; do not resubmit automatically')
            return attempt
        say('golden-run: vmctl exec failed (rc %d, attempt %d/%d): %s'%(reply.returncode,attempt,attempts,
            (reply.stderr or '').strip()[-2000:] or '(no stderr)'),flush=True)
        where=run([str(vmctl),str(vm),'endpoint'])
        say('golden-run: agent endpoint: %s'%((where.stdout or '').strip() or (where.stderr or '').strip()),flush=True)
        if Path(output).exists():
            say('golden-run: the guest job started (%s exists); waiting for it'%output,flush=True)
            return attempt
        if reply.returncode!=EXEC_UNDELIVERED:
            raise RuntimeError('guest job submission failed (vmctl rc %d); not resent: it may have been delivered'%reply.returncode)
    raise RuntimeError('guest job not delivered after %d attempts'%attempts)


def wait_job(output, timeout, poll=5):
    deadline = time.monotonic()+timeout
    offset = 0
    while True:
        log = output/'golden.log'
        if log.exists():
            with log.open() as stream:
                stream.seek(offset); text=stream.read();offset=stream.tell()
            if text:
                print(text,end='',flush=True)
        result = output/'result'
        if result.exists():
            return int(result.read_text().strip())
        if time.monotonic() >= deadline:
            raise TimeoutError('Golden guest has no final completion; logs: '+str(output))
        time.sleep(poll)


def assembled(output):
    record = json.loads((output/'guest/build.json').read_text())
    if record['status'] != 'assembled' or record['attached_device'] is not None:
        raise RuntimeError('guest image is not successfully assembled and detached')
    return record


def skipped_groups(recipe, skip_optional=()):
    """Optional patch groups to leave out: the assembly's "skip_optional" list plus --skip-optional."""
    groups=recipe.get('skip_optional',[])
    if not isinstance(groups,list) or not all(isinstance(g,str) and g for g in groups):
        raise ValueError('assembly skip_optional must be a list of optional group names')
    return sorted(set(groups)|set(skip_optional))


def run(recipe_path, repository, work=None, record=None, base=None, timeout=14400, skip_optional=(), overlays=None,
        cryptex_cache=True, kit_only=False, recovery_commands=False, link_on_target=False):
    """Stage the kit (WORK/share) and assemble it in a builder VM clone; KIT_ONLY stops after staging (no VM, no
    builder lock, no repository): the kit is then assembled by pipeline/stages/golden-assemble.sh elsewhere."""
    recipe_path = Path(recipe_path).resolve(); recipe=json.loads(recipe_path.read_text())
    if recipe['schema'] != 1:
        raise ValueError('unsupported Golden assembly recipe')
    skip=skipped_groups(recipe,skip_optional)
    # What the target decides about the base layers, refused here, before any staging: the hardware overlay and its
    # input, and the base ESP's build settings.
    try:hardware=hardware_overlay(recipe);efi_build=efi_build_of(recipe)
    except ValueError as x:raise SystemExit('golden-run: %s'%x)
    pipeline=TOP/'pipeline';store=(TOP/'store').resolve()
    stamp=datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:6]
    job=('kit-' if kit_only else 'golden-')+recipe['golden_build']+'-'+stamp
    work=Path(work).resolve() if work else store/'tmp'/job
    record=Path(record).resolve() if record else store/'runs'/job
    repository=Path(repository).resolve() if repository else None;share=work/'share'
    workspace=dict(size_bytes=recipe.get('workspace_size_bytes',160*1024**3),
                   mount='/Volumes/builder-work-'+stamp,name='builder-work-'+stamp)
    local=workspace['mount']+'/job'
    workspace_image=work/'workspace.img'
    # Disk (measured on the 26B131 fold builds): the share's staged inputs ~82 GB, the workspace image ~66 GB and the
    # image commit ~23 GB; a kit alone is the share. An assembly may say more with "disk_need_gb".
    need=recipe.get('disk_need_gb',(DISK_KIT_ON_DRIVE_GB if os.environ.get('KIT_ON_DRIVE') else DISK_KIT_GB) if kit_only else DISK_BUILD_GB)
    try:DISK['check'](need,'golden-run',job,str(store))
    except DISK['Refused'] as x:raise SystemExit('golden-run: %s'%x)
    work.mkdir(parents=True,exist_ok=False);record.mkdir(parents=True,exist_ok=False)
    env=dict(os.environ,VMBIN=os.environ.get('VMBIN',str(store/'vm/bin')),VMCTL=str(pipeline/'vm/vmctl'),
             GOLDEN_LOCK=str(pipeline/'inputs/golden'/recipe['golden_build']),SKIP_OPTIONAL=' '.join(skip))
    state=dict(unit='pipeline',operation='golden-first',recipe=recipe,recipe_sha256=digest(recipe_path),
               workspace=str(TOP),work=str(work),repository=str(repository) if repository else None,guest_local=local,
               guest_workspace=dict(workspace,image=str(workspace_image)),
               **source_identity(),
               status='staging',validation='BUILD ONLY; QEMU/native/fresh-install acceptance remains separate')
    shutil.copy2(recipe_path,record/'assembly.json')
    write(record/'build.json',state)
    vm=None;started=False
    def command(args, **kwargs):
        print('+ '+shlex.join(map(str,args)),flush=True)
        return subprocess.run(list(map(str,args)),env=env,check=True,**kwargs)
    def stop():
        nonlocal started
        if started:
            command(['zsh',pipeline/'vm/stop.sh',vm]);started=False
    lock=store/'tmp/builder.lock'
    with (nullcontext() if kit_only else builder_lock(lock,job+' pid='+str(os.getpid()))):
        try:
            lockrows=runpy.run_path(str(pipeline/'lock.py'))
            build_lock=pipeline/'inputs'/recipe['donor_build'];common=pipeline/'inputs/common'
            # Rows of the Golden Gate build come first: inputs/golden/<golden_build>, then the donor build, then common.
            golden_lock=pipeline/'inputs/golden'/recipe['golden_build']
            def lock_of(row):
                return next(d for d in (golden_lock,build_lock,common) if (d/row).is_file())
            command(['zsh',pipeline/'stages/inputs.sh',share,pipeline/'targets'/(recipe['target']+'.json'),
                     build_lock,common,recipe['oclp'],runpy.run_path(str(TOP/'pipeline/patches.py'))['set_path'](recipe['patch_set']),'golden-first'])
            set_order(share)  # refuse a set whose order is not its run order before any further staging
            # Which optional patches (e.g. harvested caches) ran or were skipped, and why.
            state['optional']=json.loads((share/'optional.json').read_text());write(record/'build.json',state)
            shutil.copy2(share/'optional.json',record/'optional.json')
            opencore_row=opencore_row_of(recipe)
            # base qemu_reference: the ESP's base tree is the qemu_reference_efi row
            reference_row='qemu_reference_efi' if efi_build.get('base')=='qemu_reference' else None
            used_rows=set(recipe['inputs'].values()) | {'kdk','python_arm64','python_x86_64','python_site','fl',opencore_row}
            if reference_row:used_rows.add(reference_row)
            for line in (share/'patches.txt').read_text().splitlines():
                used_rows.update(line.split()[2:])
            manifest=(share/'MANIFEST.txt').read_text()
            psp_line=next(line for line in manifest.splitlines() if 'PatcherSupportPkg ' in line)
            used_rows.add('psp_'+psp_line.split('PatcherSupportPkg ',1)[1].split()[0])
            input_records={}
            for row in sorted(used_rows):
                row_lock=lock_of(row)
                value=lockrows['rows'](str(row_lock))[row]
                input_records[row]=dict(sha256=value[0],path=value[1],row=(row_lock/row).read_text())
            write(record/'inputs.json',input_records)
            sources={}
            extras=share/'assembly-inputs';extras.mkdir(mode=0o755)
            for role,row in recipe['inputs'].items():
                # copied, then checked as copied (lock.py stage): never read by the row's path after a check
                source=Path(lockrows['where'](str(lock_of(row)),row))
                lockrows['stage'](str(lock_of(row)),row,str(extras/role),'ditto');sources[role]=dict(row=row,path=str(source))
                if (extras/role/'build.json').exists():shutil.copy2(extras/role/'build.json',record/(role+'-input.json'))
            source=share/'assembly-source';source.mkdir(mode=0o755)
            for name in ('golden-image.py','golden-layout.py','golden-pristine.sh','golden-workspace.py','recovery-tools.py'):
                shutil.copy2(pipeline/'stages'/name,source/name)
            shutil.copy2(pipeline/'stages/copy-hooks.py',source/'copy-hooks.py')
            shutil.copy2(pipeline/'stages/golden-assemble.sh',source/'golden-assemble.sh')
            # The Recovery's command list of the donor build (HAO_RECOVERY_COMMANDS, --recovery-commands)
            commands=pipeline/'stages'/('recovery-commands-%s.txt'%recipe['donor_build'])
            if commands.is_file():shutil.copy2(commands,source/'recovery-commands.txt')
            elif recovery_commands:raise SystemExit('golden-run: --recovery-commands: no %s'%commands.relative_to(TOP))
            shutil.copy2(pipeline/'kit.py',source/'kit.py')
            shutil.copy2(share/'oclp/opencore_legacy_patcher/sys_patch/utilities/kdk_intel_payload.py',source/'kdk_intel_payload.py')
            shutil.copy2(share/'pristine/fl',source/'fl')
            shutil.copytree(TOP/'tools/tahoe-donors',source/'tahoe-donors',ignore=shutil.ignore_patterns('__pycache__'))
            if hardware:shutil.copytree(extras/'hardware/install-tools',source/'hardware')
            else:print('golden-run: target %s selects no OCLP patch sets: no hardware overlay'%recipe['target'],flush=True)
            work.mkdir(parents=True,exist_ok=True)
            rows_in=Path(tempfile.mkdtemp(prefix='checked-rows-',dir=work))   # this run's own, mode 0700
            def checked_row(row):
                """A checked copy of ROW (lock.py stage) in this run's private folder, named as the row's file."""
                out=rows_in/row;out.mkdir()
                return lockrows['stage'](str(lock_of(row)),row,str(out/Path(lockrows['where'](str(lock_of(row)),row)).name))
            command([share/KIT['python_dir']()/'bin/python3.12','-I',pipeline/'stages/build-efi.py',
                     '--source',share/'oclp','--site',share/'site',
                     '--target',pipeline/'targets'/(recipe['target']+'.json'),
                     '--revision',recipe['oclp'],'--opencore',checked_row(opencore_row),
                     '--out',source/'esp','--record',record/'base-efi.json']
                    +(['--reference',checked_row(reference_row)] if reference_row else []))
            shutil.rmtree(rows_in)
            if overlays:
                state['overlays']=prepare_overlays(recipe,share,work,record,source,overlays);write(record/'build.json',state)
            if cryptex_cache:
                state['cryptex_cache']=prepare_cryptex_cache(recipe,share,store/'cache/cryptex',lockrows,
                                                             (golden_lock,build_lock,common));write(record/'build.json',state)
            stage_target(recipe,share)   # HAO_TARGET_DATA of every hook and post
            config=guest_config(recipe,share,local,overlays=bool(overlays),cryptex_cache=cryptex_cache)
            write(share/'declared.json',declared_files(share))   # what golden-image records per recipe (hao verify)
            write(share/'guest-config.json',config)
            shutil.copy2(share/'guest-config.json',record/'guest-config.json')
            # The same configuration with the kit and local roots as placeholders: what golden-assemble.sh renders
            # in the guest (equal to guest-config.json there), on an Intel Mac or in the target's Recovery.
            write(share/'kit.json',KIT['template'](guest_config(recipe,share,local,overlays=bool(overlays),
                                                               cryptex_cache=cryptex_cache),
                                                  recipe_path.stem,GUEST,local))
            shutil.copy2(share/'kit.json',record/'kit.json')
            for name in ('patches.txt','MANIFEST.txt','profile.json',TARGET_DATA):
                shutil.copy2(share/name,record/name)
            state.update(inputs=sources,source_files={str(p.relative_to(source)):digest(p) for p in source.rglob('*') if p.is_file() and not p.is_symlink()},status='starting')
            # The Boot and System KCs a VM build of this same tree linked (pipeline/prelinked_kc.py): a VM build stores
            # its own after the guest ends; a kit carries them, because the stick's Recovery cannot link them.
            kc_folder=next(folder for stage,name,folder in set_order(share) if name=='darwin27-kernel')
            kc_lines=PRELINKED['lines'](recipe,share,lambda item:lockrows['key_line'](
                item,str(store),[str(golden_lock),str(build_lock),str(common)]),kc_folder)
            state['prelinked_kc']=dict(key=PRELINKED['key_of'](kc_lines))
            if kit_only and link_on_target:
                # No prelinked collections: darwin27-kernel's hook links them in the install, as root, with Tahoe's
                # kmutil and its x86_64 collection builder (the hook's Intel branch). Nothing from a builder VM.
                state['prelinked_kc'].update(link_on_target=True)
                print('golden-run: kit without prelinked kernel collections: the install links them',flush=True)
            elif kit_only:
                staged=PRELINKED['stage'](store/'cache/kc',state['prelinked_kc']['key'],kc_lines,share/'hooks'/kc_folder)
                state['prelinked_kc'].update(staged or dict(missing=True))
                if not staged:
                    print('golden-run: no prelinked kernel collections for this kit (key %s): its install links them '
                          'with kmutil, which a Recovery cannot. Build the image once in the builder VM (golden-run '
                          'ASSEMBLY --repo REPO) and stage the kit again.'%state['prelinked_kc']['key'],file=sys.stderr,flush=True)
            if kit_only:
                state.update(status='kit staged',kit=str(share));write(record/'build.json',state)
                print('Kit staged: '+str(share),flush=True);print('Record: '+str(record),flush=True)
                return state
            clone=command([sys.executable,'-I',pipeline/'vm/clones.py','clone',job,'--base',base or store/'vm/base'],capture_output=True,text=True)
            vm=Path(json.loads(clone.stdout)['vm']);state['vm']=str(vm);write(record/'build.json',state)
            create_workspace_image(workspace_image,workspace['size_bytes'])
            started=True
            command([sys.executable,'-I',pipeline/'vm/clones.py','start',vm,share,'--usb',workspace_image])
            script=job_script(local,workspace=workspace,recovery_commands=recovery_commands)
            (record/'guest-job.sh').write_text(script)
            submission='(\n'+script+'\n) >/dev/null 2>&1 </dev/null & echo started'
            subprocess.run([str(pipeline/'vm/vmctl'),str(vm),'endpoint'],env=env)   # logged: the agent's port and bridge
            print('+ '+shlex.join([str(pipeline/'vm/vmctl'),str(vm),'exec','<guest job>']),flush=True)
            submit_job(lambda a:subprocess.run(a,env=env,capture_output=True,text=True),pipeline/'vm/vmctl',vm,
                       submission,share/'out-golden')
            state['status']='assembling';write(record/'build.json',state)
            output=share/'out-golden';rc=wait_job(output,timeout)
            if rc:raise RuntimeError('Golden guest failed with status '+str(rc)+'; inspect '+str(output))
            assembled(output);stop()
            if (output/'guest/kc').is_dir():
                PRELINKED['store_entry'](store/'cache/kc',state['prelinked_kc']['key'],kc_lines,output/'guest/kc',
                                         PRELINKED['sha256'](share/'hooks'/kc_folder/'inputs/darwin27_kernel'),record)
                state['prelinked_kc']['stored']=True;write(record/'build.json',state)
            if cryptex_cache:
                collect_cryptex_cache(share,store/'cache/cryptex',state['cryptex_cache']);write(record/'build.json',state)
            state['status']='capturing';write(record/'build.json',state)
            capture_workspace(state,output,command)
        except BaseException as error:
            state.update(status='failed',error=str(error))
            raise
        finally:
            try:stop()
            except Exception as error:state['stop_error']=str(error)
            result=share/'cryptex-cache/result.json'
            if cryptex_cache and 'cryptex_cache' in state and 'result' not in state['cryptex_cache'] and result.is_file():
                state['cryptex_cache']['result']=json.loads(result.read_text())   # failed build: nothing is stored
            output=share/'out-golden'
            if output.exists():
                record_output=record/'guest-output';record_output.mkdir(exist_ok=True)
                for item in output.iterdir():
                    if item.name=='target.img':continue
                    if item.is_dir():shutil.copytree(item,record_output/item.name,dirs_exist_ok=True,symlinks=True)
                    else:shutil.copy2(item,record_output/item.name)
            write(record/'build.json',state)
    print('Golden image committed: '+str(repository),flush=True)
    print('Record: '+str(record),flush=True)
    return state



@contextmanager
def readonly_workspace(state, command):
    """Read a cleanly stopped builder workspace; never format or alter host disks."""
    vm=Path(state['vm'])
    if runpy.run_path(str(TOP/'pipeline/vm/clones.py'))['running'](vm):
        raise RuntimeError('builder must be stopped before mounting its workspace')
    workspace=state['guest_workspace']
    relative=Path(state['guest_local']).relative_to(workspace['mount'])/'target.img'
    if '..' in relative.parts:
        raise ValueError('image path leaves the workspace')
    with tempfile.TemporaryDirectory(prefix='golden-capture-') as directory:
        mount=Path(directory)/'source';mount.mkdir()
        attached=False
        try:
            command(['hdiutil','attach','-readonly','-nobrowse','-mountpoint',mount,workspace['image']],capture_output=True)
            attached=True
            image=mount/relative
            if not image.is_file() or image.is_symlink() or image.stat().st_size!=state['recipe']['size_bytes']:
                raise ValueError('completed workspace image is missing or has the wrong size')
            yield image
        finally:
            if attached:command(['hdiutil','detach',mount],capture_output=True)


# The exported EFI redistributes OpenCore and OCLP-generated files: their license texts go with it.
EFI_LICENSES={'LICENSES/OpenCorePkg-LICENSE.txt':TOP/'pipeline/licenses/OpenCorePkg-LICENSE.txt',
              'LICENSES/OpenCore-Legacy-Patcher-LICENSE.txt':TOP/'tools/oclp-integration/LICENSE.txt'}


def boot_efi_archive(prepared,repository):
    """boot-efi.zip from the guest's prepared EFI (payload/, manifest.json) plus EFI_LICENSES."""
    # Files from a release's tar assets carry mtime 0 (its archive format): ZIP stores times from 1980, so earlier ones
    # are written as 1980-01-01 instead of refused.
    archive=Path(repository)/'boot-efi.zip'
    with zipfile.ZipFile(archive,'w',zipfile.ZIP_DEFLATED,strict_timestamps=False) as bundle:
        for path in sorted(Path(prepared).rglob('*')):bundle.write(path,path.relative_to(prepared).as_posix())
        for name,source in EFI_LICENSES.items():bundle.write(source,name)
    return str(archive)


def commit_image(state,image,prepared,command):
    """Capture the raw IMAGE into state['repository'] (ssdimg init when new, capture, fsck, commit) and archive the
    prepared boot EFI folder PREPARED next to it when it carries the kernel repairs."""
    repository=Path(state['repository'])
    ssdimg=Path(os.environ.get('SSDIMG',str(TOP/'tools/bin/ssdimg')))
    if not (repository/'image.json').exists():command([ssdimg,'init',repository])
    command([ssdimg,'-C',repository,'capture','--force',image])
    command([ssdimg,'-C',repository,'fsck'])
    command([ssdimg,'-C',repository,'commit','-m','Golden Gate '+state['recipe']['golden_build']+'; '+state['commit']])
    if prepared.exists() and json.loads((prepared/'manifest.json').read_text())['kernel_repairs_applied']:
        archive=boot_efi_archive(prepared,repository)
        state['boot_efi']=dict(path=archive,sha256=digest(archive),manifest=json.loads((prepared/'manifest.json').read_text()))


def capture_workspace(state,output,command):
    assembled(output)
    with readonly_workspace(state,command) as image:
        commit_image(state,image,output/'guest/boot-efi',command)
    state.update(status='committed',capture_source='read-only stopped builder workspace',capture_tool_sha256=digest(Path(__file__)))


def capture_kit(record,local,repository):
    """After golden-assemble.sh KIT LOCAL built the raw image LOCAL/target.img from the kit of RECORD (golden-run
    --stage-kit), on another Mac or in its Recovery with LOCAL then reachable here: keep its sealed cryptex images
    (collect_kit), check the assembler's record (LOCAL/work/build.json: assembled, nothing left attached) and the image
    (a regular file of the assembly's size), and commit it to REPOSITORY as a VM build does. A disk target needs no
    capture: the disk is the result."""
    record=Path(record).resolve();local=Path(local).resolve()
    state=json.loads((record/'build.json').read_text())
    if state.get('status') not in ('kit staged','kit assembled'):
        raise RuntimeError('%s is no staged kit (status %r)'%(record,state.get('status')))
    work=local/'work'
    result=json.loads((work/'build.json').read_text())
    if result.get('status')!='assembled' or result.get('attached_device') is not None:
        raise RuntimeError('the kit assembly in %s is not assembled and detached'%local)
    image=local/'target.img'
    if image.is_symlink() or not image.is_file() or image.stat().st_size!=state['recipe']['size_bytes']:
        raise ValueError('%s is missing, a link, or not %d bytes'%(image,state['recipe']['size_bytes']))
    if state.get('status')=='kit staged':
        state=collect_kit(record)
    output=record/'kit-output';output.mkdir(exist_ok=True)
    shutil.copytree(work,output/'guest',dirs_exist_ok=True,symlinks=True)   # the assembler's record and logs, as a VM build keeps them
    def command(args,**kwargs):
        print('+ '+shlex.join(map(str,args)),flush=True)
        return subprocess.run(list(map(str,args)),check=True,**kwargs)
    state['repository']=str(Path(repository).resolve())
    try:
        commit_image(state,image,work/'boot-efi',command)
        state.update(status='committed',capture_source='kit assembly '+str(local),capture_tool_sha256=digest(Path(__file__)))
    finally:
        write(record/'build.json',state)
    print('Golden image committed: '+state['repository'],flush=True)
    return state


def collect_kit(record):
    """After golden-assemble.sh assembled the kit of RECORD (golden-run --stage-kit) on another Mac or in its
    Recovery: keep the sealed cryptex images it made (KIT/cryptex-cache/out/KEY) in the store, as a VM build does, so
    the next build with the same inputs, code and builder tools reuses them. The key holds the builder's macOS build
    and APFS tool hashes, so an Intel builder's entries never stand in for an arm64 builder's, or the reverse."""
    record=Path(record).resolve();state=json.loads((record/'build.json').read_text())
    if state.get('status')!='kit staged':raise RuntimeError('%s is no staged kit (status %r)'%(record,state.get('status')))
    if 'cryptex_cache' in state:
        collect_cryptex_cache(Path(state['kit']),Path(state['cryptex_cache']['store']),state['cryptex_cache'])
        state['status']='kit assembled';write(record/'build.json',state)
    return state


def capture_record(record):
    record=Path(record).resolve();state=json.loads((record/'build.json').read_text())
    output=Path(state['work'])/'share/out-golden'
    assembled(output)
    def command(args,**kwargs):
        print('+ '+shlex.join(map(str,args)),flush=True)
        return subprocess.run(list(map(str,args)),check=True,**kwargs)
    with builder_lock(TOP/'store/tmp/builder.lock','capture completed image pid='+str(os.getpid())):
        state['previous_capture_status']=dict(status=state['status'],error=state.pop('error',None))
        try:
            capture_workspace(state,output,command)
        finally:write(record/'build.json',state)
    print('Golden image committed: '+state['repository'],flush=True)


def main():
    # git trusts this checkout in every program below (a user's checkout, run under sudo by create-installer)
    os.environ.update(runpy.run_path(str(TOP/'pipeline/source_commit.py'))['git_env'](os.environ,TOP))
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('recipe',type=Path,nargs='?');parser.add_argument('--repo',type=Path)
    parser.add_argument('--capture-record',type=Path,help='capture a successfully assembled image from its stopped builder workspace')
    parser.add_argument('--work',type=Path);parser.add_argument('--record',type=Path);parser.add_argument('--base',type=Path)
    parser.add_argument('--timeout',type=int,default=14400)
    parser.add_argument('--skip-optional',action='append',default=[],metavar='GROUP',
                        help='leave out the optional patches of GROUP (e.g. caches) even when their inputs are there')
    parser.add_argument('--from-overlays',action='store_true',
                        help='install declared files from the materialised overlays instead of their recipes\' hooks')
    parser.add_argument('--overlay-system',type=Path,metavar='ROOT',
                        help='the build\'s Golden Gate file system (read-only), for --from-overlays')
    parser.add_argument('--overlay-store',type=Path,default=TOP/'store/cache/edit-engine-store',
                        help='edit-engine artifact store kept between builds (default store/cache/edit-engine-store)')
    parser.add_argument('--overlay-hook',action='append',default=[],metavar='NAME',
                        help='keep recipe NAME on its hook with --from-overlays')
    parser.add_argument('--stage-kit',action='store_true',
                        help='stage the relocatable kit in --work (WORK/share) and stop: no builder VM, no --repo; '
                             'golden-assemble.sh assembles it on the Mac that has the target (hao build-disk, install)')
    parser.add_argument('--link-on-target',action='store_true',
                        help='with --stage-kit: carry no prelinked kernel collections; the install links them as root')
    parser.add_argument('--capture-kit',type=Path,metavar='RECORD',
                        help='commit the image golden-assemble.sh built in --local LOCAL from the kit of RECORD to --repo')
    parser.add_argument('--local',type=Path,help='the LOCAL folder golden-assemble.sh assembled in, for --capture-kit')
    parser.add_argument('--collect-kit',type=Path,metavar='RECORD',
                        help='after golden-assemble.sh ran the kit of RECORD: store the sealed cryptex images it made')
    parser.add_argument('--no-cryptex-cache',action='store_true',
                        help='build golden-gate-userspace\'s sealed cryptex images even when store/cache/cryptex has '
                             'them for the same inputs, code and builder tools (and store nothing)')
    parser.add_argument('--recovery-commands',action='store_true',
                        help='assemble with only the commands of the donor build\'s Recovery on PATH '
                             '(pipeline/stages/recovery-commands-BUILD.txt), as the stick\'s install runs')
    args=parser.parse_args()
    overlays=None
    if args.from_overlays:
        if not args.overlay_system:parser.error('--from-overlays needs --overlay-system ROOT')
        overlays=dict(system=args.overlay_system,store=args.overlay_store,hooks=args.overlay_hook)
    elif args.overlay_system or args.overlay_hook:parser.error('--overlay-system and --overlay-hook need --from-overlays')
    signal.signal(signal.SIGTERM,lambda *_:(_ for _ in ()).throw(KeyboardInterrupt('terminated')))
    if args.capture_kit:
        if args.recipe or not args.repo or not args.local:parser.error('--capture-kit takes the record, --local and --repo')
        capture_kit(args.capture_kit,args.local,args.repo)
    elif args.collect_kit:
        if args.recipe or args.repo or args.capture_record:parser.error('--collect-kit takes only the record')
        print(json.dumps(collect_kit(args.collect_kit).get('cryptex_cache',{}),indent=2))
    elif args.capture_record:
        if args.recipe or args.repo or args.skip_optional or overlays or args.no_cryptex_cache:parser.error('capture-record does not take a recipe, repository or --skip-optional')
        capture_record(args.capture_record)
    else:
        if args.stage_kit:
            if not args.recipe or args.repo:parser.error('--stage-kit takes a recipe and no --repo')
        elif not args.recipe or not args.repo:parser.error('recipe and --repo are required')
        # No candidate build while a fix proven on the laptop exists only there (pipeline/swaps.py; no override).
        refusal=runpy.run_path(str(Path(__file__).resolve().parent/'swaps.py'))['gate']()
        if refusal:
            print('golden-run: refused: '+'\n'.join(refusal),file=sys.stderr);sys.exit(3)
        run(args.recipe,args.repo,args.work,args.record,args.base,args.timeout,args.skip_optional,overlays,
            cryptex_cache=not args.no_cryptex_cache,kit_only=args.stage_kit,recovery_commands=args.recovery_commands,
            link_on_target=args.link_on_target)


