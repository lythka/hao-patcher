#!/usr/bin/python3 -I
"""release-cut: what a release of an assembly would ship, and whether each input could be made again.

  release-cut --dry-run ASSEMBLY [--json]                   (ASSEMBLY = pipeline/assemblies/NAME.json)
  release-cut --write OUT.json ASSEMBLY [--overlays DIR] [--draft]
        the release.json a cut publishes: downloads (row, size, sha256; URL filled by the cut), our assets with
        their producers, recipe revisions, packs, and each overlay file's expected sha256 (from materialize's
        DIR). Refused while any row is not download/reproducible, unless --draft.

Every input row the assembly's set and donors use is resolved (pipeline/inputs/golden/BUILD, then the donor build,
then common) and classified, without changing anything:
  download      Apple or third-party bytes the user's builder fetches itself (installers, KDK, OCLP); must be
                pinned by URL, size and sha256 in release.json (tools/acquire)
  reproducible  an artifact whose build.json names a clean commit of a producer this repository can find
  dirty         built from a tree with uncommitted changes
  harvested     made from a running laptop (caches, seeds): a release can ship it, a user cannot make it again
  unrecorded    no build.json, or no producer commit in it
  missing       the row's file is not in the store
The cut itself (exporting rows and build records into release.json, refusing dirty or unrecorded producers)
follows once every row is downloadable or reproducible (workflow plan step 13). Exit 1 when a row is not.
"""
import json
import os
from pathlib import Path
import runpy
import subprocess
import sys

TOP = Path(__file__).resolve().parents[1]
DOWNLOAD_ROOTS = ('store/installers', 'store/kdk', 'store/oclp', 'store/inputs', 'store/packages')


def rows_for(assembly):
    """[(row, lock folder)] for every input the assembly's set uses plus its donor rows, first lock folder wins."""
    patches = runpy.run_path(str(TOP / 'pipeline' / 'patches.py'))
    lock = runpy.run_path(str(TOP / 'pipeline' / 'lock.py'))
    a = json.loads(Path(assembly).read_text())
    folders = [TOP / 'pipeline/inputs/golden' / a['golden_build'], TOP / 'pipeline/inputs' / a['donor_build'],
               TOP / 'pipeline/inputs/common']
    tables = [(f, lock['rows'](str(f))) for f in folders if f.is_dir()]
    target = TOP / 'pipeline/targets' / (a['target'] + '.json')
    setfile = TOP / 'pipeline/sets' / (a['patch_set'] + '.txt')
    import contextlib, io
    with contextlib.redirect_stderr(io.StringIO()):
        plan = patches['plan'](setfile, target, a['donor_build'], locks=None)
    wanted = []
    for _, _, inputs in plan:
        wanted += inputs
    wanted += list(a.get('inputs', {}).values())
    out, seen = [], set()
    for row in wanted:
        if row in seen:
            continue
        seen.add(row)
        hit = next(((f, t[row]) for f, t in tables if row in t), None)
        out.append((row, hit))
    return out


def commit_known(commit):
    for repo in (TOP, Path.home() / 'hao-runtime'):
        if repo.is_dir() and subprocess.run(['git', '-C', str(repo), 'cat-file', '-e', commit + '^{commit}'],
                                            capture_output=True).returncode == 0:
            return 'hao-patcher' if repo == TOP else repo.name
    return None


def classify(row, hit):
    if hit is None:
        return 'missing', 'no row file for %s' % row
    folder, (sha, path) = hit
    rel = os.path.relpath(path, TOP)
    if not os.path.exists(path):
        return 'missing', '%s is not in the store' % rel
    if any(rel == r or rel.startswith(r + '/') for r in DOWNLOAD_ROOTS):
        return 'download', rel
    parts = rel.split('/')
    if len(parts) < 3 or parts[:2] != ['store', 'artifacts']:
        return 'unrecorded', rel
    art = TOP / 'store' / 'artifacts' / parts[2]
    build = next((b for b in (art / 'build.json', art / 'payload' / 'build.json') if b.is_file()), None)
    if build is None:
        return 'unrecorded', '%s has no build.json' % parts[2]
    meta = json.loads(build.read_text())
    if meta.get('harvest') or meta.get('kind') == 'harvest' or meta.get('harvest_sha256'):
        return 'harvested', parts[2]
    commit = meta.get('commit') or meta.get('hao_commit')
    dirty = meta.get('dirty', meta.get('hao_dirty', not meta.get('clean', True)))
    if not commit:
        return 'unrecorded', '%s: build.json names no commit' % parts[2]
    if dirty:
        return 'dirty', '%s: built from a dirty tree at %s' % (parts[2], commit)
    repo = commit_known(str(commit))
    if not repo:
        return 'unrecorded', '%s: commit %s is in no repository here' % (parts[2], commit)
    return 'reproducible', '%s: %s@%s' % (parts[2], repo, str(commit)[:10])


def release_json(assembly, results, overlays=None):
    """The release manifest a cut would publish (state "draft" while any row is not download/reproducible)."""
    patches = runpy.run_path(str(TOP / 'pipeline' / 'patches.py'))
    a = json.loads(Path(assembly).read_text())
    import contextlib, io
    with contextlib.redirect_stderr(io.StringIO()):
        plan = patches['plan'](TOP / 'pipeline/sets' / (a['patch_set'] + '.txt'),
                               TOP / 'pipeline/targets' / (a['target'] + '.json'), a['donor_build'], locks=None)
    packs = patches['load_packs']()
    refusals = ['%s: %s (%s)' % (row, c, d) for row, c, d, _ in results if c not in ('download', 'reproducible')]
    downloads, assets = [], []
    for row, c, detail, hit in results:
        sha, path = hit[1] if hit else ('-', None)
        size = os.path.getsize(path) if path and os.path.isfile(path) else None
        item = {'row': row, 'sha256': sha, 'size': size}
        if c == 'download':
            downloads.append(dict(item, name=row, url=None))      # the URL is filled in by the cut, never guessed
        else:
            assets.append(dict(item, class_=c, producer=detail))
    out = {'release_format': 1, 'state': 'draft' if refusals else 'cut', 'assembly': Path(assembly).stem,
           'golden_build': a['golden_build'], 'donor_build': a['donor_build'], 'target': a['target'],
           'patch_set': a['patch_set'],
           'proven_on': sorted({m for p in packs.values() for m in p.get('proven_on', [])}),
           'recipes': {name: patches['revision'](name) for _, name, _ in plan},
           'packs': {n: {'phase': p['phase'], 'recipes': p.get('recipes', [])} for n, p in sorted(packs.items())},
           'downloads': downloads, 'assets': [{k.rstrip('_'): v for k, v in x.items()} for x in assets],
           'refusals': refusals}
    if overlays:
        expected = {}
        for m in sorted(Path(overlays).glob('*/manifest.json')):
            man = json.loads(m.read_text())
            expected[man['pack']] = {p: f['sha256'] for p, f in sorted(man['files'].items())}
        out['expected_outputs'] = expected    # compared after a build, not fatal: a difference is a note
    return out


def main(argv):
    if '--write' in argv:
        i = argv.index('--write')
        out_path = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
        overlays = None
        if '--overlays' in argv:
            j = argv.index('--overlays'); overlays = argv[j + 1]; argv = argv[:j] + argv[j + 2:]
        assembly = next(a for a in argv if not a.startswith('--'))
        pairs = rows_for(assembly)
        results = [(row,) + classify(row, hit) + (hit,) for row, hit in pairs]
        rel = release_json(assembly, results, overlays)
        if rel['state'] != 'cut' and '--draft' not in argv:
            print('release-cut: refused, %d rows are not reproducible or downloadable (use --draft to write a draft):'
                  % len(rel['refusals']), file=sys.stderr)
            for r in rel['refusals']:
                print('  ' + r, file=sys.stderr)
            return 1
        Path(out_path).write_text(json.dumps(rel, indent=1) + '\n')
        print('release-cut: wrote %s (%s; %d downloads, %d assets, %d refusals)' % (
            out_path, rel['state'], len(rel['downloads']), len(rel['assets']), len(rel['refusals'])))
        return 0
    if '--dry-run' not in argv or len([a for a in argv if not a.startswith('--')]) != 1:
        sys.exit(__doc__)
    assembly = next(a for a in argv if not a.startswith('--'))
    results = [(row,) + classify(row, hit) for row, hit in rows_for(assembly)]
    if '--json' in argv:
        print(json.dumps([{'row': r, 'class': c, 'detail': d} for r, c, d in results], indent=1))
    else:
        for row, c, detail in sorted(results, key=lambda x: (x[1], x[0])):
            print('%-14s %-34s %s' % (c, row, detail))
        counts = {}
        for _, c, _ in results:
            counts[c] = counts.get(c, 0) + 1
        print('\nrelease-cut: %d rows: %s' % (len(results), ', '.join('%d %s' % (n, c) for c, n in sorted(counts.items()))))
    return 0 if all(c in ('download', 'reproducible') for _, c, _ in results) else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
