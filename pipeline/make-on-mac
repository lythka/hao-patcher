#!/usr/bin/env python3.14
"""make-on-mac: make every made-on-Mac input row of a release from its downloads, in order, on this Mac.

  make-on-mac RELEASE.json [--only ROW ...] [--work DIR] [--userspace-on DIR] [--keep] [--dry-run]

Run after `hao fetch` and `pipeline/place` in a checkout whose store/ they filled. Each row is made by its producer
(pipeline/release-classes.json names them) with the arguments below, into the row's path, then checked as every
build checks it (lock.py: its sha256). A row already in place and matching is left alone. Disk images are attached
read-only (never written) and detached again. The first producer that fails, or row that does not check after it,
stops the run. Exit 0 when every row checks; 1 names the rows that do not.

A download the release marks "stream" (the IPSW, the installer) is not in the store: its producer reads only the
members it needs from its URL, each checked against the release's pins (pipeline/unpack/ranged.py); a local row
file is used instead when it is there and has the row's sha256: a private snapshot of it is checked and read, and
the release's pins still apply to it. With HAO_MIRROR
set, the producers read a streamed download from the local mirror by the whole file's sha256 (the IPSW's from its
pins' "ipsw_sha256", the installer's from --installer-sha256; pipeline/unpack/ranged.py). --userspace-on DIR writes
golden_gate_userspace's 23 GB of disk images into DIR (the USB drive) and links the row's artifact folder to it. The
Tahoe donors are made in one x86_64 pass, and
each work tree is deleted as soon as the rows made from it check (--keep keeps them).
"""
import argparse, contextlib, hashlib, json, os, runpy, shutil, stat, subprocess, sys, tarfile, tempfile, time, zlib
from pathlib import Path

TOP = Path(__file__).resolve().parents[1]
PY = [sys.executable, '-I']
sys.path.insert(0, str(TOP / 'pipeline'))
import lock  # noqa: E402


class Failed(Exception):
    pass


def folders(release):
    a = json.loads((TOP / 'pipeline/assemblies' / (release['assembly'] + '.json')).read_text())
    return [TOP / 'pipeline/inputs/golden' / a['golden_build'], TOP / 'pipeline/inputs' / a['donor_build'],
            TOP / 'pipeline/inputs/common'], a


def find(fs, row):
    for f in fs:
        if (f / row).is_file():
            return f
    raise Failed('no input row %s' % row)


def path(fs, row):
    """The row's path (absolute), whether or not it is there yet."""
    f = find(fs, row)
    line = next(l for l in (f / row).read_text().splitlines() if l.strip() and not l.startswith('#'))
    return TOP / line.split(None, 1)[1].strip()


def checks(fs, row):
    try:
        with contextlib.redirect_stderr(open(os.devnull, 'w')):
            lock.path(str(find(fs, row)), row)
        return True
    except SystemExit:
        return False


def artifact(p):
    """store/artifacts/NAME of a row path below it."""
    rel = p.relative_to(TOP / 'store').parts
    if rel[0] != 'artifacts':
        raise Failed('%s is not under store/artifacts' % p)
    return TOP / 'store' / 'artifacts' / rel[1]


class Run:
    def __init__(self, fs, work, log, dry, release=None, userspace_on=None, keep=False, runtime_tool=None):
        self.fs, self.work, self.log, self.dry = fs, work, log, dry
        self.release, self.userspace_on, self.keep = release or {}, userspace_on, keep
        self.runtime_tool = runtime_tool
        self.mounts, self.private, self.inputs = {}, [], {}
        self.cache = None       # the download cache (--cache), for archive_tool

    def stream(self, row):
        """(source, extra arguments) for a download row: a private snapshot of its local file (snapshot()) when it is
        in place and has the row's sha256, else (a release download marked "stream") its URL. The release's member
        pins, written to a private_folder(), are passed for either whenever the release has them."""
        entry = next((d for d in self.release.get('downloads', []) if d['row'] == row), None)
        try:
            local = path(self.fs, row)
        except Failed:
            local = None
        extra = []
        if entry and entry.get('pins'):
            pins = self.private_folder() / ('%s-pins.json' % row)     # never through a name a link may move
            pins.write_text(json.dumps(entry['pins']))
            extra = ['--pins', pins]
        if local is not None and local.exists():
            want = lock.rows(str(find(self.fs, row)))[row][0]
            if want != '-' and self.dry:
                return local, extra
            if want != '-' and local.is_file():
                try:
                    return self.snapshot(local, want), extra
                except Failed as e:
                    print('  %s: %s; not used' % (row, e), flush=True)
            else:
                print('  %s: %s has no sha256 in its row; not used' % (row, local), flush=True)
        if extra and entry.get('stream'):
            return entry['url'], extra
        raise Failed('no checked input for row %s' % row)

    def private_folder(self, near=None):
        """A new folder of this user's for checked copies, in NEAR (the drive the source is on, so files clone), the
        work folder or else the system's temporary folder: each is resolved once to its real path, and that path
        (never the name it was given, which a link could point elsewhere later) is checked (private_base), made in
        and returned. close() deletes it."""
        for b in ([near] if near else []) + [self.work, Path(tempfile.gettempdir())]:
            base = Path(os.path.realpath(b))
            if private_base(base):
                into = Path(tempfile.mkdtemp(prefix='checked-', dir=base))
                self.private.append(into)
                lock.own(str(into))           # no ACL entry inherited from BASE
                return into
        raise Failed('neither %s nor %s is private to this user' % (self.work, tempfile.gettempdir()))

    def snapshot(self, src, want):
        """A snapshot of file SRC that only this process's user can change, checked against sha256 WANT after it is
        made, so the producer reads the bytes that were checked: an APFS clone of SRC (a copy where no clone can be
        made) in a private_folder(). Its path."""
        into = self.private_folder()
        out = into / Path(src).name
        if subprocess.run(['cp', '-c', str(src), str(out)], capture_output=True).returncode:
            with contextlib.suppress(FileNotFoundError):
                out.unlink()
            with open(src, 'rb') as f, open(out, 'xb') as o:
                shutil.copyfileobj(f, o, 1 << 22)
        lock.own(str(out))                    # this user's, no ACL entry (a clone or copy keeps the source's)
        os.chmod(out, 0o400)
        fd = os.open(out, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_nlink != 1 \
                    or stat.S_IMODE(st.st_mode) & 0o277:
                raise Failed('the snapshot of %s is not a private file' % src)
            h = hashlib.sha256()
            while block := os.read(fd, 1 << 22):
                h.update(block)
        finally:
            os.close(fd)
        if h.hexdigest() != want:
            raise Failed('%s does not have the row\'s sha256' % src)
        return out

    def snapshot_tree(self, src, folder, row, want):
        """A copy of folder row ROW (SRC, of lock folder FOLDER) in a private_folder(), checked as a tree after it is
        made (lock.py: its content sha256 WANT and its check lines); only the entries that hash covers are copied,
        files cloned where they can be. Its path."""
        # golden_gate_userspace's images (23 GB) may be on the USB drive: its copy goes there when it can, as clones
        near = self.userspace_on if row == 'golden_gate_userspace' else None
        out = self.private_folder(near) / Path(src).name
        out.mkdir(mode=0o700)
        lock.copy_tree(src, out, lock.scope(str(folder), row), lock.without(str(folder), row))
        lock.own(str(out))
        if lock.row_hash(str(folder), row, str(out)) != want or lock.check_row(str(folder), row, str(out)):
            raise Failed('input row %s: %s does not have the row\'s sha256' % (row, src))
        return out

    def input(self, row):
        """Input row ROW for a producer: a checked private snapshot of its file, or checked private copy of its
        folder, made once per run; never the store path, which may change after it was checked."""
        if row in self.inputs:
            return self.inputs[row]
        folder = find(self.fs, row)
        want, p = lock.rows(str(folder))[row]
        p = Path(p)
        if self.dry:
            return p
        if want == '-':
            raise Failed('input row %s has no sha256' % row)
        st = os.lstat(p) if os.path.lexists(p) else None
        if st is None:
            raise Failed('input row %s: %s is not there' % (row, p))
        if stat.S_ISDIR(st.st_mode):
            out = self.snapshot_tree(p, folder, row, want)
        else:
            out = self.snapshot(p, want)
            if lock.check_row(str(folder), row, str(out)):
                raise Failed('input row %s does not check' % row)
        self.inputs[row] = out
        return out

    def discard(self, p):
        """Delete a work tree whose rows are made and checked (unless --keep)."""
        if self.keep or self.dry or not Path(p).exists():
            return
        print('  delete %s (its rows check)' % p, flush=True)
        shutil.rmtree(p)

    def sh(self, *cmd, env=None, user=None):
        """Run CMD in TOP, its output to the log; USER (uid, gid, groups) runs it as that user (from root)."""
        line = ('(as uid %d) ' % user[0] if user else '') + ' '.join(str(c) for c in cmd)
        print('  $ ' + line, flush=True)
        self.log.write('$ %s\n' % line); self.log.flush()
        if self.dry:
            return
        who = dict(user=user[0], group=user[1], extra_groups=user[2]) if user else {}
        r = subprocess.run([str(c) for c in cmd], stdout=self.log, stderr=subprocess.STDOUT,
                           env=dict(os.environ, **(env or {})), cwd=TOP, **who)
        if r.returncode:
            raise Failed('%s exited %d (see the log)' % (Path(str(cmd[0])).name if cmd[0] not in PY else cmd[2],
                                                         r.returncode))

    def mount(self, image, name, passphrase=None):
        if name in self.mounts:
            return self.mounts[name]
        point = self.work / ('mnt-' + name)
        point.mkdir(parents=True, exist_ok=True)
        cmd = ['hdiutil', 'attach', '-readonly', '-nobrowse', '-owners', 'on', '-mountpoint', str(point), str(image)]
        if passphrase is not None:
            cmd.insert(2, '-stdinpass')
        print('  mount %s -> %s' % (Path(image).name, point), flush=True)
        if not self.dry:
            r = subprocess.run(cmd, input=(passphrase or '').encode() if passphrase is not None else None,
                               capture_output=True)
            if r.returncode:
                raise Failed('hdiutil attach %s: %s' % (image, r.stderr.decode(errors='replace').strip()))
        self.mounts[name] = point
        return point

    def unmount_all(self):
        for name, point in reversed(list(self.mounts.items())):
            if not self.dry:
                subprocess.run(['hdiutil', 'detach', str(point)], capture_output=True)
        self.mounts.clear()

    def close(self):
        """Detach every image and delete the snapshots."""
        self.unmount_all()
        for d in self.private:
            shutil.rmtree(d, ignore_errors=True)
        self.private.clear()
        self.inputs.clear()


def private_base(folder):
    """True when FOLDER (a real path: every part of it a folder, none a link) and every folder above it belong to
    this user or root and no one else can write them, or only with the sticky bit (/private/tmp): no one else can
    rename or replace a folder this user makes in it."""
    p = Path(folder)
    if not p.is_absolute():
        return False
    for d in [p] + list(p.parents):
        try:
            st = os.lstat(d)
        except OSError:
            return False
        if not stat.S_ISDIR(st.st_mode) or st.st_uid not in (0, os.geteuid()):
            return False
        if st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX:
            return False
    return True


def sudo_user(environ):
    """(uid, gid, groups, name, home) of the user who ran sudo, from SUDO_UID and SUDO_GID."""
    uid, gid = environ.get('SUDO_UID', ''), environ.get('SUDO_GID', '')
    if not (uid.isdigit() and gid.isdigit() and int(uid) != 0):
        raise Failed('hao_runtime is made by a tool that runs as an ordinary user, and this runs as root without '
                     'SUDO_UID: run make-on-mac as an ordinary user, or with sudo from that user\'s account')
    import pwd
    entry = pwd.getpwuid(int(uid))
    return int(uid), int(gid), user_groups(entry.pw_name, int(gid)), entry.pw_name, entry.pw_dir


def user_groups(name, gid, grouplist=os.getgrouplist, limit=None):
    """The user's groups for setgroups: their primary group first, at most NGROUPS_MAX (16 on macOS; an admin user
    has more, and setgroups refuses a longer list). macOS's initgroups keeps the first 16 the same way; membership
    beyond them is still answered by the directory service."""
    limit = limit or os.sysconf('SC_NGROUPS_MAX')
    return list(dict.fromkeys([gid] + list(grouplist(name, gid))))[:limit]


def hand_over(top, uid, gid, readable=False):
    """Give TOP and everything below it (no symlink followed) to UID, without ACLs (the tool checks that no one else
    can write the folders it writes into). Modes are kept: they are part of a row's content sha256 (lock.py), so a
    folder writable by others stays so and the tool names it. READABLE (the view, no row): every folder and file is
    made readable by its owner, as it copies execute-only setuid files."""
    for root, dirs, files in os.walk(top):
        for name in [None] + dirs + files:
            p = os.path.join(root, name) if name else root
            st = os.lstat(p)
            if stat.S_ISLNK(st.st_mode):
                continue
            os.chown(p, uid, gid, follow_symlinks=False)
            if readable:
                os.chmod(p, stat.S_IMODE(st.st_mode) | (0o700 if stat.S_ISDIR(st.st_mode) else 0o400))
    # not chmod -R -N: it fails on a dangling link; links carry no data another user could write through
    subprocess.run(['/usr/bin/find', str(top), '!', '-type', 'l', '-exec', '/bin/chmod', '-N', '{}', '+'], check=True)


def let_in(folder, uid, name):
    """Let UID (only) pass through FOLDER (root's work folder) to the view and the mounted images in it."""
    if os.stat(folder).st_uid != uid:
        subprocess.run(['/bin/chmod', '+a', 'user:%s allow search' % name, str(folder)], check=True)


def user_tmp(who):
    """The user's own temporary folder (DARWIN_USER_TEMP_DIR, under /var/folders), checked private to them."""
    r = subprocess.run(['/usr/bin/getconf', 'DARWIN_USER_TEMP_DIR'], capture_output=True, text=True,
                       user=who[0], group=who[1], extra_groups=who[2])
    tmp = r.stdout.strip()
    st = os.stat(tmp) if r.returncode == 0 and tmp else None
    if st is None or st.st_uid != who[0] or st.st_mode & 0o022:
        raise Failed('no private temporary folder for uid %d (getconf DARWIN_USER_TEMP_DIR: %r)' % (who[0], tmp))
    return tmp


MEMBER_LIMIT = 64 << 20     # a producer's own files (scripts, modules) are small


def archive_tool(cache, release, row, tool_rel):
    """(path, None) of a private copy of TOOL_REL (and the rest of its folder, which it imports) taken from ROW's
    archive, the one the release pins (its sha256, also release-classes' source_sha256) and the download cache holds;
    or (None, why not). The archive is hashed on the open file the members are read from, and the copy is made in a new
    folder of this user's (mkdtemp; 0711, its files 0644/0755) that is what runs: nothing on the placed tree is trusted."""
    import atexit, hashlib
    classes = json.loads((TOP / 'pipeline/release-classes.json').read_text())
    classes = classes.get('rows', classes)
    entry = next((x for x in release.get('assets', []) if x.get('row') == row), None)
    if entry is None:
        return None, 'the release has no %s asset' % row
    pinned = classes.get(row, {}).get('source_sha256')
    if pinned and entry.get('sha256') != pinned:
        return None, 'the release\'s %s archive is %s, not the %s this checkout pins' % (row, entry.get('sha256'), pinned)
    if cache is None:
        return None, 'no download cache named (--cache) to take it from its archive'
    strip = int((classes.get(row, {}).get('unpack') or {}).get('strip', 0))
    folder = Path(tool_rel).parent
    try:
        fd = os.open(Path(cache) / 'sha256' / entry['sha256'], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as x:
        return None, 'the %s archive is not in the cache: %s' % (row, x.strerror)
    # under /private/var/tmp (root's, sticky): the user the tool runs as under sudo can reach it, no one else can change it
    base = Path(tempfile.mkdtemp(prefix='hao-producer-', dir='/private/var/tmp' if os.path.isdir('/private/var/tmp') else None))
    atexit.register(shutil.rmtree, str(base), True)
    os.chmod(base, 0o711)
    with os.fdopen(fd, 'rb') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            return None, 'the cached %s archive is not a file' % row
        # one read: the bytes hashed are the bytes extracted, so nothing can change them in between; the copy is kept
        # only when the whole archive hashes to its pin
        h = hashlib.sha256()

        size = entry.get('size')
        seen = [0]

        class Hashed:
            def read(self, n=-1):
                data = f.read(n)
                seen[0] += len(data)
                if isinstance(size, int) and seen[0] > size:     # never more than the release pins
                    raise tarfile.TarError('the archive is larger than its pinned size')
                h.update(data)
                return data

        total = [0]

        def members(t):
            with t:
                for m in t:
                    parts = Path(m.name).parts
                    if not m.isfile() or len(parts) <= strip or '..' in parts or Path(m.name).is_absolute():
                        continue
                    rel = Path(*parts[strip:])
                    if rel.parent != folder:
                        continue
                    total[0] += m.size
                    if m.size > MEMBER_LIMIT or total[0] > 4 * MEMBER_LIMIT:
                        raise tarfile.TarError('%s is larger than a producer\'s files can be' % m.name)
                    out = base / rel
                    out.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
                    data = t.extractfile(m).read()
                    w = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                0o755 if m.mode & 0o111 else 0o644)
                    with os.fdopen(w, 'wb') as o:
                        o.write(data)
        broken = None
        try:
            members(tarfile.open(fileobj=Hashed(), mode='r|*'))
        except (tarfile.TarError, EOFError, zlib.error) as x:
            broken = x                                  # the hash below says whether it is the pinned archive at all
        for block in iter(lambda: f.read(1 << 20), b''):
            seen[0] += len(block)
            if isinstance(size, int) and seen[0] > size:
                break
            h.update(block)
        if h.hexdigest() != entry['sha256'] or (isinstance(size, int) and seen[0] != size):
            shutil.rmtree(base, True)
            return None, 'the cached %s archive is not its pinned bytes' % row
        if broken is not None:
            shutil.rmtree(base, True)
            return None, 'the %s archive could not be read: %s' % (row, broken)
    tool = base / tool_rel
    if not tool.is_file():
        return None, 'the %s archive has no %s' % (row, tool_rel)
    return tool, None


def runtime_tool(r, tool, view, x86, top, euid=None, environ=None):
    """Run hao-runtime's tool (it refuses root: it needs no privileges). As root under sudo it runs as the user who
    ran sudo, who is given TOP (the archive folder it writes into) and the view (made as root: it reads execute-only
    setuid files), a way through the work folder to the view and the mounted Rosetta image, and their own TMPDIR."""
    environ = os.environ if environ is None else environ
    if (os.geteuid() if euid is None else euid) != 0:
        return r.sh(*PY, tool, view, x86, top)
    uid, gid, groups, name, home = sudo_user(environ)
    tmp = '$TMPDIR'
    if not r.dry:
        hand_over(top, uid, gid)
        hand_over(view, uid, gid, readable=True)
        let_in(r.work, uid, name)
        tmp = user_tmp((uid, gid, groups))
    return r.sh(*PY, tool, view, x86, top, user=(uid, gid, groups),
                env=dict(TMPDIR=tmp, HOME=home, USER=name, LOGNAME=name))


def find_runtime_tool(top, dev=None):
    """The placed runtime archive's tools/hao-runtime-on-mac, else DEV (--dev-runtime-tool, a maintainer's choice)."""
    tool = top / 'tools/hao-runtime-on-mac'
    if tool.is_file():
        return tool
    if os.environ.get('HAO_RUNTIME_ON_MAC') and dev is None:
        raise Failed('HAO_RUNTIME_ON_MAC is not read; a maintainer passes --dev-runtime-tool')
    if dev is None or not Path(dev).is_file():
        raise Failed('the runtime archive has no tools/hao-runtime-on-mac (a maintainer may pass --dev-runtime-tool)')
    return Path(dev)


def run_steps(todo, fs, made, only=(), dry=False):
    """Make each (rows, function) of TODO whose rows are wanted and not in place, in order; the first producer that
    fails or row that does not check after it stops the rest. The rows that failed."""
    for rows, fn in todo:
        rows = [x for x in rows if x in made and (not only or x in only)]
        if not rows:
            continue
        if all(checks(fs, x) for x in rows):
            print('ok   %s (already in place)' % ', '.join(rows))
            continue
        t = time.time()
        print('make %s' % ', '.join(rows), flush=True)
        try:
            fn()
        except (Failed, OSError) as e:
            print('  STOPPED: %s' % e)
            return rows
        bad = []
        for x in rows:
            good = dry or checks(fs, x)
            print('%s %s (%.0f s)' % ('ok  ' if good else 'FAIL', x, time.time() - t))
            if not good:
                bad.append(x)
        if bad:
            print('  STOPPED: %s did not check' % ', '.join(bad))
            return bad
    return []


DONOR_ROWS = ['tahoe_kmutil', 'tahoe_os_cache_x86_64h', 'tahoe_basesystem', 'tahoe_native_donors',
              'tahoe_extensions_donors', 'tahoe_driverkit_donors', 'tahoe_boot_donors', 'tahoe_recovery_donors']


def steps(r, fs, a):
    """[(rows it makes, function)] in dependency order."""
    P = lambda row: path(fs, row)

    I = r.input        # an input row a producer reads: a checked private copy (Run.input)
    userspace = lambda: I('golden_gate_userspace')   # its payload folder, a checked private copy (Run.input)
    root = lambda: r.mount(userspace() / 'filesystem.dmg', 'system')
    donor = TOP / 'store/inputs' / a['donor_build']

    def gg_userspace():
        out = artifact(P('golden_gate_userspace'))
        if (out.exists() or out.is_symlink()) and not r.dry:
            out.unlink() if out.is_symlink() else shutil.rmtree(out)
        ipsw, extra = r.stream('ipsw_27_0')
        made = out
        if r.userspace_on:                     # the images go onto the drive; the row's folder links to them
            made = Path(r.userspace_on) / out.name
            if made.exists() and not r.dry:
                shutil.rmtree(made)
        if extra or r.userspace_on:            # streamed members (pipeline/unpack/ipsw-stream): no .aea kept
            r.sh(*PY, 'pipeline/unpack/ipsw-stream', '--ipsw', ipsw, '--board', 'j293ap', '--out', made,
                 *(extra or ['--trust-local']))
        else:
            r.sh(*PY, 'patches/golden-gate-userspace/build/make', '--ipsw', ipsw, '--board', 'j293ap', '--out', out)
        if made != out and not r.dry:
            out.parent.mkdir(parents=True, exist_ok=True)
            out.symlink_to(made)

    def kernel():
        out = P('darwin27_kernel').parents[1]
        r.sh(*PY, 'tools/kernel-foundation/make', 'kernel', '--kernel', root() / 'System/Library/Kernels/kernel',
             '--out', out)

    def python_site():
        r.sh(*PY, 'pipeline/python-site', 'make', P('python_site').parent, 'pipeline/inputs/common')

    def kc_builder():
        r.sh(*PY, 'pipeline/unpack/kc-builder', P('tahoe_kc_builder').parent, '--inputs', find(fs, 'tahoe_kc_builder'))

    def oclp_hardware():
        tools = r.work / 'oclp'
        tools.mkdir(exist_ok=True)
        if not r.dry:
            with tarfile.open(I('oclp_source')) as t:
                t.extract(t.getmember('payloads/Tools/RSRRepair'), tools, filter='data')
        # PatcherSupportPkg's image is encrypted with the passphrase OCLP itself mounts it with (its public source)
        psp = r.mount(I('psp_2.0.5'), 'psp', passphrase='password')
        r.sh(*PY, 'tools/oclp-hardware/make', 'build', '--psp-root', psp, '--psp-archive', I('psp_2.0.5'),
             '--rsr-repair', tools / 'payloads/Tools/RSRRepair', '--out', P('oclp_hardware'))

    def qemu_reference():
        out = P('qemu_reference_efi')
        if out.exists() and not r.dry:
            shutil.rmtree(out)
        r.sh(*PY, 'pipeline/unpack/qemu-reference', out, '--opencore', I('opencore_release'),
             '--oclp-source', I('oclp_source'), '--hfsplus', I('ocbinarydata_hfsplus'),
             '--virtualsmc', I('virtualsmc_release'))

    def donors():
        """One x86_64 pass of donor-inputs over the installer (by URL when the release streams it), target-first
        (the Golden Gate System and Rosetta cache decide which Tahoe roots are needed); then the build tool, the OS
        cache and the BaseSystem rows are cloned out of it, the five donor roles made from it, and it is deleted."""
        rosetta = r.mount(userspace() / 'rosetta.dmg', 'rosetta')
        images = r.work / 'cache-images.txt'
        r.sh(*PY, 'pipeline/unpack/cache-images', 'list', rosetta / 'System/Library/dyld/dyld_shared_cache_x86_64',
             images)
        d = donor / ('minimal-' + a['golden_build'])
        if d.exists() and not r.dry:
            shutil.rmtree(d)
        installer, extra = r.stream('installer')
        if extra:
            entry = next(x for x in r.release['downloads'] if x['row'] == 'installer')
            extra = extra + ['--installer-sha256', entry['sha256']]
        r.sh(*PY, 'pipeline/unpack/donor-inputs', installer, d, '--requirements',
             'tools/tahoe-donors/recipes/intel-donors.json', '--kdk', I('kdk'), '--ripatch', I('ripatch'),
             '--target-system', root(), '--target-cache-images', images, *extra)
        for row, src in (('tahoe_kmutil', d / 'tree/usr/bin/kmutil'),
                         ('tahoe_basesystem', d / 'out/BaseSystem-x86_64.dmg')):
            if not checks(fs, row):
                out = P(row)
                if out.exists() and not r.dry:
                    out.unlink()
                r.sh('mkdir', '-p', out.parent)
                r.sh('cp', '-c', src, out)
        if not checks(fs, 'tahoe_os_cache_x86_64h'):
            cache = P('tahoe_os_cache_x86_64h').parent
            if cache.exists() and not r.dry:
                shutil.rmtree(cache)
            r.sh('cp', '-c', '-R', d / 'out/os-cache', cache)
        T, R = 'tools/tahoe-donors/make', d / 'recipe.json'
        tree = ['--tree', d / 'tree', '--metadata', d / 'lists/sys.tsv', '--links', d / 'zip/AssetData/payloadv2/links.txt']
        layout = ['--tree', d / 'tree', '--unpack', d, '--map', d / 'preboot-recovery-map.tsv']
        for role, row, args in (
                ('native', 'tahoe_native_donors', tree + ['--cache', P('tahoe_os_cache_x86_64h').parent]),
                ('extensions', 'tahoe_extensions_donors', tree),
                ('driverkit', 'tahoe_driverkit_donors', ['--source', d / 'out/driverkit',
                                                          '--metadata', d / 'out/driverkit/metadata.tsv']),
                ('boot', 'tahoe_boot_donors', layout), ('recovery', 'tahoe_recovery_donors', layout)):
            if checks(fs, row):
                continue
            out = P(row)
            if out.exists() and not r.dry:
                shutil.rmtree(out)
            r.sh(*PY, T, role, *args, '--recipe', R, '--output', out)
        if all(checks(fs, x) for x in DONOR_ROWS):
            r.discard(d)

    def metal_tools():
        return I('metal_llvm') if any(x.get('row') == 'metal_llvm' for x in r.release.get('assets', [])) else None

    def metallibs():
        llvm = metal_tools()
        for row, profile in (('hello_metallib_golden_gate', 'hello-golden-gate.txt'),
                             ('metallib_repairs_golden_gate', 'metallib-repairs-golden-gate.txt')):
            if checks(fs, row):
                continue
            out = P(row)
            if out.exists() and not r.dry:
                shutil.rmtree(out)
            r.sh(*PY, 'cache/metallib/make', root(), out, '--work', r.work / ('metallib-' + row),
                 '--paths', 'cache/metallib/profiles/' + profile, *(['--llvm-bin', llvm] if llvm else []))

    def quad():
        o = I('oclp_hardware') / 'payload'
        llvm = metal_tools()
        out = P('metal_quad_runtime_golden_gate')
        if out.exists() and not r.dry:
            shutil.rmtree(out)
        r.sh(*PY, 'cache/metallib/make', 'runtime-build',
             o / '11.7.10/System/Library/Extensions/AppleIntelGraphicsShared.bundle/Contents/Resources/runtime.igil64.split',
             out, '--llvm', o / '13.2.1-25/System/Library/PrivateFrameworks/GPUCompiler.framework/Versions/3802/Libraries/libLLVM.dylib',
             '--compiler', o / '11.7.10/System/Library/Extensions/AppleIntelHD4000GraphicsGLDriver.bundle/Contents/MacOS/iCBE.dylib',
             *(['--assembler', llvm/'assemble'] if llvm else []))

    def live_text():
        """A shipped asset's Apple-derived files, made here (metal's tools/live-text/on-mac; each file is checked
        against the row's own build.json, nothing is written on a mismatch)."""
        r.sh(*PY, 'tools/live-text/on-mac', 'runtime', P('live_text_framework'), '--system', root())

    def compiler_service():
        r.sh(*PY, 'tools/live-text/on-mac', 'compiler-service', P('metal_compiler_compat'),
             '--oclp-hardware', I('oclp_hardware'))

    def runtime(row):
        """hao_runtime's stubs and dyld, made from the System and Rosetta images (hao-runtime's tools/hao-runtime-on-mac,
        from the placed archive, or --dev-runtime-tool for an archive older than it); it checks the whole payload."""
        top = P(row).parent
        tool = find_runtime_tool(top, r.runtime_tool)
        if tool == top / 'tools/hao-runtime-on-mac' and not r.dry:
            # what runs is the pinned archive's own tools folder, copied from it here, not the placed one
            tool, why = archive_tool(r.cache, r.release, row, 'tools/hao-runtime-on-mac')
            if why:
                raise Failed('hao-runtime-on-mac not run: ' + why)
        rosetta = r.mount(userspace() / 'rosetta.dmg', 'rosetta')
        runtime_tool(r, tool, root_view(row), rosetta / 'System/Library/dyld', top)

    def root_view(row):
        """A small real System root for runtime's tool: only the files its manifest reads (each program, the files its
        stub binds, usr/lib/dyld), copied from the System image and the OS and App cryptex images to the paths a booted
        Mac has (System/Volumes/Preboot/Cryptexes/{OS,App}/...). Real copies: hao-embed refuses a path that resolves
        outside ROOT, so symlinks or a read-only System image without those folders do not serve."""
        view = r.work / ('root-view-' + row)
        if view.exists() or r.dry:
            return view
        system = root()
        cryptexes = {'OS': r.mount(userspace() / 'os.dmg', 'os'), 'App': r.mount(userspace() / 'app.dmg', 'app')}
        manifest = json.loads((P(row) / 'embed/manifest.json').read_text())
        rels = {'usr/lib/dyld'}
        for e in manifest['files']:
            rels.add(e['path'])
            rels.update(b['file'] for b in e.get('bound', []) if b.get('file'))
        prefix = 'System/Volumes/Preboot/Cryptexes/'
        for rel in sorted(rels):
            if rel.startswith(prefix):
                name, _, inner = rel[len(prefix):].partition('/')
                src = cryptexes[name] / inner
            else:
                src = system / rel
            dst = view / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            if src.is_file():                   # bytes and mode: system flags cannot be set as a user, and
                shutil.copyfile(src, dst)       # the programs carry their signatures inside
                shutil.copymode(src, dst)
        return view

    completions = [([row], lambda row=row: runtime(row))
                   for row in ('hao_runtime', 'hao_runtime_fold', 'hao_runtime_fold_catalog')]
    if (TOP / 'tools/live-text/on-mac').is_file():      # a checkout before metal's producers lists those rows as waiting
        completions += [(['live_text_framework'], live_text), (['metal_compiler_compat'], compiler_service)]
    return [(['golden_gate_userspace'], gg_userspace), (['darwin27_kernel'], kernel), (['python_site'], python_site),
            (['oclp_hardware'], oclp_hardware), (['qemu_reference_efi'], qemu_reference), (DONOR_ROWS, donors), (['tahoe_kc_builder'], kc_builder),
            (['hello_metallib_golden_gate', 'metallib_repairs_golden_gate'], metallibs),
            (['metal_quad_runtime_golden_gate'], quad)] + completions


def main():
    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    p.add_argument('release'); p.add_argument('--only', action='append', default=[])
    p.add_argument('--work', type=Path); p.add_argument('--dry-run', action='store_true')
    p.add_argument('--userspace-on', type=Path, help='write golden_gate_userspace\'s images here (the USB drive)')
    p.add_argument('--keep', action='store_true', help='keep the work trees (the donor pass) after their rows check')
    p.add_argument('--dev-runtime-tool', type=Path,
                   help='maintainers: hao-runtime-on-mac to use when the runtime archive carries none')
    p.add_argument('--cache', type=Path, help='the download cache (hao fetch): producers that come in a downloaded '
                   'archive are taken from it')
    args = p.parse_args()
    release = json.loads(Path(args.release).read_text())
    # git trusts this checkout in every producer (a user's checkout, run under sudo by create-installer)
    os.environ.update(runpy.run_path(str(TOP / 'pipeline' / 'source_commit.py'))['git_env'](os.environ, TOP))
    fs, a = folders(release)
    made = [m['row'] for m in release.get('made_on_mac', [])]
    # shipped assets whose Apple-derived files are made here (release.json "completed_on_mac")
    made += [x['row'] for x in release.get('assets', []) if x['row'] not in made and
             any(m.get('producer') for m in x.get('completed_on_mac') or [])]   # plain copies: place completes them
    work = args.work or Path(tempfile.mkdtemp(prefix='make-on-mac-', dir=TOP / 'store' / 'tmp'
                                              if (TOP / 'store' / 'tmp').is_dir() else None))
    work.mkdir(parents=True, exist_ok=True)
    log_path = work / 'make-on-mac.log'
    print('make-on-mac: %d rows made on this Mac; log %s' % (len(made), log_path))
    failed = []
    with open(log_path, 'a') as log:
        r = Run(fs, work, log, args.dry_run, release, args.userspace_on, args.keep, args.dev_runtime_tool)
        r.cache = args.cache
        if args.userspace_on and 'golden_gate_userspace' in made:
            # images made onto another drive (an earlier USB drive, still mounted or not) are not this drive's
            linked = artifact(path(fs, 'golden_gate_userspace'))
            drive = Path(os.path.realpath(args.userspace_on))
            if linked.is_symlink() and drive not in Path(os.path.realpath(linked)).parents and not args.dry_run:
                print('  the userspace images are on another drive (%s): made again onto %s' % (
                    os.readlink(linked), args.userspace_on), flush=True)
                linked.unlink()
        try:
            failed = run_steps(steps(r, fs, a), fs, made, args.only, args.dry_run)
        finally:
            r.close()
    rest = [x for x in made if x not in failed and not args.dry_run and not checks(fs, x)
            and (not args.only or x in args.only)]
    bad = failed + rest
    print('make-on-mac: %d of %d rows check%s' % (len([x for x in made if not args.only or x in args.only]) - len(bad),
                                                 len([x for x in made if not args.only or x in args.only]),
                                                 '' if not bad else '; not: ' + ' '.join(bad)))
    return 1 if bad else 0


if __name__ == '__main__':
    sys.exit(main())
