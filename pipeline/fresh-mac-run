#!/usr/bin/env python3.14
"""fresh-mac-run: a candidate release's USB installer made the user's way on a Tahoe Mac that has never built one.

  pipeline/fresh-mac-run RELEASE_DIR COMMIT [--vm VMDIR] [--mirror URL] [--host-mirror URL] [--out DIR]
                         [--user NAME] [--model M] [--mirror-fill TOOL] [--timeout SECONDS]

RELEASE_DIR is a cut's release folder (release.json, SHA256SUMS, their .sig files when signed, and the assets).
VMDIR (default $HAO_FRESH_MAC_VM) is a Tahoe builder clone (pipeline/vm/clones.py) with Xcode, python.org's Python
3.14 (root's alone) and an admin user NAME (default tester); it must be stopped.

  1. The mirror: every file the release needs (pipeline/mirror-list) is asked of HOST_MIRROR (default
     http://127.0.0.1:8765) by sha256. Missing files are added first with `TOOL fill - --from RELEASE_DIR` (the
     assets from RELEASE_DIR, other downloads from their origin) when --mirror-fill (or $HAO_MIRROR_FILL) names the
     mirror's tool; anything still missing fails the run before the VM starts.
  2. OUT/share/in: a git bundle of COMMIT, the release's files (release.json, SHA256SUMS and their signatures when signed), the candidate key line (this checkout's
     tools/hao/data/candidate-keys.pub, when there) and the guest scripts. OUT/share/out is where the guest writes.
  3. The VM starts with OUT/share; the guest is reset (old local.hao.e2e.* jobs booted out, the user's checkout,
     downloads, store, build folders, stick image and hao caches and /Library/Logs/hao removed; Xcode and Python
     kept). A root job then runs, as the user in a login shell: git clone of the bundle, the key line put in, and
     `sudo HAO_MIRROR=URL HAO_MIRROR_STRICT=1 tools/hao/hao create-installer --model M --release REL --image
     ~/stick.img --log json`. Passwordless sudo is given to the user for the run only (the user's typed password).
     The stick's sha256 and allocated size are recorded, then the stick is deleted; the job is booted out and the
     VM stopped.
  4. OUT/fresh-mac.json: commit, release_sha256, passed, seconds, stages (the guest's and create-installer's steps,
     from its --log json events), mirror_misses, stick_sha256, stick_allocated_bytes, rc and the log paths.

Passed: the clone is COMMIT, create-installer exited 0 with a run.end ok event, the stick was written and hashed,
and no mirror miss. Exit 0 only when passed.
"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

TOP = Path(__file__).resolve().parents[1]
PY = sys.executable
SHARE = '/private/var/ssdshare'           # where the builder VM's agent mounts the share in full macOS
LABEL = 'local.hao.e2e.fresh-mac'
RELEASE_FILES = ('release.json', 'SHA256SUMS')                    # always
SIGNATURE_FILES = ('release.json.sig', 'SHA256SUMS.sig')         # when signed: an owner-waived unsigned release has none
MISS = re.compile(r'mirror miss |not served by the mirror|MirrorMiss|"ev": "fetch\.mirror-failed"')
# what a run removes from the user's home before it starts (a clean base makes this moot)
RESET_PATHS = ('hao-patcher', 'fetch', 'store', 'make-work*', 'stick.img', 'e2e', 'Library/Caches/hao',
               'Library/Logs/hao')


def sha256(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for block in iter(lambda: f.read(1 << 22), b''):
            h.update(block)
    return h.hexdigest()


def git(*args, cwd):
    return subprocess.run(['git'] + [str(a) for a in args], cwd=cwd, capture_output=True, text=True,
                          check=True).stdout


def bundle(repo, commit, path):
    """A git bundle at PATH holding COMMIT as branch "candidate" (and HEAD), so a clone checks it out."""
    with tempfile.TemporaryDirectory(prefix='fresh-mac-bundle-') as d:
        bare = Path(d) / 'r.git'
        git('init', '-q', '--bare', bare, cwd=d)
        git('fetch', '-q', Path(repo).resolve(), commit + ':refs/heads/candidate', cwd=bare)
        git('symbolic-ref', 'HEAD', 'refs/heads/candidate', cwd=bare)
        git('bundle', 'create', '-q', Path(path).resolve(), 'HEAD', 'refs/heads/candidate', cwd=bare)


GUEST_JOB = r'''#!/bin/sh
# fresh-mac-run's guest job (root, launchd): runs user.sh as the user in a login shell, then keeps hao's logs.
I={share}/in; O={share}/out
. "$I/params"
mkdir -p "$O/logs"
mark() {{ echo "$(date +%s) $*" >> "$O/stages.txt"; }}
mark job-start
F=/etc/sudoers.d/hao-fresh-mac
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$GUSER" > $F.new && chmod 440 $F.new && visudo -cqf $F.new && mv $F.new $F \
    || {{ mark sudoers-failed; echo 1 > "$O/done"; exit 1; }}
su -l "$GUSER" -c "/bin/sh $I/user.sh" > "$O/user.log" 2>&1; rc=$?
rm -f $F
cp -R /Library/Logs/hao/. "$O/logs/" 2>/dev/null
mark job-end rc=$rc
echo $rc > "$O/done"
'''

USER_SH = r'''#!/bin/sh
# fresh-mac-run, as the user in a login shell: clone the commit, add the candidate key, sudo create-installer.
I={share}/in; O={share}/out
. "$I/params"
export TMPDIR="$(getconf DARWIN_USER_TEMP_DIR)"
mark() {{ echo "$(date +%s) $*" >> "$O/stages.txt"; }}
cd "$HOME" || exit 1
if [ -f "$I/release/hao" ]; then
    # A release bootstrap proof must run on a base without development installs.
    for tool in /Applications/Xcode*.app /Library/Developer/CommandLineTools /Library/Frameworks/Python.framework; do
        [ ! -e "$tool" ] || {{ echo "fresh Mac has development tools: $tool" >&2; exit 5; }}
    done
    mark bootstrap-start
    HAO_BOOTSTRAP_FILES="$I/release" HAO_MIRROR="$MIRROR" HAO_MIRROR_STRICT=1 \
        /bin/sh "$I/release/hao" create-installer --model "$MODEL" --image "$HOME/stick.img" --log json \
        < /dev/null > "$O/create-installer.jsonl" 2> "$O/create-installer.err"
    rc=$?
    release=$(plutil -extract release raw -o - "$I/release/release.json")
    cat "$HOME/hao-$release/kit/pipeline/SOURCE_COMMIT" > "$O/commit"
    mark bootstrap-end rc=$rc
else
mark clone-start
git clone -q "$I/hao-patcher.bundle" "$HOME/hao-patcher" && cd "$HOME/hao-patcher" && git checkout -q --detach "$COMMIT"
rc=$?; mark clone-end rc=$rc
[ $rc = 0 ] || exit $rc
git rev-parse HEAD > "$O/commit"
[ -f "$I/candidate-keys.pub" ] && cp "$I/candidate-keys.pub" tools/hao/data/candidate-keys.pub
mark create-installer-start
sudo HAO_MIRROR="$MIRROR" HAO_MIRROR_STRICT=1 tools/hao/hao create-installer --model "$MODEL" \
    --release "$I/release/release.json" --image "$HOME/stick.img" --log json \
    < /dev/null > "$O/create-installer.jsonl" 2> "$O/create-installer.err"
rc=$?; mark create-installer-end rc=$rc
fi
echo $rc > "$O/create-installer.rc"
if [ $rc = 0 ] && [ -f "$HOME/stick.img" ]; then
    mark stick-hash-start
    stat -f '%z %b' "$HOME/stick.img" > "$O/stick.stat"
    shasum -a 256 "$HOME/stick.img" | cut -d' ' -f1 > "$O/stick.sha256"
    mark stick-hash-end
fi
sudo rm -f "$HOME/stick.img"     # a failed run leaves a partly written image
exit $rc
'''

JOB_PLIST = '''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>Label</key><string>{label}</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>{share}/in/job.sh</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><false/></dict></plist>
'''


def reset_command(user):
    """The guest reset (root): old e2e jobs out, the user's earlier attempts and hao's caches and logs removed."""
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*', user):
        raise SystemExit('fresh-mac-run: %r is not a plain user name' % user)
    paths = ' '.join('/Users/%s/%s' % (user, p) for p in RESET_PATHS)
    return '\n'.join([
        'for l in $(launchctl list | awk \'$3 ~ /^local\\.hao\\.e2e\\./ {print $3}\'); do '
        'launchctl bootout system/$l 2>/dev/null; done',
        'rm -f /Library/LaunchDaemons/local.hao.e2e.*.plist /private/var/run/local.hao.e2e.*.plist '
        '/etc/sudoers.d/hao-fresh-mac',
        # a stick image still attached from an earlier attempt
        'for d in $(hdiutil info | awk \'/^image-path/ {p = ($0 ~ /stick\\.img$/)} '
        'p && /^\\/dev\\/disk[0-9]+[ \\t]/ {print $1; p = 0}\'); do hdiutil detach -force $d; done',
        'rm -rf %s /Library/Logs/hao /var/root/Library/Caches/hao' % paths,
        'launchctl list | grep -c "local\\.hao\\.e2e\\." || true',
        'df -k /System/Volumes/Data | awk \'NR == 2 {print "RESET-OK free_kb=" $4}\'',
    ])


def start_command():
    return 'cp %s/in/job.plist /private/var/run/%s.plist && launchctl bootstrap system /private/var/run/%s.plist ' \
           '&& echo JOB-STARTED' % (SHARE, LABEL, LABEL)


def stop_job_command():
    return 'launchctl bootout system/%s 2>/dev/null; rm -f /private/var/run/%s.plist /etc/sudoers.d/hao-fresh-mac; ' \
           'echo JOB-OUT' % (LABEL, LABEL)


def key_line(top=TOP):
    p = Path(top) / 'tools/hao/data/candidate-keys.pub'
    if not p.is_file():
        return None
    lines = [l for l in p.read_text().splitlines() if l.strip() and not l.lstrip().startswith('#')]
    return '\n'.join(lines) + '\n' if lines else None


def writable(top):
    """in/ is read-only while the guest runs; afterwards it is the owner's to move or remove again."""
    for p in [Path(top), *Path(top).rglob('*')]:
        if not p.is_symlink():
            p.chmod(0o755 if p.is_dir() else 0o644)


def prepare_share(share, release_dir, commit, repo, key, params):
    """OUT/share: in/ (bundle, release files, key, scripts, params; read-only) and an empty out/."""
    share = Path(share)
    if share.exists():
        writable(share)
        shutil.rmtree(share)
    inp, out = share / 'in', share / 'out'
    (inp / 'release').mkdir(parents=True)
    out.mkdir()
    for name in RELEASE_FILES:
        src = Path(release_dir) / name
        if not src.is_file():
            raise SystemExit('fresh-mac-run: %s has no %s' % (release_dir, name))
        shutil.copyfile(src, inp / 'release' / name)
    # The signatures go with the release when it has them. Whether an unsigned one may be used is hao's decision in the
    # guest (create-installer accepts only the versions in data/unsigned-releases.json, checked against SHA256SUMS).
    for name in SIGNATURE_FILES:
        src = Path(release_dir) / name
        if src.is_file():
            shutil.copyfile(src, inp / 'release' / name)
    if key:
        if 'PRIVATE KEY' in key:
            raise SystemExit('fresh-mac-run: the candidate key file holds a private key')
        (inp / 'candidate-keys.pub').write_text(key)
    bootstrap = Path(release_dir) / 'hao'
    if bootstrap.is_file():
        release = json.loads((Path(release_dir) / 'release.json').read_text())
        names = {'hao'} | {x['url'].rsplit('/', 1)[-1] for x in release['bootstrap'].values()}
        for name in names:
            if Path(name).name != name:
                raise ValueError('unsafe bootstrap filename')
            shutil.copyfile(Path(release_dir)/name, inp/'release'/name)
    else:
        bundle(repo, commit, inp / 'hao-patcher.bundle')
    (inp / 'params').write_text(''.join('%s=%s\n' % (k, shlex.quote(str(v))) for k, v in sorted(params.items())))
    (inp / 'job.sh').write_text(GUEST_JOB.format(share=SHARE))
    (inp / 'user.sh').write_text(USER_SH.format(share=SHARE))
    (inp / 'job.plist').write_text(JOB_PLIST.format(label=LABEL, share=SHARE))
    for p in inp.rglob('*'):
        p.chmod(0o555 if p.is_dir() else 0o444)
    inp.chmod(0o555)
    return dict(release_sha256=sha256(inp / 'release' / 'release.json'), bundle_sha256=sha256(inp / 'hao-patcher.bundle') if (inp/'hao-patcher.bundle').is_file() else None,
                bootstrap_sha256=sha256(inp/'release/hao') if bootstrap.is_file() else None)


# -- reading what the guest left

def read_events(path):
    """(events, other lines) of a --log json output: JSON objects with "ev", and everything else (backend output)."""
    events, other = [], []
    try:
        text = Path(path).read_text(errors='replace')
    except OSError:
        return events, other
    for line in text.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            e = None
        if isinstance(e, dict) and 'ev' in e:
            events.append(e)
        elif line.strip():
            other.append(line)
    return events, other


def installer_stages(events):
    """create-installer's stages from its events: the checks and setup before the first step, each numbered step to
    the next, the commands within a step (place, make-on-mac) to the next mark; [[name, seconds]]."""
    marks, end = [], None
    for e in events:
        if e.get('ev') == 'run.start' and not marks:
            marks.append(('preflight and setup', 0.0, 0))
        elif e.get('ev') == 'step.start':
            marks.append(('step: %s' % e.get('step'), float(e['t']), 0))
        elif e.get('ev') == 'command' and e.get('argv'):
            marks.append(('  ' + Path(str(e['argv'][2] if len(e['argv']) > 2 else e['argv'][-1])).name,
                          float(e['t']), 1))
        elif e.get('ev') == 'run.end':
            end = float(e['t'])
    if not marks:
        return []
    if marks[0][1] > 0:
        marks.insert(0, ('preflight and setup', 0.0, 0))
    end = end if end is not None else max(float(e.get('t', 0)) for e in events)
    out = []
    for i, (name, t, depth) in enumerate(marks):
        # a step lasts until the next step (or the end); a command until the next mark of either kind
        nxt = next((m[1] for m in marks[i + 1:] if depth or not m[2]), end)
        out.append([name, round(max(nxt - t, 0.0), 1)])
    return out


def guest_stages(path):
    """[[name, seconds, rc or None]] from the guest's stages.txt ("EPOCH NAME-start" / "EPOCH NAME-end rc=N")."""
    starts, out = {}, []
    try:
        lines = Path(path).read_text().splitlines()
    except OSError:
        return out
    for line in lines:
        parts = line.split()
        if len(parts) < 2 or not parts[0].isdigit():
            continue
        t, what = int(parts[0]), parts[1]
        if what.endswith('-start'):
            starts[what[:-6]] = t
        elif what.endswith('-end') and what[:-4] in starts:
            rc = next((int(p[3:]) for p in parts[2:] if p.startswith('rc=') and p[3:].lstrip('-').isdigit()), None)
            out.append([what[:-4], t - starts.pop(what[:-4]), rc])
    return out


def mirror_misses(*paths):
    found = []
    for p in paths:
        p = Path(p)
        files = sorted(x for x in p.rglob('*') if x.is_file()) if p.is_dir() else [p] if p.is_file() else []
        for f in files:
            for line in f.read_text(errors='replace').splitlines():
                if MISS.search(line) and line.strip() not in found:
                    found.append(line.strip()[:400])
    return found


def verdict(r):
    """(passed, reasons) for a result."""
    if str(r.get('error') or '').startswith('not started'):
        return False, [r['error']]
    why = []
    if r.get('clone_commit') != r.get('commit'):
        why.append('the clone is %s, not %s' % (r.get('clone_commit'), r.get('commit')))
    if r.get('rc') != 0:
        why.append('create-installer exited %s' % r.get('rc'))
    if not r.get('run_end_ok'):
        why.append('create-installer has no run.end ok event')
    if not r.get('stick_sha256'):
        why.append('no stick was written and hashed')
    if r.get('mirror_misses'):
        why.append('%d mirror misses' % len(r['mirror_misses']))
    if r.get('mirror_missing'):
        why.append('%d files the release needs are not on the mirror' % len(r['mirror_missing']))
    if r.get('error'):
        why.append(r['error'])
    return not why, why


def collect(out_dir, record):
    """Fill RECORD from the guest's OUT_DIR (share/out)."""
    out_dir = Path(out_dir)
    events, other = read_events(out_dir / 'create-installer.jsonl')
    end = next((e for e in reversed(events) if e.get('ev') == 'run.end'), None)
    rc_file = out_dir / 'create-installer.rc'
    stat = (out_dir / 'stick.stat').read_text().split() if (out_dir / 'stick.stat').is_file() else []
    gstages = guest_stages(out_dir / 'stages.txt')
    record.update(
        clone_commit=(out_dir / 'commit').read_text().strip() if (out_dir / 'commit').is_file() else None,
        rc=int(rc_file.read_text().strip()) if rc_file.is_file() and rc_file.read_text().strip().lstrip('-').isdigit()
        else None,
        run_end_ok=bool(end and end.get('ok')),
        stopped=None if not end or end.get('ok') else {k: end.get(k) for k in ('what', 'why', 'cause')},
        stages=dict(guest=gstages, create_installer=installer_stages(events)),
        seconds=next((s[1] for s in gstages if s[0] == 'job'), sum(s[1] for s in gstages)),
        mirror_misses=mirror_misses(out_dir / 'create-installer.jsonl', out_dir / 'create-installer.err',
                                    out_dir / 'user.log', out_dir / 'logs'),
        stick_sha256=((out_dir / 'stick.sha256').read_text().strip() or None)
        if (out_dir / 'stick.sha256').is_file() else None,
        stick_size_bytes=int(stat[0]) if len(stat) == 2 else None,
        stick_allocated_bytes=int(stat[1]) * 512 if len(stat) == 2 else None,
        logs={k: str(out_dir / n) for k, n in (('events', 'create-installer.jsonl'), ('stderr', 'create-installer.err'),
                                                ('user', 'user.log'), ('stages', 'stages.txt'), ('hao', 'logs'))
              if (out_dir / n).exists()},
        backend_lines=len(other))
    return record


# -- the mirror

def mirror_list(release, top=TOP):
    p = subprocess.run([PY, '-I', str(Path(top) / 'pipeline/mirror-list'), str(release)], capture_output=True,
                       text=True)
    if p.returncode:
        raise SystemExit('fresh-mac-run: mirror-list failed: %s' % p.stderr.strip()[-400:])
    return [l for l in p.stdout.splitlines() if l.strip() and not l.startswith('#')]


def on_mirror(url, hexsha, opener=urllib.request.urlopen):
    try:
        with opener(urllib.request.Request(url.rstrip('/') + '/sha256/' + hexsha, method='HEAD'), timeout=20) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def mirror_missing(lines, url, check=on_mirror):
    return [l for l in lines if not check(url, l.split()[0])]


def fill_mirror(tool, missing, release_dir, run=subprocess.run):
    """Add the missing files to the mirror: the release's assets from RELEASE_DIR, the rest from their origin (the
    mirror's tool checks each by size and sha256; an entry without an origin, ?, cannot be filled)."""
    fill = [l for l in missing if len(l.split(' ', 3)) == 4 and l.split(' ', 3)[2] != '?']
    if fill:
        run([str(tool), 'fill', '-', '--from', str(release_dir)], input='\n'.join(fill) + '\n', text=True,
            check=False)
    return fill


# -- the VM

class VM:
    """The builder clone through pipeline/vm (clones.py start, vmctl exec, stop.sh)."""

    def __init__(self, vmdir, store):
        self.vm = Path(vmdir).resolve()
        self.env = dict(os.environ, VMBIN=os.environ.get('VMBIN', str(Path(store) / 'vm/bin')),
                        VMCTL=str(TOP / 'pipeline/vm/vmctl'))

    def running(self):
        pid = Path(str(self.vm) + '.run') / 'ssdvm.pid'
        if not pid.is_file():
            return False
        return subprocess.run(['ps', '-p', pid.read_text().strip()], capture_output=True).returncode == 0

    def start(self, share):
        return subprocess.run([PY, '-I', str(TOP / 'pipeline/vm/clones.py'), 'start', str(self.vm), str(share)],
                              env=self.env).returncode

    def exec(self, cmd, timeout=600):
        p = subprocess.run([str(TOP / 'pipeline/vm/vmctl'), str(self.vm), 'exec', cmd], env=self.env,
                           capture_output=True, text=True, timeout=timeout + 30)
        return p.returncode, p.stdout + p.stderr

    def stop(self):
        return subprocess.run(['zsh', str(TOP / 'pipeline/vm/stop.sh'), str(self.vm)], env=self.env).returncode


def wait_done(out_dir, vm, timeout, clock=time.monotonic, sleep=time.sleep):
    end = clock() + timeout
    while clock() < end:
        if (Path(out_dir) / 'done').is_file():
            return True
        if not vm.running():
            return False
        sleep(15)
    return False


def main(argv=None, vm=None, store=None, check=on_mirror, run=subprocess.run, needs=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('release_dir', type=Path)
    ap.add_argument('commit')
    ap.add_argument('--vm', default=os.environ.get('HAO_FRESH_MAC_VM'))
    ap.add_argument('--mirror', default='http://192.168.64.1:8765', help='the mirror as the guest reaches it')
    ap.add_argument('--host-mirror', default='http://127.0.0.1:8765', help='the same mirror as this Mac reaches it')
    ap.add_argument('--mirror-fill', default=os.environ.get('HAO_MIRROR_FILL'),
                    help='the mirror\'s tool, to add the files it lacks (apple-mirror)')
    ap.add_argument('--out', type=Path)
    ap.add_argument('--user', default='tester')
    ap.add_argument('--model', default='MacBookPro9,2')
    ap.add_argument('--timeout', type=int, default=4 * 3600)
    a = ap.parse_args(argv)
    if not a.vm and vm is None:
        ap.error('give --vm VMDIR (or set HAO_FRESH_MAC_VM)')
    commit = git('rev-parse', '--verify', a.commit + '^{commit}', cwd=TOP).strip()
    store = Path(store) if store else (TOP / 'store').resolve()
    out = (a.out or store / 'artifacts' / ('fresh-mac-' + commit[:8])).resolve()
    out.mkdir(parents=True, exist_ok=True)
    release_dir = a.release_dir.resolve()
    vm = vm or VM(a.vm, store)
    record = dict(commit=commit, release_dir=str(release_dir), vm=str(getattr(vm, 'vm', a.vm)), mirror=a.mirror,
                  model=a.model, user=a.user, passed=False,
                  started=datetime.datetime.now().astimezone().isoformat(timespec='seconds'))
    result = out / 'fresh-mac.json'

    def finish():
        record['passed'], record['reasons'] = verdict(record)
        record['finished'] = datetime.datetime.now().astimezone().isoformat(timespec='seconds')
        result.write_text(json.dumps(record, indent=1) + '\n')
        print('fresh-mac-run: %s %s%s  (%s)' % (commit[:8], 'PASS' if record['passed'] else 'FAIL',
                                                '' if record['passed'] else ': ' + '; '.join(record['reasons']),
                                                result), flush=True)
        return 0 if record['passed'] else 1

    # 1. the mirror holds every file the release needs
    needed = (needs or mirror_list)(release_dir / 'release.json')
    missing = mirror_missing(needed, a.host_mirror, check)
    if missing and a.mirror_fill:
        record['mirror_filled'] = [l.split(' ', 3)[-1] for l in fill_mirror(a.mirror_fill, missing, release_dir, run)]
        missing = mirror_missing(missing, a.host_mirror, check)
    record['mirror_needed'] = len(needed)
    record['mirror_missing'] = missing
    if missing:
        record['error'] = 'not started: the mirror lacks files the release needs'
        return finish()
    if vm.running():
        record['error'] = 'not started: the VM is already running'
        return finish()
    # 2. the share
    share = out / 'share'
    record.update(prepare_share(share, release_dir, commit, TOP, key_line(),
                                dict(COMMIT=commit, MIRROR=a.mirror, MODEL=a.model, GUSER=a.user)))
    record['share'] = str(share)
    # 3. the guest
    t0 = time.monotonic()
    try:
        record['error'] = guest(vm, share, out, a)
    finally:
        record['wall_seconds'] = round(time.monotonic() - t0)
        collect(share / 'out', record)
        writable(share / 'in')
    # 4. the result
    return finish()


def guest(vm, share, out, a):
    """Start the VM, reset the guest, run the job, wait; the VM is stopped again whatever happens. An error or None."""
    if vm.start(share):
        return 'the VM did not start'
    try:
        rc, text = vm.exec(reset_command(a.user))
        (out / 'reset.log').write_text(text)
        if rc or 'RESET-OK' not in text:
            return 'the guest reset failed (rc %s)' % rc
        rc, text = vm.exec(start_command())
        if rc or 'JOB-STARTED' not in text:
            return 'the guest job did not start: %s' % text.strip()[-300:]
        print('fresh-mac-run: guest job started; waiting (at most %d s) for %s' % (a.timeout, share / 'out/done'),
              flush=True)
        if not wait_done(share / 'out', vm, a.timeout):
            return 'the guest job did not finish (timeout or the VM stopped)'
        return None
    finally:
        vm.exec(stop_job_command(), timeout=60)
        vm.stop()


