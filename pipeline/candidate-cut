#!/usr/bin/env python3.14
"""candidate-cut: one command from a commit to a candidate release and its MacBookPro9,2 USB installer images.

  pipeline/candidate-cut COMMIT [--out DIR] [--cache DIR] [--sign-key KEY] [--version vX.Y.Z] [--release NAME]
                         [--assembly NAME] [--dev-assembly NAME] [--no-dev | --only-dev] [--dev-overlay REV]
                         [--generic [--generic-assembly NAME]] [--fresh-mac [--mirror URL] [--fresh-mac-vm VMDIR]
                         [--host-mirror URL] [--mirror-tool TOOL]] [--qemu-boot]

For the hardware benches' acceptance runs. COMMIT is checked out detached in a new worktree (the cut sees only the
committed tree); there:
  1. release-cut --candidate --stage OUT/release (release.json "candidate": true; unvalidated recipes listed)
  2. with --sign-key, `ssh-keygen -Y sign -n hao-release` writes release.json.sig and SHA256SUMS.sig next to them, and
     KEY.pub goes into the cut's tools/hao/data/candidate-keys.pub (so the USB installer's hao trusts it);
     without it the image is made with --unsigned (a developer path: say so to whoever boots it)
  3. hao fetch release.json --assets-from OUT/release (downloads by sha256 into CACHE, kept between cuts)
  4. hao create-installer --model MacBookPro9,2 --release release.json --image OUT/stick.img
     (the user's path, on this Mac; an image file instead of a drive, so no root)
  5. the dev stick, from the same commit, the same way into OUT/dev/: release-cut --candidate --dev with the dev
     assembly (DEV_ASSEMBLY: the alpha set plus pack dev; release.json "dev": true, never published), signed with the
     same key, fetched, and hao create-installer --image OUT/dev/stick.img. --no-dev leaves it out; a commit without
     the dev assembly or release-cut --dev is recorded as skipped, unless --dev-overlay REV gives it REV's dev cut:
     the changes REV made to DEV_FILES since its merge base with COMMIT are applied in the cut's worktree after the
     release stick, the dev set generated there again, and committed there (recorded in candidate.json
     "dev_overlay"). --only-dev makes only the dev stick.
  6. OUT/stick.img.sha256, OUT/dev/stick.img.sha256 and OUT/candidate.json (also written, with "stick": that
     stick's entry, into OUT/dev and OUT/generic, the other folders that hold a stick): commit, each stick (path, size, sha256),
     release.json sha256s, signed or not, each step's seconds and log, create-installer's phases (from its event log
     in OUT/logs and OUT/dev/logs), and "dev": the dev stick's own record. Exit 0 only when every step passed.
  --generic: the release is cut with the generic assembly too (release-cut ASSEMBLY GENERIC_ASSEMBLY, one release
     for both profiles), and after the 9,2 stick a second one, hao create-installer --profile generic --image
     OUT/generic/stick.img (OUT/generic/stick.img.sha256), listed in "sticks" as "generic".
  7. with --qemu-boot, first of the two checks (never at the same time as --fresh-mac: both use a macOS VM):
     pipeline/qemu-first-boot --out OUT/qemu-boot builds the commit's dev-lite image (OUT/qemu-boot/image;
     pipeline/qemu-boot.json says which), boots it once in QEMU to the first-boot marker (sshd up, the listed processes
     running, no panic) and writes OUT/qemu-boot/qemu-boot.json. candidate.json "qemu_boot" is "PASS" or "FAIL" and
     "qemu_boot_record" that record (null without --qemu-boot). candidate.json (and each stick folder's copy) is
     written as soon as it finishes, with "fresh_mac" "PENDING" when --fresh-mac follows, so a laptop install can
     start on the QEMU result while the fresh-Mac run goes on; it is written again at the end.
  8. with --fresh-mac, last: pipeline/fresh-mac-run OUT/release COMMIT --out OUT/fresh-mac (the release stick made
     again the user's way, `sudo ./hao create-installer` from a git clone on a reset Tahoe VM, every download from the
     local mirror URL, default http://192.168.64.1:8765, in strict mode; VMDIR default $HAO_FRESH_MAC_VM).
     candidate.json "fresh_mac" is "PASS" or "FAIL" and "fresh_mac_result" its OUT/fresh-mac/fresh-mac.json (null
     without --fresh-mac); a FAIL makes candidate-cut exit 1, and such a candidate goes to no bench. It checks the
     MacBookPro9,2 stick only. candidate.json is written for every cut, a failed one too.
     Before it, the mirror fill: every file the release needs (the commit's pipeline/mirror-list) that the mirror
     lacks (asked of HOST_MIRROR, default http://127.0.0.1:8765) and that the cut's own OUT/release holds (same name,
     size and sha256) is added with `TOOL add FILE --name NAME --origin URL --expect SHA256` (TOOL: --mirror-tool,
     default $HAO_MIRROR_FILL, the mirror's tool), so a new release asset never fails the run as a mirror miss.
     Recorded as candidate.json "mirror_fill" (added, not_in_release, failed); what is still missing fails
     fresh-mac-run as before.
     Both checks run even when the other failed; either FAIL makes candidate-cut exit 1.
OUT defaults to store/artifacts/candidate-COMMIT8; CACHE to store/cache/candidate-fetch. Rows made on this Mac are
reused by their pins (make-on-mac leaves a row whose sha256 checks), so the dev stick costs about one more kit write.
"""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tempfile
import time

TOP = Path(__file__).resolve().parents[1]
PY = sys.executable
MODEL = 'MacBookPro9,2'
FRESH = runpy.run_path(str(TOP / 'pipeline' / 'fresh-mac-run'))


def sha256(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for block in iter(lambda: f.read(1 << 22), b''):
            h.update(block)
    return h.hexdigest()


def phases(logs):
    """create-installer's phases from its event log (HAO_LOGS/create-installer-*.json): [(name, seconds)], each
    command and task from its start to the next one's."""
    found = sorted(Path(logs).glob('create-installer-*.json'))
    if not found:
        return None
    try:
        events = json.loads(found[-1].read_text())['events']
    except (OSError, ValueError, KeyError):
        return None
    marks = []
    for e in events:
        if e['ev'] == 'run.start':
            marks.append(('doctor and questions', 0.0))
        elif e['ev'] == 'step.start':
            marks.append(('step: ' + str(e.get('step')), e['t']))
        elif e['ev'] == 'command':
            marks.append((Path(e['argv'][2]).name, e['t']))
        elif e['ev'] == 'task.start':
            marks.append((' '.join(str(e.get('text') or e.get('label') or '').split()), e['t']))
        elif e['ev'] in ('task.end', 'run.end'):
            marks.append(('', e['t']))
    out = []
    for (name, t), (_, nxt) in zip(marks, marks[1:]):
        if name and nxt - t >= 0.5:
            out.append([name, round(nxt - t, 1)])
    return out


def fresh_mac_result(where):
    """OUT/fresh-mac/fresh-mac.json, or None when fresh-mac-run wrote none."""
    try:
        return json.loads((Path(where) / 'fresh-mac.json').read_text())
    except (OSError, ValueError):
        return None


def qemu_boot_result(where):
    """OUT/qemu-boot/qemu-boot.json, or None when qemu-first-boot wrote none."""
    try:
        return json.loads((Path(where) / 'qemu-boot.json').read_text())
    except (OSError, ValueError):
        return None


def release_file(release_dir, name, size, digest):
    """The file called NAME, of SIZE bytes and sha256 DIGEST, in the cut's release folder (or below), or None."""
    name = name.replace('%20', ' ')
    for folder, _, files in sorted(os.walk(release_dir)):
        p = Path(folder) / name
        if name in files and p.is_file() and not p.is_symlink() and p.stat().st_size == size and sha256(p) == digest:
            return p
    return None


def fill_mirror(release_dir, host_mirror, tool, needs, check, run=subprocess.run):
    """Add to the mirror every file the release needs that it lacks and the cut's release folder holds, one
    `TOOL add` each (the tool checks the sha256 again). Returns the record."""
    rec = dict(host_mirror=host_mirror, tool=str(tool) if tool else None, added=[], not_in_release=[], failed=[])
    try:
        lines = needs(Path(release_dir) / 'release.json')
    except SystemExit as x:
        rec['error'] = str(x)
        return rec
    missing = FRESH['mirror_missing'](lines, host_mirror, check)
    rec.update(needed=len(lines), missing=[l.split(' ', 3)[-1] for l in missing])
    for line in missing:
        digest, size, origin, name = line.split(' ', 3)
        found = release_file(release_dir, name, int(size), digest)
        if found is None:
            rec['not_in_release'].append(name)
            continue
        if not tool:
            rec['failed'].append(name)
            continue
        cmd = [str(tool), 'add', str(found), '--name', name, '--expect', digest]
        if origin != '?':
            cmd += ['--origin', origin]
        p = run(cmd, capture_output=True, text=True)
        (rec['added'] if p.returncode == 0 and check(host_mirror, digest) else rec['failed']).append(name)
    if rec['failed'] and not tool:
        rec['error'] = 'no mirror tool (--mirror-tool or $HAO_MIRROR_FILL): release assets not added'
    return rec


def write_records(record, out):
    """OUT/candidate.json, and in each other stick folder the cut's whole record plus that stick's entry (a bench's
    arm gate reads candidate.json in the folder of the stick it writes)."""
    (out / 'candidate.json').write_text(json.dumps(record, indent=1) + '\n')
    for entry in record['sticks']:
        folder = Path(entry['path']).parent
        if folder != out and folder.is_dir():
            (folder / 'candidate.json').write_text(json.dumps(dict(record, stick=entry), indent=1) + '\n')


def run_step(cmd, cwd, log, env):
    with open(log, 'w') as f:
        return subprocess.run([str(c) for c in cmd], cwd=cwd, stdout=f, stderr=subprocess.STDOUT,
                              stdin=subprocess.DEVNULL, env=env).returncode


def checkout(sha, tree):
    subprocess.run(['git', 'worktree', 'add', '-q', '--detach', str(tree), sha], cwd=TOP, check=True)


def remove_checkout(tree):
    subprocess.run(['git', 'worktree', 'remove', '--force', str(tree)], cwd=TOP, capture_output=True)


DEV_FILES = ['pipeline/release-cut', 'pipeline/patches.py', 'pipeline/release-classes.json',
             'pipeline/profiles/dev-alpha-v0.1.0.json', 'pipeline/sets/dev-alpha-v0.1.0.txt',
             'pipeline/assemblies/dev-26B131-alpha-v0.1.0.json']


def git(*args, cwd=TOP, **kw):
    return subprocess.run(['git'] + list(args), cwd=cwd, capture_output=True, text=True, check=True, **kw).stdout


def dev_overlay(tree, sha, rev, repo=TOP):
    """Give a commit without the dev cut the dev cut of REV, for the dev stick only: the changes REV made to DEV_FILES
    since its merge base with SHA, applied (three-way) in the cut's worktree, the dev set generated there again, and
    committed there (release-cut cuts only a clean tree). Returns the record of what was done."""
    rev_sha = git('rev-parse', '--verify', rev + '^{commit}', cwd=repo).strip()
    base = git('merge-base', sha, rev_sha, cwd=repo).strip()
    patch = git('diff', '--binary', base, rev_sha, '--', *DEV_FILES, cwd=repo)
    if not patch.strip():
        raise RuntimeError('%s changes none of the dev cut files since %s' % (rev, base[:8]))
    subprocess.run(['git', 'apply', '--3way', '--index'], cwd=tree, input=patch, text=True, check=True,
                   capture_output=True)
    profile = 'pipeline/profiles/dev-alpha-v0.1.0.json'
    generated = subprocess.run([PY, '-I', 'pipeline/patches.py', 'set', profile], cwd=tree, capture_output=True,
                               text=True, check=True).stdout
    set_file = tree / 'pipeline/sets/dev-alpha-v0.1.0.txt'
    names = lambda t: [l.split('#')[0].strip() for l in t.splitlines() if l.split('#')[0].strip()]
    regenerated = names(generated) != names(set_file.read_text())
    if regenerated:
        set_file.write_text(generated)
        git('add', str(set_file.relative_to(tree)), cwd=tree)
    git('commit', '-q', '-m',
        'Dev cut on %s from %s' % (sha[:8], rev_sha[:8]), '-m',
        'The dev profile, set and assembly and release-cut --dev, for a dev USB\ninstaller of this commit only.\n'
        'Tested: not run (a local commit of a candidate cut)', cwd=tree)
    return dict(base_commit=sha, from_rev=rev_sha, merge_base=base, files=DEV_FILES,
                patch_sha256=hashlib.sha256(patch.encode()).hexdigest(), set_regenerated=regenerated,
                cut_commit=git('rev-parse', 'HEAD', cwd=tree).strip())


def dev_skip(tree, assembly):
    """Why this commit cannot cut the dev stick, or None."""
    if not (tree / 'pipeline/assemblies' / (assembly + '.json')).is_file():
        return 'the commit has no pipeline/assemblies/%s.json' % assembly
    if "'--dev'" not in (tree / 'pipeline/release-cut').read_text():
        return 'the commit\'s release-cut has no --dev'
    return None


def main(argv=None, store=None, run=run_step, worktree=(checkout, remove_checkout), mirror=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('commit')
    ap.add_argument('--out', type=Path)
    ap.add_argument('--cache', type=Path)
    ap.add_argument('--sign-key')
    ap.add_argument('--version', default='v0.0.1')
    ap.add_argument('--release', default='27.2.1-26B131.0')
    ap.add_argument('--assembly', default='mbp92-26B131-alpha-v0.1.0')
    ap.add_argument('--dev-assembly', default='dev-26B131-alpha-v0.1.0')
    ap.add_argument('--no-dev', action='store_true', help='make only the release stick')
    ap.add_argument('--only-dev', action='store_true', help='make only the dev stick')
    ap.add_argument('--dev-overlay', metavar='REV', help='a commit without the dev cut gets it from REV (dev stick only)')
    ap.add_argument('--generic', action='store_true', help='also the generic profile: one release, a second stick')
    ap.add_argument('--generic-assembly', default='generic-26B131')
    ap.add_argument('--fresh-mac', action='store_true', help='last: the release stick made the user\'s way on a reset VM')
    ap.add_argument('--mirror', default='http://192.168.64.1:8765', help='--fresh-mac: the mirror, as the VM reaches it')
    ap.add_argument('--fresh-mac-vm', default=os.environ.get('HAO_FRESH_MAC_VM'), metavar='VMDIR',
                    help='--fresh-mac: the Tahoe builder clone (default $HAO_FRESH_MAC_VM)')
    ap.add_argument('--host-mirror', default='http://127.0.0.1:8765', help='--fresh-mac: the mirror, as this Mac '
                    'reaches it (the mirror fill asks it)')
    ap.add_argument('--mirror-tool', default=os.environ.get('HAO_MIRROR_FILL'), metavar='TOOL',
                    help='--fresh-mac: the mirror\'s tool, to add the release assets it lacks (default $HAO_MIRROR_FILL)')
    ap.add_argument('--qemu-boot', action='store_true',
                    help='last: the commit\'s dev-lite image built and booted once in QEMU to the first-boot marker')
    a = ap.parse_args(argv)
    if a.no_dev and (a.only_dev or a.dev_overlay):
        ap.error('--no-dev excludes --only-dev and --dev-overlay')
    if a.generic and a.only_dev:
        ap.error('--generic cuts with the release stick: not with --only-dev')
    if a.fresh_mac and a.only_dev:
        ap.error('--fresh-mac checks the release stick: not with --only-dev')
    if a.fresh_mac and not a.fresh_mac_vm:
        ap.error('--fresh-mac needs --fresh-mac-vm VMDIR (or HAO_FRESH_MAC_VM)')
    sha = subprocess.run(['git', 'rev-parse', '--verify', a.commit + '^{commit}'], cwd=TOP, capture_output=True,
                         text=True, check=True).stdout.strip()
    if store is None:
        if not (TOP / 'store').is_symlink() and not (TOP / 'store').is_dir():
            sys.exit('candidate-cut: %s has no store (link store to the local store first)' % TOP)
        store = (TOP / 'store').resolve()
    out = (a.out or store / 'artifacts' / ('candidate-' + sha[:8])).resolve()
    cache = (a.cache or store / 'cache' / 'candidate-fetch').resolve()
    if out.exists():
        sys.exit('candidate-cut: %s exists; remove it or give --out' % out)
    out.mkdir(parents=True)
    cache.mkdir(parents=True, exist_ok=True)
    record = dict(commit=sha, out=str(out), signed=bool(a.sign_key), steps=[], sticks=[], fresh_mac=None,
                  qemu_boot=None,
                  started=datetime.datetime.now().astimezone().isoformat(timespec='seconds'))
    work = Path(tempfile.mkdtemp(prefix='candidate-cut-'))
    tree = work / 'tree'
    try:
        worktree[0](sha, tree)
        (tree / 'store').symlink_to(store)
        if a.sign_key:
            Path(a.sign_key + '.pub').read_text()
    except (OSError, subprocess.CalledProcessError) as x:
        # a cut that stops here still says so in candidate.json
        record.update(passed=False, error='setup: %s' % x,
                      finished=datetime.datetime.now().astimezone().isoformat(timespec='seconds'))
        (out / 'candidate.json').write_text(json.dumps(record, indent=1) + '\n')
        worktree[1](tree)
        shutil.rmtree(work, ignore_errors=True)
        print('candidate-cut: %s FAILED before the first step: %s' % (sha[:8], x), file=sys.stderr)
        return 1
    # python.org's Python carries no CA bundle until its Install Certificates step runs; macOS's own is used instead,
    # so hao doctor's URL checks and the downloads verify against the system roots
    base_env = dict(os.environ)
    if not base_env.get('SSL_CERT_FILE') and Path('/etc/ssl/cert.pem').is_file():
        base_env['SSL_CERT_FILE'] = '/etc/ssl/cert.pem'
    if a.sign_key:
        # the candidate key's public line goes into this cut's hao (tools/hao/data/candidate-keys.pub, never tracked)
        # so the USB installer's hao accepts the candidate signature; final builds never carry it
        pub = Path(a.sign_key + '.pub').read_text().strip()
        (tree / 'tools/hao/data/candidate-keys.pub').write_text(pub + '\n')
        record['candidate_key'] = pub.split()[-1] if ' ' in pub else pub
    current = {'rec': record, 'out': out}

    def step(name, cmd, rec, where):
        log = where / ('%d-%s.log' % (len(rec['steps']) + 1, name))
        env = dict(base_env, HAO_LOGS=str(where / 'logs'))     # create-installer's event log, for the phase times
        if name.startswith('create-installer'):
            # Also survives the installer's per-profile manifest view in cache/.
            rel = Path(cmd[cmd.index('--release') + 1])
            env['HAO_BOOTSTRAP_FILES'] = str(rel.parent)
        t0 = time.time()
        rc = run(cmd, tree, log, env)
        rec['steps'].append(dict(name=name, rc=rc, seconds=round(time.time() - t0), log=str(log.relative_to(out))))
        print('%-4s %-20s %4d s  %s' % ('ok' if rc == 0 else 'FAIL', name, time.time() - t0, log), flush=True)
        if rc:
            current.update(rec=rec, out=where)
            raise SystemExit(1)

    def stick(kind, rec, where, assembly, extra, more=()):
        """release-cut, sign, fetch and create-installer into WHERE; returns the stick's entry."""
        rel = where / 'release' / 'release.json'
        suffix = '' if kind == 'release' else '-' + kind
        step('release-cut' + suffix, [PY, '-I', 'pipeline/release-cut', '--write', rel,
                                      'pipeline/assemblies/%s.json' % assembly,
                                      *['pipeline/assemblies/%s.json' % m for m in more], '--release', a.release,
                                      '--channel', 'dev', '--version', a.version, '--not-prerelease',
                                      '--stage', rel.parent] + extra, rec, where)
        unsigned = []
        if a.sign_key:
            step('sign' + suffix, ['ssh-keygen', '-Y', 'sign', '-f', a.sign_key, '-n', 'hao-release',
                                   rel, rel.parent / 'SHA256SUMS'], rec, where)
        else:
            unsigned = ['--unsigned']
        step('fetch' + suffix, [PY, '-I', 'tools/hao/hao', 'fetch', rel, '--cache', cache, '--assets-from',
                                rel.parent] + unsigned, rec, where)
        image = where / 'stick.img'
        step('create-installer' + suffix, [PY, '-I', 'tools/hao/hao', 'create-installer', '--model', MODEL,
                                           '--release', rel, '--cache', cache, '--image', image] + unsigned,
             rec, where)
        digest = sha256(image)
        (where / 'stick.img.sha256').write_text('%s  stick.img\n' % digest)
        entry = dict(kind=kind, name=kind, path=str(image), size=image.stat().st_size, sha256=digest,
                     release_json_sha256=sha256(rel), assembly=assembly)
        rec['phases'] = phases(where / 'logs')
        print('candidate-cut: %s %s %s stick %s  sha256 %s' % (sha[:8], 'signed' if a.sign_key else 'UNSIGNED', kind,
                                                               image, digest), flush=True)
        return entry

    def generic_stick(release_entry):
        """The generic profile's stick from the same release (cut with both assemblies), into OUT/generic."""
        where = out / 'generic'
        where.mkdir()
        rel = out / 'release' / 'release.json'
        image = where / 'stick.img'
        step('create-installer-generic', [PY, '-I', 'tools/hao/hao', 'create-installer', '--profile', 'generic',
                                          '--release', rel, '--cache', cache, '--image', image]
             + ([] if a.sign_key else ['--unsigned']), record, where)
        digest = sha256(image)
        (where / 'stick.img.sha256').write_text('%s  stick.img\n' % digest)
        print('candidate-cut: %s generic stick %s  sha256 %s' % (sha[:8], image, digest), flush=True)
        return dict(kind='generic', name='generic', path=str(image), size=image.stat().st_size, sha256=digest,
                    release_json_sha256=release_entry['release_json_sha256'], assembly=a.generic_assembly,
                    phases=phases(where / 'logs'))

    try:
        # a commit from before release-cut had --candidate cuts as it did then (recorded)
        candidate = ['--candidate'] if '--candidate' in (tree / 'pipeline/release-cut').read_text() else []
        record['candidate_flag'] = bool(candidate)
        if a.only_dev:
            record['release_stick'] = dict(skipped='--only-dev')
        else:
            entry = stick('release', record, out, a.assembly, candidate,
                          more=[a.generic_assembly] if a.generic else ())
            record['sticks'].append(entry)
            profiles = json.loads((out / 'release' / 'release.json').read_text()).get('profiles')
            if isinstance(profiles, dict):
                record['profiles'] = sorted(profiles)
            if a.generic:
                record['sticks'].append(generic_stick(entry))
            record.update(release_json_sha256=entry['release_json_sha256'], image=entry['path'],
                          image_size=entry['size'], image_sha256=entry['sha256'])
        if a.dev_overlay and not a.no_dev:
            # after the release stick: it is cut from the commit as it is
            record['dev_overlay'] = dev_overlay(tree, sha, a.dev_overlay)
            print('candidate-cut: dev cut files from %s applied and committed in the cut (%s)' % (
                a.dev_overlay, record['dev_overlay']['cut_commit'][:8]), flush=True)
        if a.no_dev:
            record['dev'] = dict(skipped='--no-dev')
        elif dev_skip(tree, a.dev_assembly):
            record['dev'] = dict(skipped=dev_skip(tree, a.dev_assembly))
            print('candidate-cut: no dev stick: %s' % record['dev']['skipped'], file=sys.stderr)
        else:
            dev = record['dev'] = dict(assembly=a.dev_assembly, out=str(out / 'dev'), steps=[])
            (out / 'dev').mkdir()
            dev_entry = stick('dev', dev, out / 'dev', a.dev_assembly, ['--candidate', '--dev'])
            dev.update(image=dev_entry['path'], image_size=dev_entry['size'], image_sha256=dev_entry['sha256'],
                       release_json_sha256=dev_entry['release_json_sha256'], passed=True)
            record['sticks'].append(dev_entry)
        failed_checks = []
        if a.qemu_boot:
            where = out / 'qemu-boot'
            try:
                step('qemu-boot', [PY, '-I', 'pipeline/qemu-first-boot', '--out', where, '--commit', sha], record, out)
            except SystemExit:
                failed_checks.append('qemu-boot')
            finally:
                result = qemu_boot_result(where)
                record['qemu_boot'] = 'PASS' if result and result.get('qemu_boot') == 'PASS' else 'FAIL'
                record['qemu_boot_record'] = result
            if a.fresh_mac:
                record['fresh_mac'] = 'PENDING'
            write_records(record, out)          # the QEMU result on disk now, not after the fresh-Mac run
        if a.fresh_mac:
            m = mirror or {}
            fill = record['mirror_fill'] = fill_mirror(
                out / 'release', a.host_mirror, a.mirror_tool,
                m.get('needs') or (lambda rel: FRESH['mirror_list'](rel, top=tree)),
                m.get('check') or FRESH['on_mirror'], m.get('run') or subprocess.run)
            print('candidate-cut: mirror fill: %d needed, %d missing, %d added from the release%s' % (
                fill.get('needed', 0), len(fill.get('missing', [])), len(fill['added']),
                '; ' + fill['error'] if fill.get('error') else ''), flush=True)
            fresh = out / 'fresh-mac'
            try:
                step('fresh-mac', [PY, '-I', 'pipeline/fresh-mac-run', out / 'release', sha, '--vm', a.fresh_mac_vm,
                                   '--mirror', a.mirror, '--host-mirror', a.host_mirror, '--out', fresh], record, out)
            except SystemExit:
                failed_checks.append('fresh-mac')
            finally:
                result = fresh_mac_result(fresh)
                record['fresh_mac'] = 'PASS' if result and result.get('passed') else 'FAIL'
                record['fresh_mac_result'] = result
        if failed_checks:
            current.update(rec=record, out=out)
            raise SystemExit(1)
        record['passed'] = True
        return 0
    except (RuntimeError, subprocess.CalledProcessError) as x:
        record['passed'] = False
        record['dev_overlay'] = dict(failed=str(x) + (' ' + x.stderr.strip() if getattr(x, 'stderr', None) else ''))
        print('candidate-cut: %s FAILED: the dev overlay: %s' % (sha[:8], record['dev_overlay']['failed']),
              file=sys.stderr)
        return 1
    except SystemExit:
        record['passed'] = False
        rec = current['rec']
        if rec is not record:
            rec['passed'] = False
        bad = [s for s in rec['steps'] if s['rc']] or rec['steps'][-1:]
        print('candidate-cut: %s FAILED at %s (see %s)' % (sha[:8], ', '.join(s['name'] for s in bad),
                                                         ', '.join(str(out / s['log']) for s in bad)), file=sys.stderr)
        return 1
    finally:
        if 'phases' not in record:
            record['phases'] = phases(out / 'logs')
        if isinstance(record.get('dev'), dict) and 'steps' in record['dev'] and 'phases' not in record['dev']:
            record['dev']['phases'] = phases(out / 'dev' / 'logs')
        record['finished'] = datetime.datetime.now().astimezone().isoformat(timespec='seconds')
        write_records(record, out)
        worktree[1](tree)
        shutil.rmtree(work, ignore_errors=True)


if __name__ == '__main__':
