#!/usr/bin/env python3
"""python-site: the site-packages folder OCLP imports in the builder (row python_site), made from pinned PyPI wheels.

  python-site make OUT [LOCK...]      unpack every python_site_* wheel row into OUT/site, record OUT/build.json
  python-site check SITE [LOCK...]    exit 1 unless SITE is exactly what `make` makes from those rows

LOCK is a lock folder (default pipeline/inputs/common); the wheels are its rows named python_site_*, each a .whl file
under store/packages/pypi/ that release.json lists as a download (url, size, sha256). Each wheel is unpacked as is:
its files byte for byte, 0755 when its archive marks them executable and 0644 otherwise (pip's modes under umask
022), its own dist-info including RECORD. Left
out, as nothing imports them: *.data/scripts, *.data/data and *.data/headers entries (purelib and platlib go to the
top), console scripts, INSTALLER/REQUESTED and byte code. Two wheels may not write the same file. The result
depends only on the wheels: the same bytes, names and modes every time, so the row's content sha256 holds on any Mac.
"""
import datetime
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import runpy
import subprocess
import sys
import zipfile

TOP = Path(__file__).resolve().parents[1]
PREFIX = 'python_site_'


def wheels(locks):
    """[(row, sha256, path)] of the python_site_* rows, first lock folder wins, sorted by row."""
    lock = runpy.run_path(str(TOP / 'pipeline' / 'lock.py'))
    found = {}
    for folder in locks:
        for name, (sha, path) in lock['rows'](str(folder)).items():
            if name.startswith(PREFIX) and name not in found:
                found[name] = (sha, Path(path))
    if not found:
        raise ValueError('no %s* rows in %s' % (PREFIX, ', '.join(map(str, locks))))
    out = []
    for name, (sha, path) in sorted(found.items()):
        if not path.name.endswith('.whl'):
            raise ValueError('%s: %s is not a wheel' % (name, path))
        if hashlib.sha256(path.read_bytes()).hexdigest() != sha:
            raise ValueError('%s: %s is not %s' % (name, path, sha))
        out.append((name, sha, path))
    return out


def members(wheel):
    """[(relative path in the site, ZipInfo)] of a wheel, refusing unsafe names."""
    out = []
    with zipfile.ZipFile(wheel) as z:
        for info in z.infolist():
            if info.is_dir():
                continue
            parts = PurePosixPath(info.filename).parts
            if not parts or info.filename.startswith('/') or '..' in parts:
                raise ValueError('%s: unsafe entry %r' % (wheel.name, info.filename))
            if parts[0].endswith('.data'):
                if len(parts) > 2 and parts[1] in ('purelib', 'platlib'):
                    out.append(('/'.join(parts[2:]), info))
                continue                      # scripts, data, headers: not imported
            out.append((info.filename, info))
    return out


def make_site(rows, site):
    site = Path(site)
    site.mkdir(parents=True, exist_ok=False)
    written = {}
    for name, _, wheel in rows:
        with zipfile.ZipFile(wheel) as z:
            for rel, info in members(wheel):
                if rel in written:
                    raise ValueError('%s and %s both write %s' % (written[rel], name, rel))
                written[rel] = name
                target = site / rel
                for parent in reversed(target.relative_to(site).parents[:-1]):
                    (site / parent).mkdir(exist_ok=True)
                    os.chmod(site / parent, 0o755)
                target.write_bytes(z.read(info))
                # as pip installs it (umask 022): executable when the archive marks it so
                os.chmod(target, 0o755 if (info.external_attr >> 16) & 0o111 else 0o644)
    os.chmod(site, 0o755)
    return written


def make(out, locks):
    out = Path(out)
    rows = wheels(locks)
    out.mkdir(parents=True, exist_ok=False)
    written = make_site(rows, out / 'site')
    lock = runpy.run_path(str(TOP / 'pipeline' / 'lock.py'))
    git = lambda *a: subprocess.run(['git', '-C', str(TOP), *a], capture_output=True, text=True).stdout.strip()
    record = dict(unit='pipeline/python-site', operation='make', commit=git('rev-parse', 'HEAD'),
                  dirty=bool(git('status', '--porcelain', '--', 'pipeline/python-site')),
                  date=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                  wheels={name: dict(file=path.name, sha256=sha) for name, sha, path in rows},
                  files=len(written), content_sha256=lock['content_sha256'](str(out / 'site')))
    (out / 'build.json').write_text(json.dumps(record, indent=2) + '\n')
    return record


def check(site, locks):
    """Problems: SITE differs from what make() makes from the rows."""
    import tempfile
    lock = runpy.run_path(str(TOP / 'pipeline' / 'lock.py'))
    with tempfile.TemporaryDirectory() as tmp:
        make_site(wheels(locks), Path(tmp) / 'site')
        want = lock['content_sha256'](str(Path(tmp) / 'site'))
    have = lock['content_sha256'](str(site))
    return [] if want == have else ['%s: content %s, the wheels make %s' % (site, have, want)]


def main(argv):
    if len(argv) < 2 or argv[0] not in ('make', 'check'):
        sys.exit(__doc__)
    locks = [Path(p) for p in argv[2:]] or [TOP / 'pipeline' / 'inputs' / 'common']
    try:
        if argv[0] == 'make':
            print(json.dumps(make(argv[1], locks), indent=2))
            return 0
        problems = check(argv[1], locks)
    except (OSError, ValueError, zipfile.BadZipFile) as e:
        print('python-site: %s' % e, file=sys.stderr)
        return 1
    for p in problems:
        print('python-site: ' + p, file=sys.stderr)
    return 1 if problems else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
