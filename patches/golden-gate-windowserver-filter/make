#!/usr/bin/env python3
"""Build the shim into a new, recorded artifact: make STORE_ARTIFACTS."""
import datetime
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
TOP = HERE.parents[1]

def run(*args):
    return subprocess.check_output(list(map(str, args)), cwd=TOP, text=True).strip()

def main(root):
    root = Path(root).resolve()
    sources = {str(p.relative_to(TOP)): hashlib.sha256(p.read_bytes()).hexdigest()
               for p in [HERE/'make', HERE/'patch.json', *sorted((HERE/'src').glob('*'))] if p.is_file()}
    with tempfile.TemporaryDirectory(prefix='ws-filter-') as tmp:
        binary = Path(tmp)/'windowserver_filter.dylib'
        run('xcrun', 'clang', '-arch', 'x86_64', '-mmacosx-version-min=26.0', '-O2',
            '-Wall', '-Wextra', '-Werror', '-dynamiclib', '-framework', 'QuartzCore',
            '-Wl,-not_for_dyld_shared_cache', '-install_name', '/usr/lib/windowserver_filter.dylib',
            HERE/'src/filter_shim.c', '-o', binary)
        run('codesign', '-f', '-s', '-', binary)
        digest = hashlib.sha256(binary.read_bytes()).hexdigest()
        now = datetime.datetime.now(datetime.timezone.utc)
        out = root/f'windowserver-filter-26A428-{now:%Y%m%d}-{digest[:12]}'
        out.mkdir()
        (out/binary.name).write_bytes(binary.read_bytes())
        (out/binary.name).chmod(0o755)
        (out/'build.json').write_text(json.dumps({
            'unit': 'patches/golden-gate-windowserver-filter',
            'revision': json.loads((HERE/'patch.json').read_text())['revision'],
            'commit': run('git', 'rev-parse', 'HEAD'),
            'dirty': bool(run('git', 'status', '--porcelain')),
            'date': now.isoformat(), 'inputs': sources,
            'compiler': run('xcrun', 'clang', '--version'),
            'sha256': digest,
        }, indent=2)+'\n')
        print(out)
        return out

if __name__ == '__main__':
    if len(sys.argv) != 2:
        print(__doc__)
        sys.exit(0 if len(sys.argv) == 1 else 2)
    main(sys.argv[1])
