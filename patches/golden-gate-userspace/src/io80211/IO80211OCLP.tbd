--- !tapi-tbd
# Link-time stand-in for OCLP's Modern Wireless wrapper under its new name: io80211_compat.dylib re-exports it, and
# the re-export needs only the install name at link time (its symbols are looked up at run time).
tbd-version:     4
targets:         [ x86_64-macos ]
install-name:    '/System/Library/PrivateFrameworks/IO80211.framework/Versions/A/IO80211OCLP.dylib'
exports:
  - targets:     [ x86_64-macos ]
    symbols:     [ _IO80211OCLPLinkStandIn ]
...
