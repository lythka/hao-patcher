#!/opt/homebrew/bin/python3.14
"""Build the IO80211 compat library (input row io80211_compat) into a new, recorded artifact and check it covers one
27.x build: make STORE_ARTIFACTS --system SYSTEM_ROOT --cache X86_64_DYLD_CACHE --oclp OCLP_IO80211_DIR.
SYSTEM_ROOT is the build's System volume (its SystemVersion.plist names the build and its programs are the on-disk
clients), X86_64_DYLD_CACHE its RosettaOS dyld_shared_cache_x86_64, OCLP_IO80211_DIR the folder holding OCLP's IO80211
and IO80211Old.dylib. Any import nothing answers (coverage.py) stops the build with MISSING/unsupported. coverage.py
also runs the method pass (methods.py); 27.x's x86_64 IO80211 defines no Objective-C classes, so it records 0."""
import argparse
import datetime
import hashlib
import json
from pathlib import Path
import plistlib
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
PATCH = HERE.parents[1]
TOP = PATCH.parents[1]
FRAMEWORK = '/System/Library/PrivateFrameworks/IO80211.framework/Versions/A'
NAME = 'io80211_compat.dylib'


def run(*args):
    return subprocess.check_output(list(map(str, args)), cwd=TOP, text=True).strip()


def build(out):
    """Compile io80211_compat.c into OUT/io80211_compat.dylib (install name IO80211, re-exporting
    IO80211OCLP.dylib), ad-hoc signed. Returns its path."""
    binary = Path(out)/NAME
    run('xcrun', 'clang', '-arch', 'x86_64', '-mmacosx-version-min=26.0', '-O2', '-Wall', '-Wextra', '-Werror',
        '-dynamiclib', '-fvisibility=hidden', '-Wl,-not_for_dyld_shared_cache',
        '-install_name', f'{FRAMEWORK}/IO80211', '-compatibility_version', '1.0.0', '-current_version', '1.0.0',
        f'-Wl,-reexport_library,{HERE/"IO80211OCLP.tbd"}', HERE/'io80211_compat.c', '-o', binary)
    run('codesign', '-f', '-s', '-', binary)
    return binary


def main(root, system, cache, oclp):
    sys.path.insert(0, str(HERE))
    import coverage
    root = Path(root).resolve()
    macos_build = plistlib.loads((Path(system)/'System/Library/CoreServices/SystemVersion.plist').read_bytes())['ProductBuildVersion']
    sources = {str(p.relative_to(TOP)): hashlib.sha256(p.read_bytes()).hexdigest()
               for p in sorted(HERE.iterdir()) if p.is_file()}
    with tempfile.TemporaryDirectory(prefix='io80211-compat-') as tmp:
        binary = build(tmp)
        record = coverage.check(cache, system, oclp, binary)
        if record['errors']:
            sys.exit('\n'.join(record['errors']))
        digest = hashlib.sha256(binary.read_bytes()).hexdigest()
        now = datetime.datetime.now(datetime.timezone.utc)
        out = root/f'io80211-compat-{macos_build}-{now:%Y%m%d}-{digest[:12]}'
        out.mkdir()
        (out/NAME).write_bytes(binary.read_bytes())
        (out/NAME).chmod(0o755)
        (out/'build.json').write_text(json.dumps({
            'unit': 'patches/golden-gate-userspace/src/io80211',
            'revision': json.loads((PATCH/'patch.json').read_text())['revision'],
            'commit': run('git', 'rev-parse', 'HEAD'),
            'dirty': bool(run('git', 'status', '--porcelain', '--', PATCH)),
            'date': now.isoformat(), 'inputs': sources,
            'compiler': run('xcrun', 'clang', '--version'),
            'sha256': digest,
            'coverage': dict(build=macos_build, cache=str(Path(cache).resolve()),
                             oclp={name: hashlib.sha256((Path(oclp)/name).read_bytes()).hexdigest()
                                   for name in ('IO80211', 'IO80211Old.dylib')}, **record),
        }, indent=2)+'\n')
        print(out)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('artifacts', type=Path)
    for option in ('system', 'cache', 'oclp'):
        parser.add_argument('--'+option, type=Path, required=True)
    args = parser.parse_args()
    main(args.artifacts, args.system, args.cache, args.oclp)
