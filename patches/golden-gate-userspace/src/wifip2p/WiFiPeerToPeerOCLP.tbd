--- !tapi-tbd
# Link-time stand-in for OCLP's Modern Wireless WiFiPeerToPeer wrapper under its new name: wifip2p_compat.dylib
# re-exports it, and the re-export needs only the install name at link time (its symbols are looked up at run time).
tbd-version:     4
targets:         [ x86_64-macos ]
install-name:    '/System/Library/PrivateFrameworks/WiFiPeerToPeer.framework/Versions/A/WiFiPeerToPeerOCLP.dylib'
exports:
  - targets:     [ x86_64-macos ]
    symbols:     [ _WiFiPeerToPeerOCLPLinkStandIn ]
...
