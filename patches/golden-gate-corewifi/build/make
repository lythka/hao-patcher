#!/opt/homebrew/bin/python3.14
"""Build the Tahoe CoreWiFi override (rows corewifi_tahoe and corewifi_compat) into a new, recorded artifact and check
it against one 27.x build.

    make STORE_ARTIFACTS --tahoe-cache TAHOE_CACHE_DIR --system SYSTEM_ROOT --cache X86_64_DYLD_CACHE
         --donors DONOR_SYSTEM --oclp OCLP_ROOT --io80211-compat FILE --wifip2p-compat FILE

TAHOE_CACHE_DIR holds Tahoe 25G342's dyld_shared_cache_x86_64h family (row tahoe_os_cache_x86_64h; its main file's
hash pins the subcaches through their UUIDs). SYSTEM_ROOT is the 27.x build's System volume (its SystemVersion.plist
names the build; its programs are the on-disk clients) and X86_64_DYLD_CACHE its RosettaOS dyld_shared_cache_x86_64.
DONOR_SYSTEM is the Tahoe donor artifact's payload/system and OCLP_ROOT the OCLP overlay folder the image installs
(13.7.2-25): programs there that link CoreWiFi replace the build's own and are checked as clients too. The two compat
files are the image's IO80211 and WiFiPeerToPeer libraries (rows io80211_compat, wifip2p_compat).

Steps: cut CoreWiFi out of the Tahoe cache as CoreWiFiTahoe.dylib (tools/cache-dylib), verify it (every GOT slot code
uses is bound, Swift metadata references resolve), check every symbol it binds exists in the 27.x build (the x86_64
cache, or the image's IO80211/WiFiPeerToPeer files), build the compat library (corewifi_compat.m) that re-exports it,
and run the client coverage check (corewifi_coverage.py). Any failure stops the build with MISSING/unsupported and
makes no artifact."""
import argparse
import datetime
import hashlib
import json
from pathlib import Path
import plistlib
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
PATCH = HERE.parent
TOP = PATCH.parents[1]
TOOL = TOP/'tools/cache-dylib'
sys.path.insert(0, str(TOOL))
sys.path.insert(0, str(HERE))
import cache_dylib  # noqa: E402
import check as dylib_check  # noqa: E402
import corewifi_coverage  # noqa: E402

FRAMEWORK = '/System/Library/PrivateFrameworks/CoreWiFi.framework/Versions/A'
IMAGE = f'{FRAMEWORK}/CoreWiFi'
TAHOE_NAME = 'CoreWiFiTahoe.dylib'
COMPAT_NAME = 'CoreWiFi'
PRIVATE = '/System/Library/PrivateFrameworks'
# The image's IO80211 and WiFiPeerToPeer: golden-gate-userspace's compat library at the framework path, re-exporting
# OCLP's wrapper (renamed ...OCLP.dylib), which re-exports OCLP's ...Old.dylib.
STACKS = (('IO80211', 'io80211_compat'), ('WiFiPeerToPeer', 'wifip2p_compat'))


def run(*args, **kw):
    return subprocess.check_output(list(map(str, args)), cwd=TOP, text=True, **kw).strip()


def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def links_corewifi(path):
    try:
        return IMAGE.encode() in Path(path).read_bytes()
    except OSError:
        return False


def macho_files(root):
    for path in sorted(Path(root).rglob('*')):
        if path.is_file() and not path.is_symlink():
            with path.open('rb') as stream:
                if stream.read(4) in (b'\xcf\xfa\xed\xfe', b'\xca\xfe\xba\xbe', b'\xca\xfe\xba\xbf'):
                    yield path


def build_compat(out, tahoe):
    """Compile corewifi_compat.m into OUT/CoreWiFi (install name CoreWiFi, re-exporting TAHOE), ad-hoc signed."""
    binary = Path(out)/COMPAT_NAME
    run('xcrun', 'clang', '-arch', 'x86_64', '-mmacosx-version-min=26.7', '-O2', '-Wall', '-Wextra', '-Werror',
        '-fobjc-arc', '-dynamiclib', '-fvisibility=hidden', '-Wl,-not_for_dyld_shared_cache',
        '-install_name', IMAGE, '-compatibility_version', '1.0.0', '-current_version', '1006.2.0',
        f'-Wl,-reexport_library,{tahoe}', '-framework', 'Foundation', HERE/'corewifi_compat.m', '-o', binary)
    run('codesign', '-f', '-s', '-', binary)
    return binary


def extract(out, tahoe_cache):
    binary = Path(out)/TAHOE_NAME
    record = cache_dylib.extract(tahoe_cache, 'x86_64h', IMAGE, binary, f'{FRAMEWORK}/{TAHOE_NAME}')
    run('codesign', '-f', '-s', '-', binary)
    return binary, record


def main(args):
    root = Path(args.artifacts).resolve()
    system = Path(args.system)
    macos_build = plistlib.loads((system/'System/Library/CoreServices/SystemVersion.plist').read_bytes())[
        'ProductBuildVersion']
    tahoe_build = plistlib.loads((Path(args.tahoe_cache)/'SystemVersion.plist').read_bytes())['ProductBuildVersion']
    sources = {str(p.relative_to(TOP)): sha256(p) for p in sorted(HERE.iterdir()) if p.is_file()}
    sources.update({str(p.relative_to(TOP)): sha256(p) for p in sorted(TOOL.glob('*.py'))})
    sources.update({str(p.relative_to(TOP)): sha256(p) for p in sorted(corewifi_coverage.IO80211.glob('*.py'))})
    # programs the image installs that link CoreWiFi, replacing the build's own
    extra, replaced = {}, []
    for base, tahoe_built, label in ((Path(args.donors), True, f'Tahoe {tahoe_build}'), (Path(args.oclp), False, 'OCLP')):
        for path in macho_files(base):
            if links_corewifi(path):
                relative = str(path.relative_to(base))
                extra[f'{relative} ({label})'] = (path, tahoe_built)
                replaced.append(relative)
    overrides = {}
    for leaf, row in STACKS:
        oclp = Path(args.oclp)/f'System/Library/PrivateFrameworks/{leaf}.framework/Versions/A'
        overrides[f'{PRIVATE}/{leaf}.framework/Versions/A/{leaf}'] = getattr(args, row.replace('-', '_'))
        overrides[f'{PRIVATE}/{leaf}.framework/Versions/A/{leaf}OCLP.dylib'] = oclp/leaf
        overrides[f'{PRIVATE}/{leaf}.framework/Versions/A/{leaf}Old.dylib'] = oclp/f'{leaf}Old.dylib'
    with tempfile.TemporaryDirectory(prefix='corewifi-tahoe-') as tmp:
        tahoe, extraction = extract(tmp, args.tahoe_cache)
        verified = dylib_check.check(tahoe, extraction)
        weak = {d['path'] for d in extraction['dependencies'] if d['weak']}
        missing, weak_missing, where = corewifi_coverage.environment(
            extraction['binds'], Path(args.cache).parent, overrides, weak)
        compat = build_compat(tmp, tahoe)
        record = corewifi_coverage.check(args.cache, system, compat, tahoe, HERE/'corewifi_compat.m', extra,
                                         tuple(replaced))
        errors = verified['errors'] + [f'MISSING/unsupported: CoreWiFiTahoe.dylib binds {m}, which {macos_build} '
                                       'does not export' for m in missing] + record['errors']
        if errors:
            sys.exit('\n'.join(errors))
        digests = {name: sha256(Path(tmp)/name) for name in (TAHOE_NAME, COMPAT_NAME)}
        now = datetime.datetime.now(datetime.timezone.utc)
        tag = hashlib.sha256((digests[TAHOE_NAME] + digests[COMPAT_NAME]).encode()).hexdigest()[:12]
        out = root/f'corewifi-tahoe-{tahoe_build}-{macos_build}-{now:%Y%m%d}-{tag}'
        out.mkdir()
        for name in (TAHOE_NAME, COMPAT_NAME):
            (out/name).write_bytes((Path(tmp)/name).read_bytes())
            (out/name).chmod(0o755)
        (out/'build.json').write_text(json.dumps({
            'unit': 'patches/golden-gate-corewifi/build',
            'revision': json.loads((PATCH/'patch.json').read_text())['revision'],
            'commit': run('git', 'rev-parse', 'HEAD'),
            'dirty': bool(run('git', 'status', '--porcelain', '--', PATCH, TOOL)),
            'date': now.isoformat(), 'sources': sources,
            'compiler': run('xcrun', 'clang', '--version'),
            'sha256': digests,
            'inputs': {
                'tahoe_cache': dict(directory=str(Path(args.tahoe_cache).resolve()), build=tahoe_build,
                                    main_sha256=sha256(Path(args.tahoe_cache)/'dyld_shared_cache_x86_64h')),
                'system': dict(root=str(system.resolve()), build=macos_build),
                'cache': dict(path=str(Path(args.cache).resolve()), sha256=sha256(args.cache)),
                'overrides': {name: dict(path=str(Path(p).resolve()), sha256=sha256(p)) for name, p in overrides.items()},
            },
            'extraction': extraction, 'verification': verified,
            'environment': dict(missing=missing, weak_missing=weak_missing, libraries=where),
            'coverage': record,
        }, indent=2, default=str) + '\n')
        print(out)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('artifacts', type=Path)
    for option in ('tahoe-cache', 'system', 'cache', 'donors', 'oclp', 'io80211-compat', 'wifip2p-compat'):
        parser.add_argument('--' + option, type=Path, required=True)
    main(parser.parse_args())
